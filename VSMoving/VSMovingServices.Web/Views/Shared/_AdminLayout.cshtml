@using System.Security.Claims
@{
    var pageTitle = ViewData["Title"] as string ?? "Dashboard";
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "VS Moving User";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Agent";
    var isAdmin = User.IsInRole("Admin");
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "VS";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@pageTitle — VS Moving Services Admin</title>

<script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />

<style type="text/tailwindcss">
@@theme {
  --color-ink: #131316;
  --color-red: #e01e26;
  --color-reddeep: #9c1319;
  --color-fog: #f4f5f7;
  --color-steel: #5b6270;
  --color-asphalt: #1a1b1e;
  --color-line: #e7e8eb;
  --font-display: "Oswald", sans-serif;
  --font-body: "Inter", sans-serif;
  --font-mono2: "IBM Plex Mono", monospace;
}
</style>

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<style>
  .admin-nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.72);
    transition: all 0.2s ease;
  }
  .admin-nav-item:hover {
    background: rgba(255,255,255,0.06);
    color: #ffffff;
  }
  .admin-nav-item.active {
    background: #e01e26;
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 8px 20px -6px rgba(224,30,38,0.65);
  }
  .admin-card {
    background: #ffffff;
    border: 1px solid #e7e8eb;
    border-radius: 1rem;
    box-shadow: 0 4px 20px -10px rgba(19,19,22,0.06);
  }
</style>
@await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-fog text-ink min-h-screen flex flex-col lg:flex-row overflow-x-hidden">

<!-- Mobile Backdrop -->
<div id="adminDrawerBackdrop" class="fixed inset-0 bg-ink/60 backdrop-blur-xs z-40 hidden lg:hidden" aria-hidden="true"></div>

<!-- ============ LEFT SIDEBAR ============ -->
<aside id="adminSidebar" class="fixed lg:sticky top-0 left-0 z-50 h-screen w-72 bg-ink text-white flex flex-col border-r border-white/10 -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out shrink-0">
  <div class="hazard-thin h-[4px] w-full shrink-0"></div>

  <!-- Brand Header -->
  <div class="px-6 py-5 border-b border-white/10 flex items-center justify-between">
    <a href="/AdminPanel" class="flex items-center gap-3 min-w-0">
      <img src="~/images/logo.png" alt="VS Moving Services" class="h-10 w-auto shrink-0" />
      <div class="leading-tight truncate">
        <div class="font-display text-base tracking-wide text-white">VS MOVING <span class="text-red">SERVICES</span></div>
        <div class="text-[10px] font-mono2 text-white/50 tracking-[0.18em] uppercase">DISPATCH CONSOLE</div>
      </div>
    </a>
    <button id="closeSidebarBtn" type="button" class="lg:hidden w-8 h-8 rounded-lg bg-white/5 text-white/70 hover:text-white flex items-center justify-center" aria-label="Close sidebar">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Navigation Links -->
  <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto" aria-label="Admin Navigation">
    <div class="px-3 pb-2 text-[10px] font-mono2 tracking-[0.2em] text-white/40 uppercase">Core Operations</div>

    <a href="/AdminPanel" class="admin-nav-item @(activeNav == "Dashboard" ? "active" : "")">
      <i class="fa-solid fa-gauge-high w-5 text-center"></i>
      <span>Dashboard</span>
    </a>

    <a href="/Leads" class="admin-nav-item @(activeNav == "Leads" ? "active" : "")">
      <i class="fa-solid fa-inbox w-5 text-center"></i>
      <span>Leads</span>
    </a>

    @if (isAdmin)
    {
      <div class="pt-5 pb-2 px-3 text-[10px] font-mono2 tracking-[0.2em] text-white/40 uppercase">Administration</div>

      <a href="/Admin/Testimonials" class="admin-nav-item @(activeNav == "Testimonials" ? "active" : "")">
        <i class="fa-solid fa-star w-5 text-center"></i>
        <span>Testimonials</span>
      </a>

      <a href="/Admin/Users" class="admin-nav-item @(activeNav == "Users" ? "active" : "")">
        <i class="fa-solid fa-users-gear w-5 text-center"></i>
        <span>Users</span>
      </a>

      <a href="/Admin/SystemSettings" class="admin-nav-item @(activeNav == "SystemSettings" ? "active" : "")">
        <i class="fa-solid fa-sliders w-5 text-center"></i>
        <span>System Settings</span>
      </a>
    }
  </nav>

  <!-- Sidebar User Profile & Logout Footer -->
  <div class="p-4 border-t border-white/10 bg-asphalt/70 space-y-3">
    <div class="flex items-center gap-3 px-2">
      <div class="w-10 h-10 rounded-lg bg-red/20 border border-red/40 text-red font-display text-sm flex items-center justify-center shrink-0">
        @initials
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold text-white truncate">@fullName</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono2 font-semibold uppercase @(isAdmin ? "bg-red text-white" : "bg-white/15 text-white/90")">
            @role
          </span>
        </div>
        <div class="text-xs text-white/55 truncate" title="@email">@email</div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2 pt-1">
      <a href="/" target="_blank" class="px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-white/80 hover:text-white text-xs font-medium inline-flex items-center justify-center gap-1.5 transition-colors">
        <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i> Public Site
      </a>
      <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="w-full px-3 py-2 rounded-lg bg-red/15 hover:bg-red text-red hover:text-white text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors cursor-pointer">
          <i class="fa-solid fa-right-from-bracket text-[11px]"></i> Logout
        </button>
      </form>
    </div>
  </div>
</aside>

<!-- ============ MAIN CONTENT WRAPPER ============ -->
<div class="flex-1 flex flex-col min-w-0">

  <!-- Top Header -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-line h-16 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3 min-w-0">
      <button id="openSidebarBtn" type="button" class="lg:hidden w-10 h-10 rounded-lg border border-line text-ink hover:border-red hover:text-red flex items-center justify-center shrink-0" aria-label="Open navigation menu">
        <i class="fa-solid fa-bars"></i>
      </button>
      <div class="min-w-0">
        <h1 class="font-display text-xl sm:text-2xl tracking-wide text-ink truncate">@pageTitle</h1>
      </div>
    </div>

    <!-- Header Right User Info -->
    <div class="flex items-center gap-3 sm:gap-4 shrink-0">
      <div class="hidden sm:flex items-center gap-3 pr-3 border-r border-line">
        <div class="text-right">
          <div class="text-xs font-semibold text-ink leading-tight">@fullName</div>
          <div class="text-[11px] text-steel leading-tight break-all">@email</div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-mono2 font-semibold uppercase @(isAdmin ? "bg-red/10 text-red border border-red/25" : "bg-ink/10 text-ink border border-ink/20")">
          <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-headset") mr-1.5 text-[10px]"></i>@role
        </span>
      </div>

      <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="px-3.5 py-2 rounded-lg border border-line hover:border-red text-xs font-semibold text-ink hover:text-red inline-flex items-center gap-1.5 transition-colors cursor-pointer" title="Sign out">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="hidden md:inline">Logout</span>
        </button>
      </form>
    </div>
  </header>

  <!-- Toast Notification Container -->
  <div id="adminToast" class="fixed top-20 right-4 sm:right-6 z-50 hidden max-w-sm w-full rounded-xl p-4 shadow-2xl border transition-all duration-200" role="status" aria-live="polite">
    <div class="flex items-start gap-3">
      <i id="adminToastIcon" class="fa-solid fa-circle-check text-lg mt-0.5"></i>
      <div class="flex-1 min-w-0">
        <p id="adminToastText" class="text-sm font-medium break-words"></p>
      </div>
      <button type="button" onclick="hideAdminToast()" class="text-current opacity-60 hover:opacity-100" aria-label="Close notification">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  <!-- Main Content Surface -->
  <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
    @RenderBody()
  </main>

  <!-- Admin Footer -->
  <footer class="px-4 sm:px-6 lg:px-8 py-4 border-t border-line bg-white text-xs text-steel flex flex-col sm:flex-row items-center justify-between gap-2">
    <div>&copy; 2026 VS Moving Services &middot; Halifax, Nova Scotia</div>
    <div class="font-mono2 text-[11px]">Logged in as <strong class="text-ink">@fullName</strong> (@role)</div>
  </footer>
</div>

<script>
  // Mobile drawer toggle
  const sidebar = document.getElementById('adminSidebar');
  const backdrop = document.getElementById('adminDrawerBackdrop');
  const openBtn = document.getElementById('openSidebarBtn');
  const closeBtn = document.getElementById('closeSidebarBtn');

  function openSidebar() {
    if (!sidebar || !backdrop) return;
    sidebar.classList.remove('-translate-x-full');
    backdrop.classList.remove('hidden');
  }
  function closeSidebar() {
    if (!sidebar || !backdrop) return;
    sidebar.classList.add('-translate-x-full');
    backdrop.classList.add('hidden');
  }
  if (openBtn) openBtn.addEventListener('click', openSidebar);
  if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
  if (backdrop) backdrop.addEventListener('click', closeSidebar);

  // Toast helper
  let toastTimer = null;
  function showAdminToast(message, isSuccess = true) {
    const toast = document.getElementById('adminToast');
    const icon = document.getElementById('adminToastIcon');
    const text = document.getElementById('adminToastText');
    if (!toast || !icon || !text) return;

    text.textContent = message;
    if (isSuccess) {
      toast.className = 'fixed top-20 right-4 sm:right-6 z-50 max-w-sm w-full rounded-xl p-4 shadow-2xl border bg-ink text-white border-green-500/40';
      icon.className = 'fa-solid fa-circle-check text-green-400 text-lg mt-0.5';
    } else {
      toast.className = 'fixed top-20 right-4 sm:right-6 z-50 max-w-sm w-full rounded-xl p-4 shadow-2xl border bg-ink text-white border-red/60';
      icon.className = 'fa-solid fa-triangle-exclamation text-red text-lg mt-0.5';
    }
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(hideAdminToast, 5000);
  }
  function hideAdminToast() {
    const toast = document.getElementById('adminToast');
    if (toast) toast.classList.add('hidden');
  }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
