@{
    ViewData["Title"] = "Error";
}

<section class="py-20 md:py-28 max-w-3xl mx-auto px-5 md:px-8 text-center">
  <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">ERROR</span>
  <h1 class="font-display text-4xl md:text-5xl mt-3 tracking-tight">SOMETHING WENT <span class="text-red">WRONG.</span></h1>
  <p class="text-steel mt-4">An unexpected error occurred while processing your request. Please return to the home page or call us directly at 514 999 9790.</p>
  <div class="mt-8">
    <a href="/" class="btn-red px-7 py-4 rounded-md text-sm inline-flex items-center gap-2">
      <i class="fa-solid fa-house"></i> BACK TO HOME
    </a>
  </div>
</section>
