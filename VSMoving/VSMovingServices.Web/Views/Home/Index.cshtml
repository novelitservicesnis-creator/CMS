@model WebsiteSettingsViewModel
<!-- ============ HERO ============ -->
<section id="home" class="relative overflow-hidden bg-fog">
  <div class="absolute inset-0 grid-dots opacity-40 pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-5 md:px-8 py-16 md:py-24 grid lg:grid-cols-2 gap-12 items-center relative">
    <div class="reveal-left">
      <span class="inline-flex items-center gap-2 text-[12px] font-mono2 tracking-[0.2em] text-red bg-red/10 px-3 py-1.5 rounded-full">
        <i class="fa-solid fa-maple-leaf"></i> MOVING &amp; JUNK REMOVAL &middot; HALIFAX &amp; AREA
      </span>
      <h1 class="font-display text-[3rem] sm:text-[3.6rem] md:text-[4.4rem] leading-[0.95] mt-5 tracking-tight">
        HALIFAX MOVERS.<br /><span class="text-red">JUNK REMOVAL.</span>
      </h1>
      <p class="mt-6 text-steel text-lg max-w-md">
        Moving home, relocating your office or clearing out clutter? VS Moving Services helps with packing, furniture handling, local moves and junk removal in Halifax, Dartmouth, Bedford, Sackville and surrounding communities. Tell us what you need for a free quote.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#quote" class="btn-red px-7 py-4 rounded-md text-sm inline-flex items-center gap-2">GET A FREE QUOTE <i class="fa-solid fa-arrow-right"></i></a>
        @if (Model.HasPrimaryPhone)
        {
          <a href="tel:@Model.CleanPrimaryPhoneTel" class="btn-outline-ink px-7 py-4 rounded-md text-sm inline-flex items-center gap-2"><i class="fa-solid fa-phone"></i> @Model.PrimaryPhone</a>
        }
      </div>
      <div class="mt-10 flex flex-wrap gap-6 text-sm">
        <div class="flex items-center gap-2"><i class="fa-solid fa-shield-halved text-red"></i> Insured &amp; Reliable</div>
        <div class="flex items-center gap-2"><i class="fa-solid fa-star text-red"></i> 5-Star Rated</div>
        <div class="flex items-center gap-2"><i class="fa-solid fa-truck-fast text-red"></i> On-Time, Every Time</div>
      </div>
    </div>
    <div class="reveal-right relative">
      <div class="absolute -inset-4 bg-red/10 rounded-3xl rotate-2"></div>
      <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-ink/20 border-4 border-white">
        <div class="overflow-hidden">
          <img src="~/images/hero-truck.png" alt="VS Moving Services moving truck being loaded" class="hero-img w-full h-[420px] object-cover" />
        </div>
      </div>
      <div class="float-slow absolute -bottom-6 -left-6 bg-ink text-white rounded-xl px-5 py-4 shadow-xl w-52">
        <div class="font-display text-3xl text-red">100%</div>
        <div class="text-[12px] text-white/70 font-mono2 tracking-wide">CUSTOMER SATISFACTION</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ WHY CHOOSE US STRIP ============ -->
<section class="bg-ink text-white py-10 border-y-4 border-red">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-6 text-center">
      <div class="chip">
        <div class="w-14 h-14 mx-auto rounded-full bg-white/10 flex items-center justify-center text-red text-xl mb-3"><i class="fa-solid fa-box"></i></div>
        <div class="text-[13px] font-semibold tracking-wide">Careful Handling</div>
      </div>
      <div class="chip">
        <div class="w-14 h-14 mx-auto rounded-full bg-white/10 flex items-center justify-center text-red text-xl mb-3"><i class="fa-solid fa-shield-halved"></i></div>
        <div class="text-[13px] font-semibold tracking-wide">Safe &amp; Secure Transport</div>
      </div>
      <div class="chip">
        <div class="w-14 h-14 mx-auto rounded-full bg-white/10 flex items-center justify-center text-red text-xl mb-3"><i class="fa-solid fa-users"></i></div>
        <div class="text-[13px] font-semibold tracking-wide">Experienced Team</div>
      </div>
      <div class="chip">
        <div class="w-14 h-14 mx-auto rounded-full bg-white/10 flex items-center justify-center text-red text-xl mb-3"><i class="fa-solid fa-clock"></i></div>
        <div class="text-[13px] font-semibold tracking-wide">On-Time Delivery</div>
      </div>
      <div class="chip col-span-2 sm:col-span-1">
        <div class="w-14 h-14 mx-auto rounded-full bg-white/10 flex items-center justify-center text-red text-xl mb-3"><i class="fa-solid fa-map-location-dot"></i></div>
        <div class="text-[13px] font-semibold tracking-wide">Halifax &amp; Area</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section id="services" class="py-20 md:py-28 max-w-7xl mx-auto px-5 md:px-8">
  <div class="reveal max-w-2xl">
    <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">OUR SERVICES</span>
    <h2 class="font-display text-4xl md:text-5xl mt-3 tracking-tight">MOVING SERVICES <span class="text-red">IN HALIFAX.</span></h2>
    <p class="text-steel mt-4">From a single studio apartment to a full commercial relocation, and from one old couch to a whole-property cleanout — a trained crew handles every job, every size, across Halifax and nearby communities.</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-house"></i></div>
      <h3 class="font-display text-xl tracking-wide">RESIDENTIAL MOVING</h3>
      <p class="text-steel text-sm mt-2">Apartments, condos, and family homes — packed and moved with care, top to bottom.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-building"></i></div>
      <h3 class="font-display text-xl tracking-wide">COMMERCIAL MOVING</h3>
      <p class="text-steel text-sm mt-2">Office and warehouse relocations planned around your business hours, not ours.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-box-open"></i></div>
      <h3 class="font-display text-xl tracking-wide">PACKING &amp; UNPACKING</h3>
      <p class="text-steel text-sm mt-2">Proper materials, labeled boxes, and a system so nothing gets lost in transit.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-screwdriver-wrench"></i></div>
      <h3 class="font-display text-xl tracking-wide">FURNITURE DISASSEMBLY &amp; ASSEMBLY</h3>
      <p class="text-steel text-sm mt-2">Beds, shelving, and awkward pieces taken apart and rebuilt at the new address.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-dolly"></i></div>
      <h3 class="font-display text-xl tracking-wide">LOADING &amp; UNLOADING</h3>
      <p class="text-steel text-sm mt-2">Modern equipment and a trained crew make the heavy lifting look easy.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-route"></i></div>
      <h3 class="font-display text-xl tracking-wide">LOCAL MOVING</h3>
      <p class="text-steel text-sm mt-2">Across town or across the Halifax area — one crew, one truck, one point of contact.</p>
    </div>
  </div>

  <div class="reveal max-w-2xl mt-16">
    <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">JUNK REMOVAL</span>
    <h2 class="font-display text-3xl md:text-4xl mt-3 tracking-tight">HALIFAX JUNK REMOVAL <span class="text-red">&amp; CLEANOUTS.</span></h2>
    <p class="text-steel mt-3">Fast, affordable junk removal in Halifax, Dartmouth and surrounding areas. We do the lifting, loading and hauling — you get your space back.</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-trash-can"></i></div>
      <h3 class="font-display text-xl tracking-wide">HOUSEHOLD JUNK REMOVAL</h3>
      <p class="text-steel text-sm mt-2">Old clutter, bags, boxes and general household items cleared out in one visit.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-couch"></i></div>
      <h3 class="font-display text-xl tracking-wide">FURNITURE &amp; APPLIANCE REMOVAL</h3>
      <p class="text-steel text-sm mt-2">Couches, mattresses, tables, fridges, washers and other bulky items taken off your hands.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-hammer"></i></div>
      <h3 class="font-display text-xl tracking-wide">RENOVATION &amp; CONSTRUCTION DEBRIS</h3>
      <p class="text-steel text-sm mt-2">Leftover materials and debris from renovations and small construction jobs.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-tree"></i></div>
      <h3 class="font-display text-xl tracking-wide">YARD WASTE &amp; OUTDOOR CLEANUP</h3>
      <p class="text-steel text-sm mt-2">Branches, brush, old fencing and outdoor clutter hauled away.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-warehouse"></i></div>
      <h3 class="font-display text-xl tracking-wide">GARAGE, BASEMENT &amp; ATTIC CLEANOUTS</h3>
      <p class="text-steel text-sm mt-2">We sort, load and clear the spaces that have been piling up for years.</p>
    </div>
    <div class="reveal svc-card bg-white border border-line rounded-2xl p-7">
      <div class="svc-icon w-14 h-14 rounded-xl bg-red/10 text-red flex items-center justify-center text-2xl mb-5"><i class="fa-solid fa-broom"></i></div>
      <h3 class="font-display text-xl tracking-wide">ESTATE &amp; PROPERTY CLEANOUTS</h3>
      <p class="text-steel text-sm mt-2">Full-property cleanouts for move-outs, estates, landlords and businesses.</p>
    </div>
  </div>
</section>

<!-- ============ THE ROUTE — signature process section ============ -->
<section id="route" class="bg-asphalt text-white py-20 md:py-28 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 md:px-8 relative">
    <div class="reveal max-w-2xl mb-14">
      <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">THE ROUTE</span>
      <h2 class="font-display text-4xl md:text-5xl mt-3 tracking-tight">FROM QUOTE TO <span class="text-red">DOORSTEP.</span></h2>
      <p class="text-white/60 mt-4">Every move follows the same road — five stops, no surprises.</p>
    </div>

    <!-- desktop road -->
    <div class="hidden md:block relative h-[3px] bg-white/10 mb-16 rounded-full">
      <svg class="absolute inset-0 w-full h-[3px]" preserveAspectRatio="none">
        <line x1="0" y1="1.5" x2="100%" y2="1.5" stroke="#e01e26" stroke-width="3" class="route-line" />
      </svg>
      <div id="routeTruck" class="absolute -top-[13px] left-0 text-red text-2xl transition-all duration-300 ease-out">
        <i class="fa-solid fa-truck"></i>
      </div>
    </div>

    <div id="routeStops" class="grid md:grid-cols-5 gap-6 md:gap-4">
      <div class="stop-card reveal bg-white/[0.04] border border-white/10 rounded-xl p-6 relative">
        <div class="stop-dot absolute -top-[31px] left-1/2 -translate-x-1/2 hidden md:block w-3 h-3 rounded-full bg-white/30"></div>
        <div class="font-mono2 text-red text-xs tracking-widest mb-3">KM 0</div>
        <div class="w-10 h-10 rounded-lg bg-red/10 text-red flex items-center justify-center mb-4"><i class="fa-solid fa-clipboard-list"></i></div>
        <h4 class="font-display text-lg tracking-wide">GET YOUR QUOTE</h4>
        <p class="text-white/50 text-sm mt-2">Tell us what's moving and where — a free, no-obligation quote comes back fast.</p>
      </div>
      <div class="stop-card reveal bg-white/[0.04] border border-white/10 rounded-xl p-6 relative">
        <div class="stop-dot absolute -top-[31px] left-1/2 -translate-x-1/2 hidden md:block w-3 h-3 rounded-full bg-white/30"></div>
        <div class="font-mono2 text-red text-xs tracking-widest mb-3">KM 1</div>
        <div class="w-10 h-10 rounded-lg bg-red/10 text-red flex items-center justify-center mb-4"><i class="fa-solid fa-box-open"></i></div>
        <h4 class="font-display text-lg tracking-wide">PACK &amp; PREP</h4>
        <p class="text-white/50 text-sm mt-2">Our crew wraps, boxes, and labels everything, or we work alongside your own packing.</p>
      </div>
      <div class="stop-card reveal bg-white/[0.04] border border-white/10 rounded-xl p-6 relative">
        <div class="stop-dot absolute -top-[31px] left-1/2 -translate-x-1/2 hidden md:block w-3 h-3 rounded-full bg-white/30"></div>
        <div class="font-mono2 text-red text-xs tracking-widest mb-3">KM 2</div>
        <div class="w-10 h-10 rounded-lg bg-red/10 text-red flex items-center justify-center mb-4"><i class="fa-solid fa-dolly"></i></div>
        <h4 class="font-display text-lg tracking-wide">LOAD UP</h4>
        <p class="text-white/50 text-sm mt-2">Furniture disassembled where needed, then loaded and secured by trained movers.</p>
      </div>
      <div class="stop-card reveal bg-white/[0.04] border border-white/10 rounded-xl p-6 relative">
        <div class="stop-dot absolute -top-[31px] left-1/2 -translate-x-1/2 hidden md:block w-3 h-3 rounded-full bg-white/30"></div>
        <div class="font-mono2 text-red text-xs tracking-widest mb-3">KM 3</div>
        <div class="w-10 h-10 rounded-lg bg-red/10 text-red flex items-center justify-center mb-4"><i class="fa-solid fa-truck-fast"></i></div>
        <h4 class="font-display text-lg tracking-wide">ON THE ROAD</h4>
        <p class="text-white/50 text-sm mt-2">Local runs across Halifax and nearby areas — tracked, insured, and on schedule.</p>
      </div>
      <div class="stop-card reveal bg-white/[0.04] border border-white/10 rounded-xl p-6 relative">
        <div class="stop-dot absolute -top-[31px] left-1/2 -translate-x-1/2 hidden md:block w-3 h-3 rounded-full bg-white/30"></div>
        <div class="font-mono2 text-red text-xs tracking-widest mb-3">KM 4</div>
        <div class="w-10 h-10 rounded-lg bg-red/10 text-red flex items-center justify-center mb-4"><i class="fa-solid fa-house-circle-check"></i></div>
        <h4 class="font-display text-lg tracking-wide">DELIVERED</h4>
        <p class="text-white/50 text-sm mt-2">Unloaded, reassembled if needed, and placed where you want it. You relax.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ WHY US DETAIL ============ -->
<section id="why" class="py-20 md:py-28 max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-2 gap-14 items-center">
  <div class="reveal-left relative order-2 lg:order-1">
    <div class="absolute -inset-4 bg-ink/5 rounded-3xl -rotate-2"></div>
    <div class="relative rounded-3xl overflow-hidden shadow-xl border-4 border-white">
      <img src="~/images/hero-truck-2.png" alt="VS Moving Services crew loading a moving truck" class="w-full h-[420px] object-cover" />
    </div>
  </div>
  <div class="reveal-right order-1 lg:order-2">
    <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">WHY CHOOSE US</span>
    <h2 class="font-display text-4xl md:text-5xl mt-3 tracking-tight">WE MOVE YOU <span class="text-red">FORWARD.</span></h2>
    <div class="mt-8 space-y-5">
      <div class="flex items-start gap-4">
        <div class="w-9 h-9 rounded-full bg-red/10 text-red flex items-center justify-center shrink-0"><i class="fa-solid fa-check text-sm"></i></div>
        <div><h4 class="font-semibold">Modern Equipment</h4><p class="text-steel text-sm">Dollies, ramps, moving blankets, and straps built for the job — not improvised.</p></div>
      </div>
      <div class="flex items-start gap-4">
        <div class="w-9 h-9 rounded-full bg-red/10 text-red flex items-center justify-center shrink-0"><i class="fa-solid fa-check text-sm"></i></div>
        <div><h4 class="font-semibold">Affordable Pricing</h4><p class="text-steel text-sm">Transparent quotes with no hidden fees, scaled to the size of your move.</p></div>
      </div>
      <div class="flex items-start gap-4">
        <div class="w-9 h-9 rounded-full bg-red/10 text-red flex items-center justify-center shrink-0"><i class="fa-solid fa-check text-sm"></i></div>
        <div><h4 class="font-semibold">100% Customer Satisfaction</h4><p class="text-steel text-sm">We're not done until your belongings are in place and you're happy.</p></div>
      </div>
      <div class="flex items-start gap-4">
        <div class="w-9 h-9 rounded-full bg-red/10 text-red flex items-center justify-center shrink-0"><i class="fa-solid fa-check text-sm"></i></div>
        <div><h4 class="font-semibold">Insurance Coverage Available</h4><p class="text-steel text-sm">Extra peace of mind for higher-value moves, available on request.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICE AREA ============ -->
<section id="areas" class="bg-fog py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-2 gap-14 items-center">
    <div class="reveal-left">
      <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">SERVICE AREA</span>
      <h2 class="font-display text-4xl md:text-5xl mt-3 tracking-tight">BASED IN HALIFAX.<br /><span class="text-red">SERVING YOUR AREA.</span></h2>
      <p class="text-steel mt-5 max-w-md">We provide moving and junk removal in Halifax, Nova Scotia and the surrounding communities only — so we stay local, fast and easy to reach. Not sure if we cover your address? Just ask.</p>
      <div class="mt-8 grid grid-cols-2 gap-4 max-w-md">
        <div class="loc-item bg-white rounded-xl p-4 border border-line flex items-center gap-3"><i class="fa-solid fa-location-dot text-red"></i> <span class="text-sm font-medium">Halifax, NS &mdash; HQ</span></div>
        <div class="loc-item bg-white rounded-xl p-4 border border-line flex items-center gap-3"><i class="fa-solid fa-location-dot text-red"></i> <span class="text-sm font-medium">Dartmouth &amp; Cole Harbour</span></div>
        <div class="loc-item bg-white rounded-xl p-4 border border-line flex items-center gap-3"><i class="fa-solid fa-location-dot text-red"></i> <span class="text-sm font-medium">Bedford &amp; Sackville</span></div>
        <div class="loc-item bg-white rounded-xl p-4 border border-line flex items-center gap-3"><i class="fa-solid fa-location-dot text-red"></i> <span class="text-sm font-medium">Surrounding Areas</span></div>
      </div>
    </div>
    <div class="reveal-right">
      <div class="bg-ink rounded-3xl p-10 text-white relative overflow-hidden">
        <div class="absolute -right-10 -top-10 text-white/5 text-[220px]"><i class="fa-solid fa-maple-leaf"></i></div>
        <div class="relative">
          <div class="font-display text-2xl tracking-wide mb-6">GET A FREE QUOTE</div>
          <div class="space-y-4 text-sm">
            @if (Model.HasWebsiteEmail)
            {
              <a href="mailto:@Model.WebsiteEmail" class="flex items-center gap-3 hover:text-red transition-colors"><i class="fa-solid fa-envelope w-5 text-red"></i> @Model.WebsiteEmail</a>
            }
            @if (Model.HasPrimaryPhone)
            {
              <a href="tel:@Model.CleanPrimaryPhoneTel" class="flex items-center gap-3 hover:text-red transition-colors"><i class="fa-solid fa-phone w-5 text-red"></i> @Model.PrimaryPhone</a>
            }
            @if (Model.HasSecondaryPhone)
            {
              <a href="tel:@Model.CleanSecondaryPhoneTel" class="flex items-center gap-3 hover:text-red transition-colors"><i class="fa-solid fa-phone w-5 text-red"></i> @Model.SecondaryPhone</a>
            }
            @if (Model.HasBusinessAddress)
            {
              <div class="flex items-center gap-3"><i class="fa-solid fa-location-dot w-5 text-red"></i> @Model.BusinessAddress</div>
            }
          </div>
          <a href="#quote" class="btn-red mt-8 inline-flex px-6 py-3.5 rounded-md text-sm">REQUEST QUOTE NOW</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="moving-questions" class="py-16 max-w-7xl mx-auto px-5 md:px-8">
  <h2 class="font-display text-3xl md:text-4xl tracking-tight">PLANNING A MOVE OR CLEANOUT IN HALIFAX?</h2>
  <div class="grid md:grid-cols-3 gap-8 mt-8">
    <div>
      <h3 class="font-display text-xl">WHAT MOVING HELP CAN I REQUEST?</h3>
      <p class="text-steel mt-3 leading-relaxed">We help with apartment, condo, house and office moves, as well as packing, unpacking, loading and unloading. Include any furniture that needs disassembly or reassembly when you <a href="#quote" class="text-red hover:underline">request your moving quote</a>.</p>
    </div>
    <div>
      <h3 class="font-display text-xl">WHAT CAN YOU REMOVE FROM MY PROPERTY?</h3>
      <p class="text-steel mt-3 leading-relaxed">Our junk removal services cover unwanted furniture, appliances, household clutter, yard waste and renovation debris, along with garage, basement and property cleanouts. Tell us which items need removal so we can confirm the scope before booking.</p>
    </div>
    <div>
      <h3 class="font-display text-xl">WHAT DETAILS HELP YOU PREPARE A QUOTE?</h3>
      <p class="text-steel mt-3 leading-relaxed">Share your pickup and delivery areas, preferred date, item list and any stairs, elevators or parking restrictions. We serve Halifax, Dartmouth, Cole Harbour, Bedford and Sackville; contact us to confirm availability for your address.</p>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section id="reviews" class="py-20 md:py-28 max-w-4xl mx-auto px-5 md:px-8 text-center">
  <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">FROM THE ROAD</span>
  <h2 class="font-display text-4xl md:text-5xl mt-3 tracking-tight">WHAT CUSTOMERS SAY</h2>

  @if (Model.Testimonials == null || Model.Testimonials.Count == 0)
  {
    <div class="relative mt-12 min-h-[210px] flex items-center justify-center">
      <p class="text-steel text-base">Customer reviews will be shared here soon.</p>
    </div>
  }
  else
  {
    var firstQuote = Model.Testimonials[0];
    var firstRating = Math.Clamp(firstQuote.Rating, 1, 5);
    var hasFirstLoc = !string.IsNullOrWhiteSpace(firstQuote.Location);
    var serializedQuotes = System.Text.Json.JsonSerializer.Serialize(
        Model.Testimonials.Select(t => new
        {
            name = t.CustomerName,
            loc = t.Location ?? string.Empty,
            text = t.ReviewText,
            rating = Math.Clamp(t.Rating, 1, 5)
        }));

    <div class="relative mt-12 min-h-[210px]">
      <div id="quoteCard" class="quote-card">
        <div id="qStars" class="text-red text-lg mb-4">@for (int s = 1; s <= 5; s++) { if (s <= firstRating) { <i class="fa-solid fa-star"></i> } else { <i class="fa-regular fa-star opacity-30"></i> } }</div>
        <p id="qText" class="text-xl md:text-2xl font-display tracking-wide leading-snug">&ldquo;@firstQuote.ReviewText&rdquo;</p>
        <div class="mt-6 text-sm text-steel"><span id="qName" class="font-semibold text-ink">@firstQuote.CustomerName</span><span id="qLocSep" class="@(hasFirstLoc ? "" : "hidden")"> &middot; </span><span id="qLoc" class="@(hasFirstLoc ? "" : "hidden")">@firstQuote.Location</span></div>
      </div>
    </div>
    @if (Model.Testimonials.Count > 1)
    {
      <div id="qNavWrap" class="flex items-center justify-center gap-3 mt-8">
        <button id="qPrev" type="button" aria-label="Previous testimonial" class="w-10 h-10 rounded-full border border-line hover:border-red hover:text-red transition-colors"><i class="fa-solid fa-chevron-left"></i></button>
        <button id="qNext" type="button" aria-label="Next testimonial" class="w-10 h-10 rounded-full border border-line hover:border-red hover:text-red transition-colors"><i class="fa-solid fa-chevron-right"></i></button>
      </div>
    }
    <script id="testimonialsData" type="application/json">@Html.Raw(serializedQuotes.Replace("</", "<\\/"))</script>
  }
</section>

<!-- ============ LEAD / CONTACT FORM ============ -->
<section id="quote" class="hazard py-14 md:py-20">
  <div class="max-w-6xl mx-auto px-5">
    <div class="bg-ink/95 rounded-2xl p-6 md:p-12 grid lg:grid-cols-5 gap-10">

      <!-- left: pitch + contact details -->
      <div class="lg:col-span-2 text-white">
        <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">FREE QUOTE</span>
        <h2 class="font-display text-3xl md:text-5xl tracking-tight mt-3">LET US TAKE THE <span class="text-red">STRESS.</span></h2>
        <p class="text-white/60 mt-4 text-sm">Tell us what you need and we'll get back to you with a free, no-obligation quote for moving or junk removal in Halifax and surrounding areas.</p>
        <div class="mt-8 space-y-4 text-sm">
          @if (Model.HasPrimaryPhone)
          {
            <a href="tel:@Model.CleanPrimaryPhoneTel" class="flex items-center gap-3 hover:text-red transition-colors"><i class="fa-solid fa-phone w-5 text-red"></i> @Model.PrimaryPhone</a>
          }
          @if (Model.HasSecondaryPhone)
          {
            <a href="tel:@Model.CleanSecondaryPhoneTel" class="flex items-center gap-3 hover:text-red transition-colors"><i class="fa-solid fa-phone w-5 text-red"></i> @Model.SecondaryPhone</a>
          }
          @if (Model.HasWebsiteEmail)
          {
            <a href="mailto:@Model.WebsiteEmail" class="flex items-center gap-3 hover:text-red transition-colors break-all"><i class="fa-solid fa-envelope w-5 text-red"></i> @Model.WebsiteEmail</a>
          }
          @if (Model.HasBusinessAddress)
          {
            <div class="flex items-center gap-3"><i class="fa-solid fa-location-dot w-5 text-red"></i> @Model.BusinessAddress</div>
          }
        </div>
      </div>

      <!-- right: form -->
      <form id="leadForm" class="lg:col-span-3 bg-white rounded-xl p-6 md:p-8 grid sm:grid-cols-2 gap-4" novalidate>
        <div>
          <label for="lf_name" class="block text-xs font-semibold mb-1.5">Full Name *</label>
          <input id="lf_name" name="fullName" type="text" required maxlength="100" autocomplete="name" class="lf-input" placeholder="John Smith" />
        </div>
        <div>
          <label for="lf_phone" class="block text-xs font-semibold mb-1.5">Phone *</label>
          <input id="lf_phone" name="phone" type="tel" required maxlength="25" autocomplete="tel" class="lf-input" placeholder="514 000 0000" />
        </div>
        <div class="sm:col-span-2">
          <label for="lf_email" class="block text-xs font-semibold mb-1.5">Email *</label>
          <input id="lf_email" name="email" type="email" required maxlength="150" autocomplete="email" class="lf-input" placeholder="you@example.com" />
        </div>
        <div class="sm:col-span-2">
          <label for="lf_msg" class="block text-xs font-semibold mb-1.5">Message</label>
          <textarea id="lf_msg" name="message" rows="3" maxlength="1000" class="lf-input" placeholder="How can we help you?"></textarea>
        </div>

        <!-- honeypot: hidden from humans, bots fill it -->
        <div class="hidden" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="sm:col-span-2">
          <button id="lf_btn" type="submit" class="btn-red w-full px-8 py-4 rounded-md text-sm inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane"></i> <span>REQUEST FREE QUOTE</span>
          </button>
          <p id="lf_msgbox" class="mt-3 text-sm hidden" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
