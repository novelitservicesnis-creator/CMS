@{
    ViewData["Title"] = "About Us";
}

<!-- ============ PAGE HERO ============ -->
<section class="relative overflow-hidden bg-fog border-b border-line">
  <div class="absolute inset-0 grid-dots opacity-40 pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-5 md:px-8 py-14 md:py-20 relative">
    <span class="inline-flex items-center gap-2 text-[12px] font-mono2 tracking-[0.2em] text-red bg-red/10 px-3 py-1.5 rounded-full">
      <i class="fa-solid fa-maple-leaf"></i> ABOUT VS MOVING SERVICES &middot; HALIFAX, NS
    </span>
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl leading-[0.95] mt-5 tracking-tight">
      YOUR HALIFAX <span class="text-red">MOVING TEAM.</span>
    </h1>
    <p class="mt-4 text-steel text-lg max-w-2xl">
      Locally based in Halifax, Nova Scotia, we provide stress-free residential and commercial moving along with fast, dependable junk removal across Halifax and surrounding communities.
    </p>
  </div>
</section>

<!-- ============ STORY & MISSION ============ -->
<section class="py-16 md:py-24 max-w-7xl mx-auto px-5 md:px-8 grid lg:grid-cols-2 gap-14 items-center">
  <div class="reveal-left">
    <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">OUR STORY</span>
    <h2 class="font-display text-3xl md:text-5xl mt-3 tracking-tight">BUILT ON HARD WORK &amp; <span class="text-red">CAREFUL HANDLING.</span></h2>
    <p class="text-steel mt-5 leading-relaxed">
      VS Moving Services was started with a simple goal: take the heavy lifting and stress out of moving day. Whether you're relocating a studio apartment, moving a growing family home, transitioning an office, or clearing out years of clutter from a garage or estate, our crew shows up on time with the right equipment and a respectful, can-do attitude.
    </p>
    <p class="text-steel mt-4 leading-relaxed">
      We wrap furniture carefully, disassemble and reassemble beds and shelving where needed, and treat your floors, doorways, and belongings as if they were our own.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/#quote" class="btn-red px-7 py-4 rounded-md text-sm inline-flex items-center gap-2">GET A FREE QUOTE <i class="fa-solid fa-arrow-right"></i></a>
      <a href="/#services" class="btn-outline-ink px-7 py-4 rounded-md text-sm inline-flex items-center gap-2">VIEW OUR SERVICES</a>
    </div>
  </div>
  <div class="reveal-right relative">
    <div class="absolute -inset-4 bg-red/10 rounded-3xl rotate-2"></div>
    <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-ink/20 border-4 border-white">
      <img src="~/images/hero-truck.png" alt="VS Moving Services truck and crew" class="w-full h-[400px] object-cover" />
    </div>
  </div>
</section>

<!-- ============ VALUES ============ -->
<section class="bg-asphalt text-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <div class="max-w-2xl mb-12">
      <span class="text-red font-mono2 text-[12px] tracking-[0.25em]">OUR COMMITMENT</span>
      <h2 class="font-display text-3xl md:text-5xl mt-3 tracking-tight">WHAT YOU CAN EXPECT <span class="text-red">EVERY MOVE.</span></h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white/[0.04] border border-white/10 rounded-xl p-6">
        <div class="w-11 h-11 rounded-lg bg-red/10 text-red flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-shield-halved"></i></div>
        <h3 class="font-display text-xl tracking-wide">PROTECTED BELONGINGS</h3>
        <p class="text-white/60 text-sm mt-2">Moving blankets, straps, dollies, and careful loading keep your furniture safe in transit.</p>
      </div>
      <div class="bg-white/[0.04] border border-white/10 rounded-xl p-6">
        <div class="w-11 h-11 rounded-lg bg-red/10 text-red flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-clock"></i></div>
        <h3 class="font-display text-xl tracking-wide">PUNCTUAL CREWS</h3>
        <p class="text-white/60 text-sm mt-2">We respect your schedule and communicate clearly from quote to final delivery.</p>
      </div>
      <div class="bg-white/[0.04] border border-white/10 rounded-xl p-6">
        <div class="w-11 h-11 rounded-lg bg-red/10 text-red flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        <h3 class="font-display text-xl tracking-wide">HONEST PRICING</h3>
        <p class="text-white/60 text-sm mt-2">Clear, upfront quotes scaled to your move or junk removal job with no surprise charges.</p>
      </div>
      <div class="bg-white/[0.04] border border-white/10 rounded-xl p-6">
        <div class="w-11 h-11 rounded-lg bg-red/10 text-red flex items-center justify-center text-lg mb-4"><i class="fa-solid fa-map-location-dot"></i></div>
        <h3 class="font-display text-xl tracking-wide">LOCAL HALIFAX TEAM</h3>
        <p class="text-white/60 text-sm mt-2">Proudly serving Halifax, Dartmouth, Cole Harbour, Bedford, Sackville, and surrounding areas.</p>
      </div>
    </div>
  </div>
</section>
