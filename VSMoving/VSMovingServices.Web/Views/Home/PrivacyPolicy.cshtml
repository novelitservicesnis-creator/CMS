@model WebsiteSettingsViewModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- ============ PAGE HERO ============ -->
<section class="relative overflow-hidden bg-fog border-b border-line">
    <div class="absolute inset-0 grid-dots opacity-40 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-5 md:px-8 py-14 md:py-20 relative">
        <span class="inline-flex items-center gap-2 text-[12px] font-mono2 tracking-[0.2em] text-red bg-red/10 px-3 py-1.5 rounded-full">
            <i class="fa-solid fa-shield-halved"></i> PRIVACY &amp; DATA PROTECTION
        </span>
        <h1 class="font-display text-4xl sm:text-5xl leading-[0.95] mt-5 tracking-tight">
            PRIVACY <span class="text-red">POLICY.</span>
        </h1>
        <p class="mt-4 text-steel text-base">
            How VS Moving and Junk Service collects, uses, shares, and protects your information when you visit our website, request a quote, or use our services.
        </p>
        <p class="mt-3 text-steel text-sm font-mono2 tracking-wide">
            EFFECTIVE DATE: OCTOBER 11, 2026
        </p>
    </div>
</section>

<!-- ============ CONTENT ============ -->
<section class="py-16 md:py-20 max-w-4xl mx-auto px-5 md:px-8 space-y-8">
    <div class="bg-white border border-line rounded-2xl p-7 md:p-9 space-y-8">

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">1. INTRODUCTION</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                VS Moving and Junk Service (&ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;) respects your privacy and is committed to handling your personal information responsibly. This Privacy Policy explains how we collect, use, disclose, and protect information when you visit our website, contact us, request a quote, or use our moving and junk removal services.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                By using our website or providing information to us, you acknowledge this Privacy Policy. Where applicable law requires consent for a particular activity, we will obtain that consent.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">2. INFORMATION WE COLLECT</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                Depending on how you interact with us, we may collect the following information:
            </p>
            <ul class="list-disc pl-5 mt-3 space-y-2 text-steel text-sm leading-relaxed">
                <li><strong class="text-ink">Contact information:</strong> Your name, email address, telephone number, and other contact details you provide.</li>
                <li><strong class="text-ink">Service information:</strong> Pickup addresses, delivery addresses, property access instructions, requested service dates, and details about the services you need.</li>
                <li><strong class="text-ink">Moving and removal details:</strong> Descriptions, inventories, and photographs of furniture, household belongings, or items you ask us to move, deliver, pack, or remove.</li>
                <li><strong class="text-ink">Communications:</strong> Information contained in emails, calls, messages, quote requests, and customer service inquiries.</li>
                <li><strong class="text-ink">Website usage information:</strong> Technical information such as your IP address, browser type, device information, pages visited, and interactions with our website, where collected through website hosting tools, cookies, or analytics services.</li>
            </ul>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                We aim to collect only information reasonably necessary for our business purposes.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">3. HOW WE USE YOUR INFORMATION</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                We may use your information to:
            </p>
            <ul class="list-disc pl-5 mt-3 space-y-2 text-steel text-sm leading-relaxed">
                <li>Respond to inquiries and prepare estimates or quotes.</li>
                <li>Schedule, coordinate, and provide moving, junk removal, packing, unpacking, and furniture delivery services.</li>
                <li>Confirm pickup and delivery locations and communicate with you about your booking.</li>
                <li>Process payments, deposits, refunds, and invoices where applicable.</li>
                <li>Maintain business, transaction, and service records.</li>
                <li>Respond to complaints, damage reports, and service-related disputes.</li>
                <li>Maintain, secure, and improve our website and services.</li>
                <li>Prevent fraud, protect our business, and comply with applicable legal requirements.</li>
                <li>Send promotional communications only where permitted by applicable law and, where required, with your consent.</li>
            </ul>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">4. COOKIES AND WEBSITE ANALYTICS</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                Our website may use cookies or similar technologies to remember preferences, support website functionality, and understand how visitors use the website.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                We may use third-party analytics tools, such as Google Analytics, if configured on our website. These tools may collect information about website visits, traffic sources, devices, and browsing activity.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                The information collected and the available cookie controls depend on the tools installed on our website. You can manage cookies through your browser settings and any cookie preferences provided on our website.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                We will seek consent where required by applicable law before using technologies that require it.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">5. HOW WE SHARE INFORMATION</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                We do not sell personal information to third parties for money.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                We may share relevant information when reasonably necessary with:
            </p>
            <ul class="list-disc pl-5 mt-3 space-y-2 text-steel text-sm leading-relaxed">
                <li><strong class="text-ink">Service providers:</strong> Website hosting companies, website maintenance providers, email providers, analytics providers, and other vendors supporting our operations.</li>
                <li><strong class="text-ink">Payment providers:</strong> Payment processors or financial institutions involved in processing transactions.</li>
                <li><strong class="text-ink">Service partners:</strong> Workers, contractors, or subcontractors who need relevant information to complete a booking or provide an agreed service.</li>
                <li><strong class="text-ink">Professional advisers:</strong> Legal, accounting, insurance, or other professional advisers where appropriate.</li>
                <li><strong class="text-ink">Authorities and other parties:</strong> Where disclosure is required or permitted by law, necessary to respond to legal proceedings, or reasonably necessary to protect rights, safety, or property.</li>
            </ul>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                We aim to share only the information reasonably necessary for the relevant purpose. Third-party providers may process information under their own privacy policies and contractual obligations.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">6. STORAGE AND SECURITY</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                We take reasonable administrative, technical, and physical measures appropriate to the information we handle to protect it against unauthorized access, use, loss, alteration, or disclosure.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                However, no website, email system, or electronic transmission method can be guaranteed to be completely secure.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                We retain personal information only for as long as reasonably necessary for the purposes described in this Policy, including service delivery, accounting, recordkeeping, dispute resolution, and legal obligations. When information is no longer required, we will take reasonable steps to securely delete it or anonymize it, where appropriate.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">7. PROCESSING OUTSIDE CANADA</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                Some of our website, analytics, email, cloud storage, or payment service providers may store or process information outside Canada. If this occurs, information may be subject to the laws of the jurisdiction where it is processed.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                The actual locations in which your information is stored or accessed depend on the service providers we use.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">8. YOUR PRIVACY CHOICES AND RIGHTS</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                Depending on applicable law, you may have the right to request access to personal information we hold about you, request corrections to inaccurate information, withdraw consent where processing relies on consent, or ask questions about how your information is handled.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                To make a privacy-related request, contact us using the email address below. We may need to verify your identity before responding. Certain information may need to be retained where required by law or reasonably necessary for legitimate business purposes.
            </p>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                You may also unsubscribe from promotional emails using the unsubscribe instructions provided in those messages, where applicable.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">9. THIRD-PARTY WEBSITES</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                Our website may contain links to external websites or services. We are not responsible for the privacy practices, security, or content of websites operated by third parties. We encourage you to review their privacy policies before providing information to them.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">10. CHILDREN&rsquo;S PRIVACY</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                Our services and website are intended for people arranging moving, delivery, or junk removal services, not for children to use independently. We do not knowingly seek to collect personal information from children where doing so would be contrary to applicable law.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">11. CHANGES TO THIS PRIVACY POLICY</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                We may update this Privacy Policy when our business practices, website features, service providers, or legal requirements change. The updated version will be posted on our website with a revised effective date.
            </p>
        </div>

        <div>
            <h2 class="font-display text-2xl tracking-wide text-ink">12. CONTACT US</h2>
            <p class="text-steel text-sm mt-2 leading-relaxed">
                For questions, requests, or concerns regarding this Privacy Policy or our handling of personal information, contact:
            </p>
            <div class="text-steel text-sm mt-3 leading-relaxed space-y-1">
                <p class="text-ink font-medium">VS Moving and Junk Service</p>
                <p>
                    Email:
                    <a href="mailto:vsshippingservicespvt@gmail.com?subject=Privacy%20Request" class="text-red font-medium hover:underline">vsshippingservicespvt@gmail.com</a>
                </p>
                <p>
                    Website:
                    <a href="https://www.vsmoving.com" class="text-red font-medium hover:underline">https://www.vsmoving.com</a>
                </p>
                <p>Location: Halifax, Nova Scotia, Canada</p>
            </div>
            <p class="text-steel text-sm mt-3 leading-relaxed">
                Please include &ldquo;Privacy Request&rdquo; in the subject line of your email where appropriate.
            </p>
        </div>

    </div>

    <div>
        <a href="/" class="btn-outline-ink px-6 py-3 rounded-md text-sm inline-flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Back to Home
        </a>
    </div>
</section>
