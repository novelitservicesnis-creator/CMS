@model Lead
@using System.Globalization
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Lead #{Model.LeadId}";
    ViewData["ActiveNav"] = "Leads";

    var hasPhone = !string.IsNullOrWhiteSpace(Model.PhoneNumber);
    var hasEmail = !string.IsNullOrWhiteSpace(Model.Email);
    var hasMessage = !string.IsNullOrWhiteSpace(Model.Message);
    var telHref = hasPhone ? new string(Model.PhoneNumber!.Where(c => char.IsDigit(c) || c == '+').ToArray()) : "";
}

<!-- Top Bar -->
<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <a href="/Leads" class="btn-outline-ink px-4 py-2 rounded-lg text-xs inline-flex items-center gap-2">
    <i class="fa-solid fa-arrow-left"></i>
    <span>Back to Leads</span>
  </a>

  <div class="flex items-center gap-2">
    <span class="font-mono2 text-xs text-steel">Reference <strong class="text-ink">#@Model.LeadId</strong></span>
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono2 font-medium bg-emerald-500/10 text-emerald-700 border border-emerald-500/25">
      <i class="fa-solid fa-check text-[10px]"></i> Read
    </span>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Left 2 Columns: Customer Details & Enquiry Message -->
  <div class="lg:col-span-2 space-y-6">

    <!-- Customer Details Card -->
    <div class="admin-card p-6 sm:p-7">
      <div class="flex items-center gap-2.5 pb-4 border-b border-line">
        <div class="w-9 h-9 rounded-lg bg-red/10 text-red flex items-center justify-center text-sm">
          <i class="fa-solid fa-user"></i>
        </div>
        <div>
          <span class="text-[10px] font-mono2 uppercase tracking-[0.2em] text-red block">Primary Contact</span>
          <h2 class="font-display text-xl tracking-wide text-ink">CUSTOMER DETAILS</h2>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="p-4 rounded-xl bg-fog/70 border border-line">
          <div class="text-[11px] font-mono2 uppercase tracking-wider text-steel">Full Name</div>
          <div class="text-base font-bold text-ink mt-1 break-words">@Model.FullName</div>
        </div>

        @if (hasPhone)
        {
          <div class="p-4 rounded-xl bg-fog/70 border border-line">
            <div class="text-[11px] font-mono2 uppercase tracking-wider text-steel">Phone</div>
            <div class="text-base font-semibold text-ink mt-1 break-words">
              <a href="tel:@telHref" class="hover:text-red transition-colors inline-flex items-center gap-2">
                <i class="fa-solid fa-phone text-red text-xs"></i>
                <span>@Model.PhoneNumber</span>
              </a>
            </div>
          </div>
        }

        @if (hasEmail)
        {
          <div class="p-4 rounded-xl bg-fog/70 border border-line sm:col-span-2">
            <div class="text-[11px] font-mono2 uppercase tracking-wider text-steel">Email</div>
            <div class="text-sm sm:text-base font-semibold text-ink mt-1 break-all">
              <a href="mailto:@Model.Email" class="hover:text-red transition-colors inline-flex items-center gap-2">
                <i class="fa-solid fa-envelope text-red text-xs"></i>
                <span>@Model.Email</span>
              </a>
            </div>
          </div>
        }
      </div>
    </div>

    <!-- Enquiry Message Card (Completely hidden when Message is null/empty/whitespace per Empty Field Rule) -->
    @if (hasMessage)
    {
      <div class="admin-card p-6 sm:p-7">
        <div class="flex items-center gap-2.5 pb-4 border-b border-line">
          <div class="w-9 h-9 rounded-lg bg-red/10 text-red flex items-center justify-center text-sm">
            <i class="fa-solid fa-message"></i>
          </div>
          <div>
            <span class="text-[10px] font-mono2 uppercase tracking-[0.2em] text-red block">Submitted Notes</span>
            <h2 class="font-display text-xl tracking-wide text-ink">ENQUIRY MESSAGE</h2>
          </div>
        </div>

        <div class="mt-5 p-5 rounded-xl bg-fog/80 border-l-4 border-l-red text-sm text-ink leading-relaxed whitespace-pre-line break-words">@Model.Message!.Trim()</div>
      </div>
    }
  </div>

  <!-- Right Column: Enquiry Information & Actions -->
  <div class="space-y-6">

    <!-- Enquiry Information -->
    <div class="admin-card p-6 sm:p-7">
      <div class="flex items-center gap-2.5 pb-4 border-b border-line">
        <div class="w-9 h-9 rounded-lg bg-ink text-white flex items-center justify-center text-sm">
          <i class="fa-solid fa-circle-info"></i>
        </div>
        <div>
          <span class="text-[10px] font-mono2 uppercase tracking-[0.2em] text-steel block">Metadata</span>
          <h2 class="font-display text-xl tracking-wide text-ink">ENQUIRY INFORMATION</h2>
        </div>
      </div>

      <dl class="mt-4 divide-y divide-line text-sm">
        <div class="py-3 flex items-center justify-between gap-2">
          <dt class="text-xs text-steel">Reference</dt>
          <dd class="font-mono2 text-xs font-bold text-red">#@Model.LeadId</dd>
        </div>
        <div class="py-3 flex items-center justify-between gap-2">
          <dt class="text-xs text-steel">Source</dt>
          <dd class="text-xs font-semibold text-ink text-right">@Model.Source</dd>
        </div>
        <div class="py-3 flex items-center justify-between gap-2">
          <dt class="text-xs text-steel">Submitted Date</dt>
          <dd class="text-xs font-semibold text-ink">@Model.CreatedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</dd>
        </div>
        <div class="py-3 flex items-center justify-between gap-2">
          <dt class="text-xs text-steel">Submitted Time</dt>
          <dd class="text-xs font-semibold text-ink">@Model.CreatedAt.ToString("hh:mm tt", CultureInfo.InvariantCulture)</dd>
        </div>
      </dl>
    </div>

    <!-- Actions -->
    <div class="admin-card p-6 sm:p-7">
      <div class="text-[10px] font-mono2 uppercase tracking-[0.2em] text-red">Quick Response</div>
      <h2 class="font-display text-xl tracking-wide text-ink mt-0.5">ACTIONS</h2>

      <div class="mt-4 space-y-3">
        @if (hasPhone)
        {
          <a href="tel:@telHref" class="btn-red w-full py-3 px-4 rounded-lg text-xs inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-phone"></i>
            <span>CALL CUSTOMER (@Model.PhoneNumber)</span>
          </a>
        }

        @if (hasEmail)
        {
          <a href="mailto:@Model.Email?subject=@Uri.EscapeDataString($"Regarding Your VS Moving Services Quote (#{Model.LeadId})")"
             class="w-full py-3 px-4 rounded-lg bg-ink hover:bg-asphalt text-white font-semibold text-xs inline-flex items-center justify-center gap-2 transition-colors">
            <i class="fa-solid fa-reply"></i>
            <span>REPLY BY EMAIL</span>
          </a>
        }

        <a href="/Leads" class="btn-outline-ink w-full py-2.5 px-4 rounded-lg text-xs inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Back to Leads</span>
        </a>
      </div>
    </div>

  </div>
</div>
