@model LeadsListViewModel
@using System.Globalization
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Leads";
    ViewData["ActiveNav"] = "Leads";
    var currentStatus = (Model.StatusFilter ?? "").ToLowerInvariant();
}

<!-- ============ TOP FILTER & SEARCH BAR ============ -->
<div class="admin-card p-4 sm:p-5">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">

    <!-- Status Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2">
      <a href="@Url.Action("Leads", "Admin", new { search = Model.Search, status = (string?)null })"
         class="px-3.5 py-2 rounded-lg text-xs font-semibold transition-colors @(string.IsNullOrEmpty(currentStatus) ? "bg-ink text-white" : "bg-fog text-steel hover:text-ink")">
        All <span class="ml-1 font-mono2 opacity-75">(@Model.AllCount)</span>
      </a>
      <a href="@Url.Action("Leads", "Admin", new { search = Model.Search, status = "new" })"
         class="px-3.5 py-2 rounded-lg text-xs font-semibold transition-colors @(currentStatus == "new" ? "bg-red text-white" : "bg-fog text-steel hover:text-ink")">
        New <span class="ml-1 font-mono2 opacity-75">(@Model.NewCount)</span>
      </a>
      <a href="@Url.Action("Leads", "Admin", new { search = Model.Search, status = "read" })"
         class="px-3.5 py-2 rounded-lg text-xs font-semibold transition-colors @(currentStatus == "read" ? "bg-ink text-white" : "bg-fog text-steel hover:text-ink")">
        Read <span class="ml-1 font-mono2 opacity-75">(@Model.ReadCount)</span>
      </a>
    </div>

    <!-- Search Bar -->
    <form method="get" action="/Leads" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 flex-1 max-w-xl">
      @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
      {
        <input type="hidden" name="status" value="@Model.StatusFilter" />
      }
      <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-steel pointer-events-none">
          <i class="fa-solid fa-magnifying-glass text-xs"></i>
        </span>
        <input type="search" name="search" value="@Model.Search" placeholder="Search by name, phone, email, or #ref..." class="lf-input pl-9! py-2! text-xs!" />
      </div>
      <div class="flex items-center gap-2">
        <button type="submit" class="btn-red px-4 py-2.5 rounded-lg text-xs inline-flex items-center justify-center gap-1.5 cursor-pointer flex-1 sm:flex-initial">
          <i class="fa-solid fa-magnifying-glass"></i>
          <span>Search</span>
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
        {
          <a href="/Leads" class="px-3.5 py-2.5 rounded-lg border border-line hover:border-red text-xs font-medium text-steel hover:text-red inline-flex items-center justify-center">
            Reset
          </a>
        }
      </div>
    </form>
  </div>
</div>

<!-- ============ LEADS TABLE / CARDS ============ -->
<div class="admin-card mt-5 overflow-hidden">
  @if (Model.Leads.Count == 0)
  {
    <div class="p-12 text-center">
      <div class="w-14 h-14 mx-auto rounded-2xl bg-fog text-steel flex items-center justify-center text-2xl mb-3">
        <i class="fa-solid fa-inbox"></i>
      </div>
      <h3 class="font-display text-xl tracking-wide text-ink">NO LEADS FOUND</h3>
      <p class="text-xs text-steel mt-1 max-w-md mx-auto">
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
        {
          <span>No enquiries matched your current search or status filter.</span>
        }
        else
        {
          <span>Website quote requests will appear here as soon as customers submit the Free Quote form.</span>
        }
      </p>
    </div>
  }
  else
  {
    <!-- Desktop Table -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-fog/70 border-b border-line text-[11px] font-mono2 uppercase tracking-wider text-steel">
            <th class="py-3.5 px-5">Reference</th>
            <th class="py-3.5 px-5">Customer Name</th>
            <th class="py-3.5 px-5">Phone</th>
            <th class="py-3.5 px-5">Email</th>
            <th class="py-3.5 px-5">Source</th>
            <th class="py-3.5 px-5">Status</th>
            <th class="py-3.5 px-5">Submitted Date</th>
            <th class="py-3.5 px-5 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line text-sm">
          @foreach (var lead in Model.Leads)
          {
            <tr class="hover:bg-fog/50 transition-colors @(!lead.IsRead ? "bg-red/[0.02]" : "")">
              <td class="py-3.5 px-5 font-mono2 text-xs font-semibold text-ink">#@lead.LeadId</td>
              <td class="py-3.5 px-5 font-semibold text-ink">@lead.FullName</td>
              <td class="py-3.5 px-5 text-xs text-ink whitespace-nowrap">
                @(!string.IsNullOrWhiteSpace(lead.PhoneNumber) ? lead.PhoneNumber : "—")
              </td>
              <td class="py-3.5 px-5 text-xs text-steel break-all">
                @(!string.IsNullOrWhiteSpace(lead.Email) ? lead.Email : "—")
              </td>
              <td class="py-3.5 px-5 text-xs text-steel">@lead.Source</td>
              <td class="py-3.5 px-5">
                @if (!lead.IsRead)
                {
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono2 font-semibold bg-red/10 text-red border border-red/25">
                    <span class="w-1.5 h-1.5 rounded-full bg-red"></span> New
                  </span>
                }
                else
                {
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono2 font-medium bg-fog text-steel border border-line">
                    Read
                  </span>
                }
              </td>
              <td class="py-3.5 px-5 text-xs text-steel whitespace-nowrap">
                <div>@lead.CreatedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</div>
                <div class="text-[11px]">@lead.CreatedAt.ToString("hh:mm tt", CultureInfo.InvariantCulture)</div>
              </td>
              <td class="py-3.5 px-5 text-right">
                <a href="/LeadDetails/@lead.LeadId" class="px-3.5 py-1.5 rounded-lg bg-ink hover:bg-red text-white text-xs font-semibold inline-flex items-center gap-1.5 transition-colors">
                  <span>View</span>
                  <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <!-- Mobile Stacked Cards -->
    <div class="md:hidden divide-y divide-line">
      @foreach (var lead in Model.Leads)
      {
        <div class="p-4 space-y-2.5 @(!lead.IsRead ? "bg-red/[0.02]" : "")">
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono2 text-xs font-semibold text-red">#@lead.LeadId</span>
            @if (!lead.IsRead)
            {
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono2 font-semibold bg-red/10 text-red border border-red/25">
                New
              </span>
            }
            else
            {
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono2 font-medium bg-fog text-steel border border-line">
                Read
              </span>
            }
          </div>
          <div>
            <div class="font-semibold text-ink text-sm">@lead.FullName</div>
            <div class="text-[11px] text-steel">@lead.Source &middot; @lead.CreatedAt.ToString("dd MMM yyyy, hh:mm tt", CultureInfo.InvariantCulture)</div>
          </div>
          <div class="text-xs space-y-1 text-steel">
            @if (!string.IsNullOrWhiteSpace(lead.PhoneNumber))
            {
              <div><i class="fa-solid fa-phone text-red mr-1.5"></i>@lead.PhoneNumber</div>
            }
            @if (!string.IsNullOrWhiteSpace(lead.Email))
            {
              <div class="break-all"><i class="fa-solid fa-envelope text-steel mr-1.5"></i>@lead.Email</div>
            }
          </div>
          <div class="pt-1">
            <a href="/LeadDetails/@lead.LeadId" class="w-full py-2 px-3 rounded-lg bg-ink hover:bg-red text-white text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors">
              <span>View Details</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>
      }
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
      <div class="px-5 py-4 border-t border-line flex flex-wrap items-center justify-between gap-3 text-xs text-steel">
        <div>
          Showing page <strong class="text-ink">@Model.CurrentPage</strong> of <strong class="text-ink">@Model.TotalPages</strong> (@Model.TotalCount total)
        </div>
        <div class="flex items-center gap-1.5">
          @if (Model.CurrentPage > 1)
          {
            <a href="@Url.Action("Leads", "Admin", new { search = Model.Search, status = Model.StatusFilter, page = Model.CurrentPage - 1 })"
               class="px-3 py-1.5 rounded-lg border border-line hover:border-red text-ink hover:text-red font-medium">
              Prev
            </a>
          }
          @for (int p = 1; p <= Model.TotalPages; p++)
          {
            <a href="@Url.Action("Leads", "Admin", new { search = Model.Search, status = Model.StatusFilter, page = p })"
               class="px-3 py-1.5 rounded-lg font-mono2 font-semibold @(p == Model.CurrentPage ? "bg-red text-white" : "border border-line hover:border-red text-ink")">
              @p
            </a>
          }
          @if (Model.CurrentPage < Model.TotalPages)
          {
            <a href="@Url.Action("Leads", "Admin", new { search = Model.Search, status = Model.StatusFilter, page = Model.CurrentPage + 1 })"
               class="px-3 py-1.5 rounded-lg border border-line hover:border-red text-ink hover:text-red font-medium">
              Next
            </a>
          }
        </div>
      </div>
    }
  }
</div>
