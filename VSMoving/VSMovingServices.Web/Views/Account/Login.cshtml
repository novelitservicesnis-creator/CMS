@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" sizes="48x48" href="~/favicon.png" />
<title>Staff Sign In — VS Moving Services</title>

<script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />

<style type="text/tailwindcss">
@@theme {
  --color-ink: #131316;
  --color-red: #e01e26;
  --color-reddeep: #9c1319;
  --color-fog: #f4f5f7;
  --color-steel: #5b6270;
  --color-asphalt: #1a1b1e;
  --color-line: #e7e8eb;
  --font-display: "Oswald", sans-serif;
  --font-body: "Inter", sans-serif;
  --font-mono2: "IBM Plex Mono", monospace;
}
</style>

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-fog text-ink min-h-screen flex flex-col justify-between overflow-x-hidden">

<!-- Hazard Top Bar -->
<div class="hazard-thin h-[5px] w-full shrink-0"></div>

<main class="flex-1 flex items-center justify-center p-4 sm:p-6 md:p-10 relative">
  <div class="absolute inset-0 grid-dots opacity-35 pointer-events-none"></div>

  <div class="w-full max-w-4xl grid lg:grid-cols-11 bg-white rounded-2xl shadow-2xl shadow-ink/15 border border-line overflow-hidden relative z-10">

    <!-- Left Brand Showcase Panel -->
    <div class="lg:col-span-5 bg-ink text-white p-7 sm:p-9 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -right-12 -bottom-12 text-white/[0.04] text-[200px] pointer-events-none">
        <i class="fa-solid fa-truck-fast"></i>
      </div>

      <div class="relative z-10">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img src="~/images/logo.png" alt="VS Moving Services" class="h-11 w-auto" />
          <div class="leading-tight">
            <div class="font-display text-lg tracking-wide text-white">VS MOVING <span class="text-red">SERVICES</span></div>
            <div class="text-[10px] font-mono2 text-white/60 tracking-[0.18em]">HALIFAX &middot; NOVA SCOTIA</div>
          </div>
        </a>

        <div class="mt-8 sm:mt-10">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono2 tracking-[0.2em] text-red bg-red/15 px-3 py-1 rounded-full uppercase">
            <i class="fa-solid fa-shield-halved"></i> Staff Portal
          </span>
          <h1 class="font-display text-3xl sm:text-4xl tracking-tight mt-4 leading-none">
            DISPATCH &amp; LEAD <span class="text-red">CONSOLE.</span>
          </h1>
          <p class="text-white/65 text-sm mt-3 leading-relaxed">
            Authorized portal for VS Moving Services administrators and dispatch agents to manage customer quote enquiries and notification settings.
          </p>
        </div>
      </div>

      <div class="relative z-10 mt-8 pt-6 border-t border-white/10 space-y-2.5 text-xs text-white/70 font-mono2">
        <div class="flex items-center gap-2.5">
          <i class="fa-solid fa-check text-red"></i>
          <span>Real-time website enquiry tracking</span>
        </div>
        <div class="flex items-center gap-2.5">
          <i class="fa-solid fa-check text-red"></i>
          <span>Role-based Admin &amp; Agent access</span>
        </div>
        <div class="flex items-center gap-2.5">
          <i class="fa-solid fa-check text-red"></i>
          <span>Encrypted SMTP alert delivery</span>
        </div>
      </div>
    </div>

    <!-- Right Sign-In Form Panel -->
    <div class="lg:col-span-6 p-6 sm:p-9 md:p-11 flex flex-col justify-center bg-white">
      <div>
        <div class="text-xs font-mono2 uppercase tracking-[0.2em] text-red">Authentication Required</div>
        <h2 class="font-display text-2xl sm:text-3xl tracking-wide text-ink mt-1">SIGN IN TO YOUR ACCOUNT</h2>
        <p class="text-steel text-sm mt-1">Enter your registered email and password below.</p>
      </div>

      @if (!ViewData.ModelState.IsValid)
      {
        <div class="mt-5 rounded-xl bg-red/10 border border-red/30 p-4 text-sm text-red flex items-start gap-3" role="alert">
          <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
          <div asp-validation-summary="All" class="space-y-1 font-medium"></div>
        </div>
      }

      <form asp-controller="Account" asp-action="Login" method="post" class="mt-6 space-y-5" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div>
          <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-2">Email Address *</label>
          <div class="relative">
            <span class="WithIcon absolute inset-y-0 left-0 pl-3.5 flex items-center text-steel pointer-events-none">
              <i class="fa-solid fa-envelope text-sm"></i>
            </span>
            <input asp-for="Email" type="email" autocomplete="email" required placeholder="admin@vsmovingservices.com" class="lf-input pl-10!" />
          </div>
          <span asp-validation-for="Email" class="text-xs text-red mt-1 block"></span>
        </div>

        <div>
          <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-ink mb-2">Password *</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-steel pointer-events-none">
              <i class="fa-solid fa-lock text-sm"></i>
            </span>
            <input asp-for="Password" id="loginPassword" type="password" autocomplete="current-password" required placeholder="Enter your password" class="lf-input pl-10! pr-20!" />
            <button type="button" id="togglePwdBtn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-xs font-mono2 font-semibold text-steel hover:text-red transition-colors cursor-pointer" aria-label="Show or hide password">
              <i id="togglePwdIcon" class="fa-regular fa-eye mr-1"></i>
              <span id="togglePwdText">SHOW</span>
            </button>
          </div>
          <span asp-validation-for="Password" class="text-xs text-red mt-1 block"></span>
        </div>

        <div class="flex items-center justify-between gap-2 pt-1">
          <label class="inline-flex items-center gap-2.5 text-sm text-steel cursor-pointer select-none">
            <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 accent-red rounded cursor-pointer" />
            <span>Keep me signed in</span>
          </label>
        </div>

        <button type="submit" class="btn-red w-full py-3.5 px-6 rounded-lg text-sm inline-flex items-center justify-center gap-2 cursor-pointer">
          <i class="fa-solid fa-right-to-bracket"></i>
          <span>SIGN IN TO CONSOLE</span>
        </button>
      </form>

      <div class="mt-8 pt-5 border-t border-line flex items-center justify-between text-xs text-steel">
        <a href="/" class="inline-flex items-center gap-1.5 font-medium text-ink hover:text-red transition-colors">
          <i class="fa-solid fa-arrow-left"></i> Back to Public Website
        </a>
        <span class="font-mono2 text-[11px]">Halifax, NS</span>
      </div>
    </div>
  </div>
</main>

<footer class="py-4 text-center text-xs text-steel">
  &copy; 2026 VS Moving Services. Authorized personnel only.
</footer>

<script>
  const pwdInput = document.getElementById('loginPassword');
  const toggleBtn = document.getElementById('togglePwdBtn');
  const toggleIcon = document.getElementById('togglePwdIcon');
  const toggleText = document.getElementById('togglePwdText');

  if (pwdInput && toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = pwdInput.type === 'password';
      pwdInput.type = isHidden ? 'text' : 'password';
      toggleIcon.className = isHidden ? 'fa-regular fa-eye-slash mr-1' : 'fa-regular fa-eye mr-1';
      toggleText.textContent = isHidden ? 'HIDE' : 'SHOW';
    });
  }
</script>
</body>
</html>
