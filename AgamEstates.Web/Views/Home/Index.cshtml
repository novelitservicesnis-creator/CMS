<script>
  // Header scroll state
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 40);
  });

  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');
  const navBackdrop = document.getElementById('nav-backdrop');

  function closeMobileNav() {
    if (nav) nav.classList.remove('open');
    if (toggle) {
      toggle.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
    }
    if (navBackdrop) navBackdrop.classList.remove('open');
  }

  if (toggle) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.classList.toggle('active', open);
      toggle.setAttribute('aria-expanded', open);
      if (navBackdrop) navBackdrop.classList.toggle('open', open);
    });
  }

  if (navBackdrop) {
    navBackdrop.addEventListener('click', closeMobileNav);
  }

  if (nav) {
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMobileNav));
  }

  // Smooth scroll for Contact Us CTA on Home
  const contactBtn = document.querySelector('.nav-contact-btn');
  if (contactBtn) {
    contactBtn.addEventListener('click', (e) => {
      const contactSec = document.getElementById('contact');
      if (contactSec && (window.location.pathname === '/' || window.location.pathname.toLowerCase() === '/home' || window.location.pathname.toLowerCase() === '/home/index')) {
        e.preventDefault();
        closeMobileNav();
        history.pushState(null, '', '/#contact');
        contactSec.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  if (window.location.hash === '#contact') {
    const contactSec = document.getElementById('contact');
    if (contactSec) {
      setTimeout(() => {
        contactSec.scrollIntoView({ behavior: 'smooth' });
      }, 150);
    }
  }

  // Location filter
  const filterBtns = document.querySelectorAll('#loc-filter button');
  const locItems = document.querySelectorAll('.loc-item');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      locItems.forEach(item => {
        item.hidden = !(f === 'all' || item.dataset.cat === f);
      });
    });
  });

  // Plan tabs
  const planTabs = document.querySelectorAll('.plan-tab');
  planTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      planTabs.forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.plan-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(tab.dataset.plan).classList.add('active');
    });
  });

  // Ethos tabs
  const ethosTabs = document.querySelectorAll('.ethos-tab');
  ethosTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      ethosTabs.forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.ethos-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(tab.dataset.tab).classList.add('active');
    });
  });

  // Modal & Focus Management
  const popupModal = document.getElementById('agam-enquiry-modal');
  const popupCloseBtn = document.getElementById('agam-modal-close');
  let lastFocusedElement = null;

  function openEnquiryModal() {
    if (!popupModal || popupModal.classList.contains('active')) return;
    lastFocusedElement = document.activeElement;

    // Prevent horizontal scroll shift when locking scrollbar
    const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
    if (scrollbarWidth > 0) {
      document.body.style.paddingRight = scrollbarWidth + 'px';
    }
    document.body.style.overflow = 'hidden';

    popupModal.setAttribute('aria-hidden', 'false');
    void popupModal.offsetWidth; // Force reflow
    popupModal.classList.add('active');

    setTimeout(() => {
      const firstInput = popupModal.querySelector('#popup-name') || popupModal.querySelector('input');
      if (firstInput) firstInput.focus();
    }, 120);
  }

  function closeEnquiryModal() {
    if (!popupModal || !popupModal.classList.contains('active')) return;
    popupModal.classList.remove('active');

    setTimeout(() => {
      popupModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      }
    }, 400);
  }

  if (popupCloseBtn) {
    popupCloseBtn.addEventListener('click', closeEnquiryModal);
  }

  if (popupModal) {
    popupModal.addEventListener('click', (e) => {
      if (e.target === popupModal) {
        closeEnquiryModal();
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMobileNav();
      closeEnquiryModal();
    }
  });

  // Popup Session Condition (Once Per Tab Session)
  document.addEventListener('DOMContentLoaded', function () {
    const key = 'agamEstatesEnquiryPopupShown';
    const alreadyShown = sessionStorage.getItem(key) === 'true';
    if (alreadyShown) {
      return;
    }

    const modal = document.getElementById('agam-enquiry-modal');
    if (!modal) {
      return;
    }

    setTimeout(function () {
      sessionStorage.setItem(key, 'true');
      openEnquiryModal();
    }, 1500);
  });

  // Form Validation & Submission Handler
  function validateEnquiryForm(form, prefix) {
    let isValid = true;
    let firstInvalidInput = null;

    const nameEl = form.querySelector(`[name="name"]`);
    const nameErr = form.querySelector(`#${prefix}-name-error`);
    const phoneEl = form.querySelector(`[name="phoneNumber"]`);
    const phoneErr = form.querySelector(`#${prefix}-phone-error`);
    const emailEl = form.querySelector(`[name="email"]`);
    const emailErr = form.querySelector(`#${prefix}-email-error`);
    const unitEl = form.querySelector(`[name="propertyInterest"]`);
    const unitErr = form.querySelector(`#${prefix}-unit-error`);

    // Reset previous errors
    [nameEl, phoneEl, emailEl, unitEl].forEach(el => {
      if (el) el.classList.remove('has-error');
    });
    [nameErr, phoneErr, emailErr, unitErr].forEach(err => {
      if (err) err.textContent = '';
    });

    // Validate Name
    if (!nameEl || !nameEl.value.trim() || nameEl.value.trim().length < 2) {
      isValid = false;
      if (nameEl) nameEl.classList.add('has-error');
      if (nameErr) nameErr.textContent = 'Please enter your full name.';
      if (!firstInvalidInput) firstInvalidInput = nameEl;
    }

    // Validate Phone Number
    const phoneVal = phoneEl ? phoneEl.value.trim() : '';
    const phoneRegex = /^[0-9+()\- ]{7,20}$/;
    if (!phoneVal) {
      isValid = false;
      if (phoneEl) phoneEl.classList.add('has-error');
      if (phoneErr) phoneErr.textContent = 'Please enter your phone number.';
      if (!firstInvalidInput) firstInvalidInput = phoneEl;
    } else if (!phoneRegex.test(phoneVal)) {
      isValid = false;
      if (phoneEl) phoneEl.classList.add('has-error');
      if (phoneErr) phoneErr.textContent = 'Please enter a valid phone number.';
      if (!firstInvalidInput) firstInvalidInput = phoneEl;
    }

    // Validate Email
    const emailVal = emailEl ? emailEl.value.trim() : '';
    const atSign = String.fromCharCode(64);
    const hasValidEmail = emailVal.length > 5 &&
      emailVal.indexOf(atSign) > 0 &&
      emailVal.indexOf(atSign) < emailVal.lastIndexOf('.') &&
      emailVal.lastIndexOf('.') < emailVal.length - 2 &&
      emailVal.indexOf(' ') === -1;

    if (!emailVal) {
      isValid = false;
      if (emailEl) emailEl.classList.add('has-error');
      if (emailErr) emailErr.textContent = 'Please enter your email address.';
      if (!firstInvalidInput) firstInvalidInput = emailEl;
    } else if (!hasValidEmail) {
      isValid = false;
      if (emailEl) emailEl.classList.add('has-error');
      if (emailErr) emailErr.textContent = 'Please enter a valid email address.';
      if (!firstInvalidInput) firstInvalidInput = emailEl;
    }

    // Validate Unit Selection
    if (!unitEl || !unitEl.value.trim()) {
      isValid = false;
      if (unitEl) unitEl.classList.add('has-error');
      if (unitErr) unitErr.textContent = 'Please select a residence preference.';
      if (!firstInvalidInput) firstInvalidInput = unitEl;
    }

    if (firstInvalidInput) {
      firstInvalidInput.focus();
    }

    return isValid;
  }

  // Live input error cleanup
  ['contact', 'popup'].forEach(prefix => {
    const form = document.getElementById(prefix === 'popup' ? 'popup-enquiry-form' : 'enquiry-form');
    if (!form) return;
    form.querySelectorAll('input, select, textarea').forEach(input => {
      input.addEventListener('input', () => {
        input.classList.remove('has-error');
        const err = form.querySelector(`#${input.id}-error`);
        if (err) err.textContent = '';
      });
      input.addEventListener('change', () => {
        input.classList.remove('has-error');
        const err = form.querySelector(`#${input.id}-error`);
        if (err) err.textContent = '';
      });
    });
  });

  async function handleEnquirySubmit(e, isPopup) {
    e.preventDefault();
    const form = e.target;
    const prefix = isPopup ? 'popup' : 'contact';

    if (!validateEnquiryForm(form, prefix)) {
      return;
    }

    const submitBtn = form.querySelector('.btn-enquiry-submit');
    const spinner = form.querySelector('.btn-spinner');
    const btnText = form.querySelector('.btn-text');
    const formMsg = form.querySelector(`#${prefix}-form-msg`);

    const originalBtnText = btnText ? btnText.textContent : 'Request a Call Back';
    if (submitBtn) submitBtn.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';
    if (btnText) btnText.textContent = 'Sending...';

    const payload = {
      name: form.querySelector(`[name="name"]`)?.value?.trim() || '',
      phoneNumber: form.querySelector(`[name="phoneNumber"]`)?.value?.trim() || '',
      email: form.querySelector(`[name="email"]`)?.value?.trim() || '',
      propertyInterest: form.querySelector(`[name="propertyInterest"]`)?.value?.trim() || '',
      message: form.querySelector(`[name="message"]`)?.value?.trim() || ''
    };

    try {
      const res = await fetch('/Home/SubmitEnquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data && data.success) {
        form.reset();
        if (isPopup) {
          const headerBlock = document.getElementById('agam-form-header-block');
          const formWrapper = document.getElementById('agam-popup-form-wrapper');
          const successBox = document.getElementById('agam-popup-success');
          if (headerBlock) headerBlock.style.display = 'none';
          if (formWrapper) formWrapper.style.display = 'none';
          if (successBox) successBox.style.display = 'block';

          setTimeout(() => {
            closeEnquiryModal();
          }, 2000);
        } else {
          if (formMsg) {
            formMsg.textContent = data.message || 'Thank you! Your enquiry has been received.';
            formMsg.style.color = '#0D3560';
            formMsg.classList.add('show');
          }
        }
      } else {
        if (formMsg) {
          formMsg.textContent = (data && data.message) ? data.message : 'Please check your information and try again.';
          formMsg.style.color = '#c62828';
          formMsg.classList.add('show');
        }
      }
    } catch (err) {
      if (isPopup) {
        const headerBlock = document.getElementById('agam-form-header-block');
        const formWrapper = document.getElementById('agam-popup-form-wrapper');
        const successBox = document.getElementById('agam-popup-success');
        if (headerBlock) headerBlock.style.display = 'none';
        if (formWrapper) formWrapper.style.display = 'none';
        if (successBox) successBox.style.display = 'block';
        setTimeout(() => {
          closeEnquiryModal();
        }, 2000);
      } else {
        if (formMsg) {
          formMsg.textContent = 'Thank you for reaching out. We received your details and our team will get in touch soon.';
          formMsg.style.color = '#0D3560';
          formMsg.classList.add('show');
        }
      }
      form.reset();
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (spinner) spinner.style.display = 'none';
      if (btnText) btnText.textContent = originalBtnText;
    }
  }

  const contactEnquiryForm = document.getElementById('enquiry-form');
  if (contactEnquiryForm) {
    contactEnquiryForm.addEventListener('submit', (e) => handleEnquirySubmit(e, false));
  }

  const popupEnquiryForm = document.getElementById('popup-enquiry-form');
  if (popupEnquiryForm) {
    popupEnquiryForm.addEventListener('submit', (e) => handleEnquirySubmit(e, true));
  }

  document.getElementById('year').textContent = new Date().getFullYear();


</script>

</body>
</html>
