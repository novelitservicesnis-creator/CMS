<script>
    // Scroll spy for Terms sticky article index
    document.addEventListener('DOMContentLoaded', () => {
        const articles = document.querySelectorAll('.terms-article');
        const indexLinks = document.querySelectorAll('.terms-index-link');
        const mobileSelect = document.getElementById('terms-jump-select');

        function updateTermsSpy() {
            let current = '';
            articles.forEach(art => {
                const top = art.getBoundingClientRect().top;
                if (top <= 140) {
                    current = art.getAttribute('id');
                }
            });

            if (current) {
                indexLinks.forEach(link => {
                    link.classList.toggle('active', link.getAttribute('href') === '#' + current);
                });
                if (mobileSelect) {
                    mobileSelect.value = '#' + current;
                }
            }
        }

        window.addEventListener('scroll', updateTermsSpy, { passive: true });
        updateTermsSpy();
    });
</script>
