@inject AgamEstates.Web.Services.ISystemSettingsService SettingsService
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Terms & Conditions — Agam Estates";
    ViewData["ActiveNav"] = "TermsAndConditions";
    var siteSettings = await SettingsService.GetPublicSettingsAsync();
}

@section Styles {
<style>
/* ==========================================================================
   Agam Estates — Terms & Conditions Bespoke Styling
   Design Identity: Authoritative, Editorial, Contractual, Architectural, Formal
   ========================================================================== */

/* Terms Hero: Editorial Full-Width Navy with Document Metadata Block */
.terms-hero {
    position: relative;
    background: #041A33;
    padding: 175px 0 70px;
    border-bottom: 1px solid rgba(221, 174, 69, 0.25);
    overflow: hidden;
}

.terms-hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 52px;
    align-items: center;
}

.terms-hero-left h1 {
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    line-height: 1.12;
    color: var(--light);
    margin: 14px 0 20px;
    font-weight: 400;
}

.terms-hero-left h1 em {
    font-style: italic;
    color: var(--gold-soft);
    font-weight: 300;
}

.terms-hero-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--fade-light);
    max-width: 580px;
}

/* Formal Metadata Box */
.terms-meta-box {
    background: rgba(6, 37, 69, 0.65);
    border: 1px solid rgba(221, 174, 69, 0.35);
    border-radius: 2px;
    padding: 30px 28px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}

.terms-meta-box::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    border: 1px solid rgba(221, 174, 69, 0.12);
    pointer-events: none;
}

.terms-meta-tag {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    color: var(--gold);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 18px;
    display: block;
    border-bottom: 1px solid rgba(221, 174, 69, 0.25);
    padding-bottom: 10px;
}

.terms-meta-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.86rem;
    gap: 16px;
}

.meta-label {
    color: var(--fade-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.76rem;
}

.meta-val {
    color: var(--light);
    font-weight: 500;
    text-align: right;
    font-family: var(--sans);
}

/* Editorial Introduction Notice Band */
.terms-notice-band {
    background: #EFEADA;
    border-bottom: 1px solid rgba(6, 37, 69, 0.12);
    padding: 18px 0;
}

.terms-notice-content {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.92rem;
    color: var(--text-dark);
}

.notice-icon-badge {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    color: var(--gold-dark);
    font-size: 1.15rem;
    flex-shrink: 0;
}

/* Terms Body Layout: Slim Sticky Article Index + Canvas Articles */
.terms-body-wrap {
    padding: 72px clamp(20px, 5vw, 48px);
}

.terms-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 60px;
    align-items: flex-start;
}

/* Slim Sticky Article Index (No Box, Pure Editorial Typography) */
.terms-sidebar {
    position: sticky;
    top: 105px;
    padding-right: 18px;
    border-right: 1px solid rgba(6, 37, 69, 0.12);
}

.terms-sidebar-header {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--fade);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.terms-index-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.terms-index-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--fade);
    padding: 6px 8px;
    border-left: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.terms-index-link:hover {
    color: var(--primary);
    background: rgba(221, 174, 69, 0.08);
}

.terms-index-link.active {
    color: var(--primary);
    font-weight: 600;
    border-left-color: var(--gold);
    background: rgba(221, 174, 69, 0.12);
}

.terms-index-num {
    font-size: 0.72rem;
    color: var(--gold-dark);
    font-weight: 600;
}

/* Mobile Quick Jump Dropdown */
.terms-mobile-jump {
    display: none;
    margin-bottom: 28px;
    background: #FFFFFF;
    border: 1px solid rgba(221, 174, 69, 0.35);
    border-radius: 2px;
    padding: 12px 16px;
}

.terms-mobile-jump select {
    width: 100%;
    padding: 10px 12px;
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--text-dark);
    background: #F8F6F0;
    border: 1px solid rgba(6, 37, 69, 0.18);
    border-radius: 2px;
    outline: none;
}

/* Articles Flow (Direct on page, editorial publication aesthetic) */
.terms-articles-flow {
    display: flex;
    flex-direction: column;
    gap: 60px;
}

.terms-article {
    scroll-margin-top: 110px;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 32px;
    align-items: flex-start;
}

.article-num-col {
    padding-top: 4px;
}

.article-big-num {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--gold);
    font-weight: 500;
    display: block;
}

.article-content-col {
    display: flex;
    flex-direction: column;
}

.article-eyebrow {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--gold-dark);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
}

.terms-article h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    color: var(--text-dark);
    font-weight: 400;
    margin-bottom: 12px;
}

.article-divider-rule {
    width: 100%;
    height: 1px;
    background: rgba(6, 37, 69, 0.14);
    margin-bottom: 18px;
}

.terms-article p {
    color: #24354A;
    font-size: 0.96rem;
    line-height: 1.75;
    margin-bottom: 16px;
}

.terms-article p:last-child {
    margin-bottom: 0;
}

.terms-article ul {
    margin: 12px 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.terms-article li {
    position: relative;
    padding-left: 24px;
    color: #24354A;
    font-size: 0.94rem;
    line-height: 1.65;
}

.terms-article li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
}

/* Distinct Property Disclaimer Block (Article 03) */
.terms-disclaimer-card {
    background: #EFEADA;
    border-left: 4px solid var(--gold);
    border-radius: 2px;
    padding: 24px 26px;
    margin: 18px 0 10px;
}

.terms-disclaimer-card .disclaimer-tag {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--gold-dark);
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
}

.terms-disclaimer-card p {
    font-size: 0.92rem !important;
    line-height: 1.65 !important;
    color: var(--text-dark) !important;
    margin-bottom: 0 !important;
}

/* Architectural Blueprint Box (Article 05: Images & Illustrations) */
.architectural-blueprint-box {
    background: #FFFFFF;
    border: 1px solid rgba(221, 174, 69, 0.35);
    border-radius: 2px;
    padding: 24px;
    margin: 20px 0 12px;
    position: relative;
}

.blueprint-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: var(--gold);
}
.blueprint-tl { top: -1px; left: -1px; border-top: 2px solid var(--gold); border-left: 2px solid var(--gold); }
.blueprint-tr { top: -1px; right: -1px; border-top: 2px solid var(--gold); border-right: 2px solid var(--gold); }
.blueprint-bl { bottom: -1px; left: -1px; border-bottom: 2px solid var(--gold); border-left: 2px solid var(--gold); }
.blueprint-br { bottom: -1px; right: -1px; border-bottom: 2px solid var(--gold); border-right: 2px solid var(--gold); }

.blueprint-head {
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-weight: 600;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* Split Columns for Article 06 (Enquiry Submissions) */
.enquiry-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 18px 0 8px;
}

.enquiry-sub-box {
    background: #FFFFFF;
    border: 1px solid rgba(6, 37, 69, 0.12);
    border-radius: 2px;
    padding: 20px 18px;
}

.enquiry-sub-box h4 {
    font-family: var(--sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 8px;
}

.enquiry-sub-box p {
    font-size: 0.88rem !important;
    line-height: 1.6 !important;
    color: var(--fade) !important;
    margin-bottom: 0 !important;
}

/* Legal Desk Box (Article 14) */
.terms-desk-card {
    background: #FFFFFF;
    border: 1px solid rgba(6, 37, 69, 0.14);
    border-top: 3px solid var(--primary);
    border-radius: 2px;
    padding: 26px;
    margin-top: 20px;
}

.terms-desk-card h4 {
    font-size: 1.15rem;
    color: var(--primary);
    margin-bottom: 10px;
}

.terms-desk-card p {
    font-size: 0.9rem;
    color: var(--fade);
    margin-bottom: 6px;
}

.terms-desk-card p:last-child {
    margin-bottom: 0;
}

/* Final Full-Width Navy Acceptance Panel */
.terms-acceptance-banner {
    background: #041A33;
    border-top: 1px solid rgba(221, 174, 69, 0.25);
    padding: 60px 0;
    color: var(--light);
}

.terms-acceptance-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
}

.terms-acceptance-text h3 {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: var(--light);
    margin-bottom: 8px;
}

.terms-acceptance-text p {
    color: var(--fade-light);
    font-size: 0.95rem;
    max-width: 600px;
    line-height: 1.6;
}

.terms-acceptance-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.terms-alt-link {
    color: var(--gold-soft);
    font-size: 0.92rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border: 1px solid rgba(221, 174, 69, 0.35);
    border-radius: 2px;
    transition: all 0.2s ease;
}

.terms-alt-link:hover {
    background: rgba(221, 174, 69, 0.12);
    color: var(--light);
    border-color: var(--gold);
}

/* Responsive Rules for Terms & Conditions */
@@media (max-width: 991px) {
    .terms-hero-grid {
        grid-template-columns: 1fr;
        gap: 36px;
    }
    .terms-layout {
        grid-template-columns: 1fr;
        gap: 32px;
    }
    .terms-sidebar {
        display: none;
    }
    .terms-mobile-jump {
        display: block;
    }
    .terms-article {
        grid-template-columns: 56px 1fr;
        gap: 20px;
    }
    .article-big-num {
        font-size: 2.2rem;
    }
    .enquiry-split-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 600px) {
    .terms-hero {
        padding: 140px 0 50px;
    }
    .terms-article {
        grid-template-columns: 1fr;
        gap: 10px;
    }
    .article-big-num {
        font-size: 1.8rem;
    }
    .terms-acceptance-wrap {
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
    }
}
</style>
}

