@inject AgamEstates.Web.Services.ISystemSettingsService SettingsService
@{
    Layout = "_PublicLayout";
    var siteSettings = await SettingsService.GetPublicSettingsAsync();
}
@section Styles {
    <link rel="stylesheet" href="/css/herohomes.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/jubilee.css" asp-append-version="true">
}
<div class="jubilee-page">
<section class="page-hero">
    <div class="page-hero-bg"><img src="/images/jubilee/avenoir.jpg" alt="Architectural rendering of Jubilee Avenoir’s commercial development" fetchpriority="high"></div>
    <div class="wrap page-hero-content">
        <a class="eyebrow" href="/Project">&larr; Back to properties</a>
        <h1><strong>Jubilee</strong><br><em>Spaces for your next chapter.</em></h1>
        <div class="page-hero-divider"></div>
        <p class="page-hero-lede">Explore homes, independent floors and commercial destinations across Mohali and New Chandigarh. Discover five project selections from the Jubilee collection.</p>
        <div class="page-hero-actions"><a class="btn btn-gold" href="#projects">Explore Projects &darr;</a><button type="button" class="btn btn-outline-gold" data-jubilee-enquiry="Jubilee — Please advise">Request a Call Back</button></div>
        <div class="hero-meta-strip"><div class="hero-meta-item"><span class="hero-meta-label">Collection</span><span class="hero-meta-val">5 project selections</span></div><div class="hero-meta-item"><span class="hero-meta-label">Destinations</span><span class="hero-meta-val">Mohali &amp; New Chandigarh</span></div><div class="hero-meta-item"><span class="hero-meta-label">Opportunities</span><span class="hero-meta-val">Residential &amp; commercial</span></div></div>
    </div>
</section>
<section class="editorial-sec" id="projects"><div class="wrap">
    <div class="section-head"><span class="eyebrow">THE JUBILEE COLLECTION</span><h2>Find the space that fits your plans.</h2><p>Explore the project details below, or select a card to jump to its section.</p></div>
    <div class="jubilee-grid">
<a class="jubilee-card" href="#parkfield"><span class="jubilee-card-image"><span class="jubilee-card-art"><span>Jubilee</span><strong>Parkfield</strong><small>NEW CHANDIGARH</small></span></span><span class="jubilee-card-body"><span class="eyebrow">01 / NEW CHANDIGARH</span><span class="jubilee-card-title">Jubilee Parkfield</span><span class="jubilee-card-description">Explore the Parkfield project and speak to our team about available options.</span><span class="jubilee-card-action">Explore project &nearr;</span></span></a>
<a class="jubilee-card" href="#denvox"><span class="jubilee-card-image"><img src="/images/jubilee/denvox.jpg" alt="Jubilee Denvox project identity or layout" loading="lazy"></span><span class="jubilee-card-body"><span class="eyebrow">02 / OFFICE SPACE · SECTOR 102, MOHALI</span><span class="jubilee-card-title">Jubilee Denvox</span><span class="jubilee-card-description">A business address within the Jubilee Techyards master layout.</span><span class="jubilee-card-action">Explore project &nearr;</span></span></a>
<a class="jubilee-card" href="#avelia"><span class="jubilee-card-image"><img src="/images/jubilee/techyards.jpg" alt="Jubilee Avelia project identity or layout" loading="lazy"></span><span class="jubilee-card-body"><span class="eyebrow">03 / S+4 FLOORS · SECTOR 102, MOHALI</span><span class="jubilee-card-title">Jubilee Avelia</span><span class="jubilee-card-description">Independent floors in the Avelia Terraces precinct of Jubilee Techyards.</span><span class="jubilee-card-action">Explore project &nearr;</span></span></a>
<a class="jubilee-card" href="#elvira"><span class="jubilee-card-image"><img src="/images/jubilee/elvira.jpg" alt="Jubilee Elvira project identity or layout" loading="lazy"></span><span class="jubilee-card-body"><span class="eyebrow">04 / HIGHRISE · SECTOR 102, MOHALI</span><span class="jubilee-card-title">Jubilee Elvira</span><span class="jubilee-card-description">3 and 3+1 BHK residences with landscaped gardens and club amenities.</span><span class="jubilee-card-action">Explore project &nearr;</span></span></a>
<a class="jubilee-card" href="#mercasa-avenoir"><span class="jubilee-card-image"><img src="/images/jubilee/avenoir.jpg" alt="Jubilee Mercasa & Avenoir architectural rendering" loading="lazy"></span><span class="jubilee-card-body"><span class="eyebrow">05 / RESIDENTIAL & COMMERCIAL · NEW CHANDIGARH</span><span class="jubilee-card-title">Jubilee Mercasa & Avenoir</span><span class="jubilee-card-description">Mercasa residences in Sector 2 and Avenoir commercial spaces in Sector 3.</span><span class="jubilee-card-action">Explore project &nearr;</span></span></a>
</div>
    <p class="hh-note">Images and plans are conceptual architectural material. Confirm current approvals, registration, availability, areas and final specifications with the promoter.</p>
</div></section>
<section class="editorial-sec jubilee-project-section" id="parkfield" aria-labelledby="parkfield-title"><div class="wrap jubilee-detail-body"><h2 id="parkfield-title">Jubilee Parkfield</h2><p class="jubilee-detail-location">New Chandigarh</p><p>Explore Jubilee Parkfield with our team. Request current project information, available property types, layouts, pricing and a site visit.</p><div class="jubilee-detail-note">Unit sizes, specifications and a Parkfield-specific plan are not included in the supplied material. Contact us for the latest project details.</div><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee Parkfield">Enquire About Parkfield</button><p class="jubilee-detail-notice">Plans, areas and amenities are indicative. Confirm current approvals, RERA registration, sanctioned plans and contractual terms with the promoter.</p></div></section>
<section class="editorial-sec jubilee-project-section" id="denvox" aria-labelledby="denvox-title"><div class="wrap jubilee-detail-body"><h2 id="denvox-title">Jubilee Denvox</h2><p class="jubilee-detail-location">Office space · Sector 102, Mohali</p><p>An office-space destination shown within Jubilee Techyards. The supplied layout identifies the precinct as Sector 102-A, alongside National Highway 205-A and the proposed 150-foot sector-dividing road.</p><figure><img src="/images/jubilee/denvox.jpg" alt="Conceptual Denvox layout showing its site within Techyards beside the highway" loading="lazy"><figcaption>Denvox precinct · Conceptual layout, not to scale</figcaption></figure><h3>Find a workspace for your plans.</h3><p>Request office sizes, floor availability, parking arrangements, fit-out specifications and current commercial terms from our team.</p><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee Denvox — Office space">Enquire About Denvox</button><p class="jubilee-detail-notice">Plans, areas and amenities are indicative. Confirm current approvals, RERA registration, sanctioned plans and contractual terms with the promoter.</p></div></section>
<section class="editorial-sec jubilee-project-section" id="avelia" aria-labelledby="avelia-title"><div class="wrap jubilee-detail-body"><h2 id="avelia-title">Jubilee Avelia</h2><p class="jubilee-detail-location">Stilt + 4 floors · Sector 102, Mohali</p><p>Independent floors within the Avelia Terraces precinct. The supplied Techyards master layout identifies Avelia Terraces and labels the wider development Sector 102-A, Mohali.</p><figure><img src="/images/jubilee/techyards.jpg" alt="Techyards master layout identifying Avelia Terraces independent floors, Elvira and Denvox" loading="lazy"><figcaption>Avelia Terraces within the supplied Techyards master layout</figcaption></figure><p>Contact our team for current unit configurations, floor plans, areas, lift and parking arrangements, and specifications.</p><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee Avelia — S+4 floors">Enquire About Avelia</button><p class="jubilee-detail-notice">Plans, areas and amenities are indicative. Confirm current approvals, RERA registration, sanctioned plans and contractual terms with the promoter.</p></div></section>
<section class="editorial-sec jubilee-project-section" id="elvira" aria-labelledby="elvira-title"><div class="wrap jubilee-detail-body"><h2 id="elvira-title">Jubilee Elvira</h2><p class="jubilee-detail-location">Highrise residences · Sector 102-A, Mohali</p><p>The architectural presentation describes an approximately six-acre gated residential development within Jubilee Techyards, with four towers of stilt + 20 floors. Corner apartments are planned with balconies and views towards landscaped parks.</p><div class="jubilee-facts"><article><h3>3 BHK</h3><strong>1,870 sq. ft.</strong><p>Super area<br>Carpet: 1,046 sq. ft.<br>Balconies: 250 sq. ft.</p></article><article><h3>3+1 BHK</h3><strong>2,180 sq. ft.</strong><p>Super area<br>Carpet: 1,208 sq. ft.<br>Balconies: 276 sq. ft.</p></article></div><h3>Spaces for everyday wellbeing</h3><p>Proposed facilities include themed gardens, clubhouse, gym, swimming pool, indoor gaming arcade, aerobics room, meditation area, jogging track and children’s play area. Stilt and basement parking, multi-tier security and maintenance services are described in the presentation.</p><figure><img src="/images/jubilee/elvira-plan.jpg" alt="Elvira proposed 3+1 BHK unit plan with area schedule" loading="lazy"><figcaption>3+1 BHK · Architectural unit plan</figcaption></figure><div><h3>Finishes &amp; services</h3><p>Premium vitrified tiles, laminated wooden flooring in the master bedroom, modular kitchen with hob and chimney, UPVC windows with mesh shutters and anti-skid balcony tiles. Listed backup: 4 KVA for 3 BHK, 5 KVA for 3+1 BHK, and full backup for lifts and common safety facilities. Confirm final unit specifications.</p></div><div class="page-hero-actions"><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee Elvira — 3 BHK">Enquire About 3 BHK</button><button type="button" class="btn btn-outline-dark" data-jubilee-enquiry="Jubilee Elvira — 3+1 BHK">Enquire About 3+1 BHK</button></div><p class="jubilee-detail-notice">Plans, areas and amenities are indicative. Confirm current approvals, RERA registration, sanctioned plans and contractual terms with the promoter.</p></div></section>
<section class="editorial-sec jubilee-project-section" id="mercasa-avenoir" aria-labelledby="mercasa-avenoir-title"><div class="wrap jubilee-detail-body"><h2 id="mercasa-avenoir-title">Jubilee Mercasa &amp; Avenoir</h2><p class="jubilee-detail-location">Two destinations in New Chandigarh</p><section class="jubilee-subproject"><span class="eyebrow">RESIDENTIAL · SECTOR 2</span><h3>Jubilee Mercasa</h3><p>The presentation describes approximately 5.4 acres, six towers and 352 apartments, with two apartments per floor. The proposed development includes 3, 4 and 5 BHK residences with staff, store and powder rooms.</p><div class="jubilee-facts"><article><h4>3 BHK</h4><strong>3,125 / 3,225 sq. ft.</strong><p>Super area, depending on unit type<br>Carpet: 1,765 sq. ft.</p></article><article><h4>4 BHK</h4><strong>3,990 sq. ft.</strong><p>Super area<br>Carpet: 2,236 sq. ft.</p></article></div><p>Proposed amenities include a 45,000 sq. ft. clubhouse, all-weather pool, spa, gym, aerobics, banquet facilities, badminton and squash courts, themed gardens and children’s play spaces. Five-bedroom layouts and areas are available on request.</p><figure><img src="/images/jubilee/mercasa-plan.jpg" alt="Mercasa proposed master plan showing residential towers surrounding green space" loading="lazy"><figcaption>Mercasa · Proposed master plan</figcaption></figure><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee Mercasa — Residential">Enquire About Mercasa</button></section><section class="jubilee-subproject"><span class="eyebrow">COMMERCIAL · SECTOR 3</span><h3>Jubilee Avenoir</h3><p>A proposed mixed-use destination spanning approximately six acres. The concept brings premium retail, contemporary workspaces, serviced apartments, entertainment and hospitality together.</p><figure><img src="/images/jubilee/avenoir-courtyard.jpg" alt="Avenoir architectural rendering of a commercial courtyard with water features and retail frontages" loading="lazy"><figcaption>Avenoir · Artist’s impression</figcaption></figure><p>Speak with our team about the latest commercial formats, unit areas, availability and project approvals.</p><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee Avenoir — Commercial">Enquire About Avenoir</button></section><p class="jubilee-detail-notice">Plans, areas and amenities are indicative. Confirm current approvals, RERA registration, sanctioned plans and contractual terms with the promoter.</p></div></section>
<section class="editorial-sec dark-section"><div class="wrap editorial-split"><div class="editorial-body"><span class="eyebrow">PERSONAL GUIDANCE</span><h2>Let’s explore your options.</h2><p>Discuss your preferred project, residence or workspace with Agam Estates and arrange a visit.</p></div><div class="page-hero-actions"><button type="button" class="btn btn-gold" data-jubilee-enquiry="Jubilee — Please advise">Plan a Site Visit</button><a class="btn btn-outline-light" href="tel:@siteSettings.PrimaryPhone">Call Us</a></div></div></section>
</div>
@section Scripts {
    <script src="/js/jubilee.js" asp-append-version="true"></script>
}
