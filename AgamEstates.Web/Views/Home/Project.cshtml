      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Kumarhatti  Villas.png" alt="Solan Kumharhatti villas image"></div>
        <span class="partner-region">SOLAN · KUMHARHATTI</span>
        <h3>Kumharhatti Villas</h3><p class="project-card-description">Explore villas in the Solan–Kumharhatti area.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
    </div></div>
</section>
<section class="project-showcase">
    <div class="wrap">
        <div class="project-showcase-heading"><div><span class="eyebrow">OUR PROJECTS IN PICTURES</span><h2>A closer look at your next address.</h2></div><p>Different places. New possibilities.</p></div>
        <div class="project-showcase-grid">
            <div class="project-showcase-item"><figure><img src="/images/propertycardimages/Hero_Homes.png" alt="Hero Homes project" loading="lazy" decoding="async"><figcaption><span>Hero Homes</span></figcaption></figure></div>
            <div class="project-showcase-item"><figure><img src="/images/propertycardimages/Noble.png" alt="Noble project" loading="lazy" decoding="async"><figcaption><span>Noble</span></figcaption></figure></div>
            <div class="project-showcase-item"><figure><img src="/images/propertycardimages/Bollywood greens.png" alt="Bollywood Greens project" loading="lazy" decoding="async"><figcaption><span>Bollywood Greens</span></figcaption></figure></div>
            <div class="project-showcase-item"><figure><img src="/images/propertycardimages/Kumarhatti  Villas.png" alt="Kumharhatti Villas" loading="lazy" decoding="async"><figcaption><span>Kumharhatti Villas</span></figcaption></figure></div>
        </div>
    </div>
</section>
<section class="contact" id="contact">
  <div class="wrap contact-grid">
    <div>
      <div class="eyebrow">GET IN TOUCH</div>
      <h2 style="font-size:clamp(2rem,3.4vw,2.6rem); margin-top:14px;">Come see it before you decide</h2>
      <p style="color:var(--fade); margin-top:16px; max-width:420px;">Tell us what you are looking for. Our team will help you compare properties and arrange a site visit.</p>

      <div class="contact-detail">
        <svg viewBox="0 0 22 22" fill="none"><path d="M11 21C11 21 19 13.5 19 8.5C19 4.4 15.4 1 11 1C6.6 1 3 4.4 3 8.5C3 13.5 11 21 11 21Z" stroke="#0D3560" stroke-width="1.2"/><circle cx="11" cy="8.5" r="3" stroke="#0D3560" stroke-width="1.2"/></svg>
        <div>
          <strong>Site &amp; Sales Office</strong>
          <span>@siteSettings.FormattedAddress</span>
        </div>
      </div>
      <div class="contact-detail">
        <svg viewBox="0 0 22 22" fill="none"><path d="M3 5C3 4 4 3 5 3H8L10 8L7.5 9.5C8.5 12 10 13.5 12.5 14.5L14 12L19 14V17C19 18 18 19 17 19C9 19 3 13 3 5Z" stroke="#0D3560" stroke-width="1.2"/></svg>
        <div>
          <strong>Call the Sales Team</strong>
          @if (siteSettings.ActivePhones != null && siteSettings.ActivePhones.Any())
          {
            var phoneLinks = siteSettings.ActivePhones.Select(p => $"<a href=\"tel:{p.NumberClean}\">{p.PhoneNumber}</a>");
            @Html.Raw(string.Join(" &nbsp;·&nbsp; ", phoneLinks))
          }
          else if (siteSettings.PrimaryPhone != null)
          {
            <a href="tel:@siteSettings.PrimaryPhone.NumberClean">@siteSettings.PrimaryPhone.PhoneNumber</a>
          }
          else
          {
            <a href="#contact">Contact on request</a>
          }
        </div>
      </div>
      <div class="contact-detail">
        <svg viewBox="0 0 22 22" fill="none"><rect x="2" y="4" width="18" height="14" rx="1" stroke="#0D3560" stroke-width="1.2"/><path d="M2 5L11 12L20 5" stroke="#0D3560" stroke-width="1.2"/></svg>
        <div>
          <strong>Write to Us</strong>
          <a href="mailto:@(string.IsNullOrWhiteSpace(siteSettings.Email) ? "sales@agamestates.in" : siteSettings.Email)">@(string.IsNullOrWhiteSpace(siteSettings.Email) ? "sales@agamestates.in" : siteSettings.Email)</a>
        </div>
      </div>
      @if (siteSettings.GroupedBusinessHours != null && siteSettings.GroupedBusinessHours.Any())
      {
        <div class="contact-detail">
          <svg viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="9" stroke="#0D3560" stroke-width="1.2"/><path d="M11 6V11L14.5 13" stroke="#0D3560" stroke-width="1.2"/></svg>
          <div>
            <strong>Visit Hours</strong>
            <div style="display:flex; flex-direction:column; gap:6px; margin-top:2px;">
              @foreach (var g in siteSettings.GroupedBusinessHours)
              {
                <div style="display:flex; flex-direction:column; line-height:1.35;">
                  <span style="font-weight:500; color:var(--text-dark); font-size:0.90rem;">@g.Days</span>
                  <span style="color:var(--fade); font-size:0.86rem;">@g.Hours</span>
                </div>
              }
            </div>
          </div>
        </div>
      }
    </div>

    <div>
      @await Html.PartialAsync("_EnquiryForm", null, new ViewDataDictionary(ViewData) {
          { "Prefix", "contact" },
          { "FormId", "enquiry-form" },
          { "IsPopup", false }
      })
    </div>
  </div>
</section>
@section Scripts {
    <script src="/js/project-contact.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('[data-project-enquiry]').forEach(card => {
            card.addEventListener('click', () => {
                const title = card.querySelector('h3').textContent.trim();
                const region = card.querySelector('.partner-region').textContent.trim();
                const interest = document.querySelector('#popup-enquiry-form [name="propertyInterest"]');
                if (interest) {
                    const value = title + ' — ' + region;
                    let option = Array.from(interest.options).find(item => item.value === value);
                    if (!option) {
                        option = new Option(value, value);
                        interest.add(option);
                    }
                    interest.value = value;
                }
                openEnquiryModal();
            });
        });
    </script>
}