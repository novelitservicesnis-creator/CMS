@inject AgamEstates.Web.Services.ISystemSettingsService SettingsService
@{
    Layout = "_PublicLayout";
    var siteSettings = await SettingsService.GetPublicSettingsAsync();
    ViewData["Title"] = "Explore Properties — Agam Estates";
    ViewData["ActiveNav"] = "Project";
}
@section Styles {
    <link rel="stylesheet" href="/css/projects.css" asp-append-version="true">
}
<section class="project-intro">
    <div class="wrap">
        <span class="eyebrow">EXPLORE PROPERTIES</span>
        <h1 style="color:white">Properties Worth Discovering.</h1>
        <p>Find your next home, investment, or commercial space.</p>
    </div>
</section>
<section class="project-listing" aria-label="Properties">
    <div class="wrap"><div class="partner-grid">
<a class="partner-card" href="/herohomes">
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Hero_Homes.png" alt="Hero Homes project image"></div>
        <span class="partner-region">SECTOR 99 MOHALI</span>
        <h3>Hero Homes</h3><p class="project-card-description">Explore Hero Homes in Sector 99 Mohali.</p>
      <span class="project-card-action">Explore Project &nearr;</span></a>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Noble.png" alt="Noble Aurellia and Magnolia project image"></div>
        <span class="partner-region">SECTOR 88 MOHALI</span>
        <h3>Noble</h3><p class="project-card-description">Aurellia and Magnolia in Sector 88 Mohali.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/SBP.png" alt="SBP project image"></div>
        <span class="partner-region">SECTORS 99  &amp; 127 MOHALI</span>
        <h3>SBP</h3><p class="project-card-description">Explore SBP projects in Sectors 99 and 127 Mohali.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Bollywood greens.png" alt="Bollywood Greens project image"></div>
        <span class="partner-region">SECTOR 113 MOHALI</span>
        <h3>Bollywood Greens</h3><p class="project-card-description">Explore Bollywood Greens in Sector 113 Mohali.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Nirwana Moksha.png" alt="Nirwana Moksha project image"></div>
        <span class="partner-region">CHANDIGARH–KURALI ROAD</span>
        <h3>Nirwana Moksha</h3><p class="project-card-description">Explore Nirwana Moksha on Chandigarh–Kurali Road.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Dream Homes.png" alt="Dream Homes ICON project image"></div>
        <span class="partner-region">SECTOR 126 MOHALI</span>
        <h3>Dream Homes ICON</h3><p class="project-card-description">Explore Dream Homes ICON in Sector 126 Mohali.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Jubilee.png"  alt="Jubilee projects image"></div>
        <span class="partner-region">SECTOR 102 · NEW CHANDIGARH</span>
        <h3>Jubilee</h3><p class="project-card-description">Avelia Floors, Denvox Office Space and Elvira Highrise in Sector 102; Parkfield in Sectors 19 and 21, New Chandigarh.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/2bhk50lakh.png"  alt="2 BHK homes from 50 lakh to 1 crore image"></div>
        <span class="partner-region">2 BHK · BUDGET</span>
        <h3>₹50 Lakh – ₹1 Crore</h3><p class="project-card-description">Explore 2 BHK homes in the ₹50 lakh to ₹1 crore range.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/2bhk-1crore.png" alt="2 BHK homes from 1 crore to 1.5 crore image"></div>
        <span class="partner-region">2 BHK · BUDGET</span>
        <h3>₹1 Crore – ₹1.5 Crore</h3><p class="project-card-description">Explore 2 BHK homes in the ₹1 crore to ₹1.5 crore range.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
                    <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/3bhk-1crore.png" alt="3 BHK homes from 1 crore to 2 crore image"></div>
        <span class="partner-region">3 BHK · BUDGET</span>
        <h3>₹1 Crore – ₹2 Crore</h3><p class="project-card-description">Explore 3 BHK homes in the ₹1 crore to ₹2 crore range.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/3bhk-crore (1).png" alt="3 BHK homes from 2 crore to 3 crore image"></div>
        <span class="partner-region">3 BHK · BUDGET</span>
        <h3>₹2 Crore – ₹3 Crore</h3><p class="project-card-description">Explore 3 BHK homes in the ₹2 crore to ₹3 crore range.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/4bhk.png" alt="4 BHK homes from 1.5 crore to 4 crore image"></div>
        <span class="partner-region">4 BHK · BUDGET</span>
        <h3>₹1.5 Crore – ₹4 Crore</h3><p class="project-card-description">Explore 4 BHK homes in the ₹1.5 crore to ₹4 crore range.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/5bhk.png" alt="5 BHK homes from 3 crore onwards image"></div>
        <span class="partner-region">5 BHK · BUDGET</span>
        <h3>₹3 Crore Onwards</h3><p class="project-card-description">Explore 5 BHK homes starting from ₹3 crore.</p>
      <span class="project-card-action">Enquire &nearr;</span></button>
<button type="button" class="partner-card" data-project-enquiry>
        <div class="partner-photo"><img loading="lazy" decoding="async" src="/images/propertycardimages/Dholera.png" alt="Dholera Gujarat project image"></div>
