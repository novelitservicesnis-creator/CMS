@inject AgamEstates.Web.Services.ISystemSettingsService SettingsService
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Privacy Policy — Agam Estates";
    ViewData["ActiveNav"] = "PrivacyPolicy";
    var siteSettings = await SettingsService.GetPublicSettingsAsync();
}

@section Styles {
<style>
/* ==========================================================================
   Agam Estates — Privacy Policy Bespoke Styling
   Design Identity: Modern, Calm, Secure, Data-Transparency Focused
   ========================================================================== */

/* Privacy Hero: 2-Column Split with Abstract Privacy Graphic */
.privacy-hero {
    position: relative;
    background: linear-gradient(135deg, #041A33 0%, #062545 60%, #0D3560 100%);
    padding: 175px 0 75px;
    overflow: hidden;
    border-bottom: 1px solid rgba(221, 174, 69, 0.2);
}

.privacy-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 30%, rgba(221, 174, 69, 0.08) 0%, transparent 60%);
    pointer-events: none;
}

.privacy-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
}

.privacy-hero-text h1 {
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    line-height: 1.12;
    color: var(--light);
    margin: 14px 0 18px;
    font-weight: 400;
}

.privacy-hero-divider {
    width: 56px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 22px;
}

.privacy-hero-lede {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--fade-light);
    max-width: 540px;
    margin-bottom: 28px;
}

.privacy-meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.privacy-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(4, 26, 51, 0.6);
    border: 1px solid rgba(221, 174, 69, 0.25);
    border-radius: 20px;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--gold-soft);
}

.privacy-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
}

/* Hero Abstract Privacy Vector */
.privacy-hero-art {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.privacy-art-svg {
    width: 100%;
    max-width: 380px;
    height: auto;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.35));
}

/* Privacy at a Glance (Summary Section) */
.privacy-glance {
    background: #F3EFE6;
    border-bottom: 1px solid rgba(221, 174, 69, 0.22);
    padding: 64px 0;
}

.privacy-glance-head {
    margin-bottom: 38px;
}

.privacy-glance-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    color: var(--text-dark);
    margin-top: 6px;
}

.privacy-glance-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.glance-card {
    background: #FFFFFF;
    border: 1px solid rgba(6, 37, 69, 0.12);
    border-top: 3px solid var(--gold);
    border-radius: 2px;
    padding: 28px 22px;
    box-shadow: 0 4px 16px rgba(6, 37, 69, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.glance-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(6, 37, 69, 0.08);
}

.glance-num {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
}

.glance-title {
    font-family: var(--sans);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 10px;
}

.glance-desc {
    font-size: 0.88rem;
    color: var(--fade);
    line-height: 1.6;
}

/* Main Long-Form Layout (Sidebar + Clean Flowing Sections) */
.privacy-body-wrap {
    padding: 72px clamp(20px, 5vw, 48px);
}

.privacy-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 56px;
    align-items: flex-start;
}

/* Sticky Sidebar Index */
.privacy-sidebar {
    position: sticky;
    top: 105px;
    padding-right: 20px;
    border-right: 1px solid rgba(6, 37, 69, 0.1);
}

.privacy-sidebar-title {
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    color: var(--fade);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 18px;
}

.privacy-nav-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.privacy-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--fade);
    padding: 7px 10px;
    border-radius: 2px;
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
}

.privacy-nav-item:hover {
    color: var(--primary);
    background: rgba(221, 174, 69, 0.08);
}

.privacy-nav-item.active {
    color: var(--primary);
    font-weight: 500;
    border-left-color: var(--gold);
    background: rgba(221, 174, 69, 0.12);
}

.privacy-nav-num {
    font-size: 0.74rem;
    color: var(--gold-dark);
    font-weight: 600;
}

/* Privacy Long-Form Content (Flows directly on canvas, no giant box) */
.privacy-flow {
    display: flex;
    flex-direction: column;
    gap: 52px;
}

.privacy-section {
    scroll-margin-top: 110px;
}

.privacy-sec-header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 10px;
}

.privacy-sec-number {
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--gold);
    font-weight: 600;
}

.privacy-section h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    color: var(--text-dark);
    font-weight: 500;
}

.privacy-sec-rule {
    width: 100%;
    height: 1px;
    background: rgba(221, 174, 69, 0.25);
    margin-bottom: 20px;
}

.privacy-section p {
    color: #24354A;
    font-size: 0.96rem;
    line-height: 1.75;
    margin-bottom: 16px;
}

.privacy-section p:last-child {
    margin-bottom: 0;
}

.privacy-section ul {
    margin: 12px 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.privacy-section li {
    position: relative;
    padding-left: 24px;
    color: #24354A;
    font-size: 0.94rem;
    line-height: 1.65;
}

.privacy-section li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
}

/* Structured Information Types Layout */
.privacy-data-types {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 24px 0 10px;
}

.data-type-box {
    background: #FFFFFF;
    border: 1px solid rgba(6, 37, 69, 0.12);
    border-radius: 2px;
    padding: 24px 20px;
    box-shadow: 0 2px 10px rgba(6, 37, 69, 0.03);
}

.data-type-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(221, 174, 69, 0.22);
}

.data-type-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(221, 174, 69, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    flex-shrink: 0;
}

.data-type-header h4 {
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.02em;
}

.data-type-list {
    list-style: none !important;
    margin: 0 !important;
    gap: 8px !important;
}

.data-type-list li {
    padding-left: 0 !important;
    font-size: 0.88rem !important;
    color: var(--text-dark) !important;
    display: flex;
    align-items: baseline;
    gap: 8px;
}

.data-type-list li::before {
    display: none !important;
}

.data-type-check {
    color: var(--gold);
    font-size: 0.85rem;
    flex-shrink: 0;
}

/* Privacy Data Flow Diagram */
.privacy-flow-diagram {
    background: #FFFFFF;
    border: 1px solid rgba(221, 174, 69, 0.25);
    border-radius: 2px;
    padding: 28px 24px;
    margin: 24px 0 16px;
}

.flow-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    position: relative;
}

.flow-step {
    position: relative;
    padding: 16px;
    background: #F8F6F0;
    border: 1px solid rgba(6, 37, 69, 0.08);
    border-radius: 2px;
}

.flow-step-num {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--gold-dark);
    letter-spacing: 0.08em;
    margin-bottom: 6px;
}

.flow-step-title {
    font-family: var(--sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 6px;
    line-height: 1.3;
}

.flow-step-desc {
    font-size: 0.8rem;
    color: var(--fade);
    line-height: 1.5;
}

.flow-connector {
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 1rem;
    z-index: 2;
}

/* Dark Navy User Rights Feature Section */
.privacy-rights-panel {
    background: #041A33;
    color: var(--light);
    border-radius: 2px;
    padding: 44px 38px;
    margin: 20px 0 10px;
    border: 1px solid rgba(221, 174, 69, 0.25);
    position: relative;
    overflow: hidden;
}

.privacy-rights-panel::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(221, 174, 69, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.privacy-rights-panel h3 {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    color: var(--light);
    margin: 8px 0 14px;
}

.privacy-rights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 26px;
}

.right-card {
    background: rgba(6, 37, 69, 0.7);
    border: 1px solid rgba(221, 174, 69, 0.2);
    border-radius: 2px;
    padding: 20px 18px;
}

.right-card-title {
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--gold-soft);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.right-card p {
    color: var(--fade-light) !important;
    font-size: 0.86rem !important;
    line-height: 1.55 !important;
    margin-bottom: 0 !important;
}

/* Privacy Contact Callout */
.privacy-callout-card {
    background: #FFFFFF;
    border: 1px solid rgba(6, 37, 69, 0.14);
    border-left: 4px solid var(--gold);
    border-radius: 2px;
    padding: 28px;
    margin-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
}

.privacy-callout-info h4 {
    font-size: 1.25rem;
    color: var(--primary);
    margin-bottom: 8px;
}

.privacy-callout-info p {
    font-size: 0.9rem;
    color: var(--fade);
    margin-bottom: 6px;
}

.privacy-callout-info p:last-child {
    margin-bottom: 0;
}

/* Responsive Rules for Privacy Policy */
@@media (max-width: 991px) {
    .privacy-hero-grid {
        grid-template-columns: 1fr;
        gap: 36px;
    }
    .privacy-hero-art {
        display: none;
    }
    .privacy-glance-grid {
        grid-template-columns: 1fr 1fr;
    }
    .privacy-layout {
        grid-template-columns: 1fr;
        gap: 36px;
    }
    .privacy-sidebar {
        display: none;
    }
    .privacy-data-types {
        grid-template-columns: 1fr;
    }
    .flow-steps {
        grid-template-columns: 1fr;
        gap: 12px;
    }
    .flow-connector {
        display: none;
    }
    .privacy-rights-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 600px) {
    .privacy-glance-grid {
        grid-template-columns: 1fr;
    }
    .privacy-hero {
        padding: 140px 0 50px;
    }
    .privacy-rights-panel {
        padding: 28px 20px;
    }
    .privacy-callout-card {
        padding: 20px;
    }
}
</style>
}

<!-- Privacy Hero: 2-Column Split with Abstract Privacy Art -->
