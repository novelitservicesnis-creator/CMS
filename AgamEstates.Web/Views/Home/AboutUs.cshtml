@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "About Us — Agam Estates | Tricity Real Estate Developer";
    ViewData["ActiveNav"] = "AboutUs";
}

<!-- About Us Hero -->
<section class="page-hero">
    <div class="page-hero-bg">
        <img src="https://images.pexels.com/photos/38197605/pexels-photo-38197605.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Agam Estates Architecture and Development">
    </div>
    <div class="page-hero-pattern">
        <svg viewBox="0 0 1400 900" fill="none" preserveAspectRatio="xMidYMax slice" style="position:absolute; inset:0; width:100%; height:100%;">
            <line x1="0" y1="260" x2="1400" y2="260" stroke="#DDAE45" stroke-opacity="0.2"/>
            <line x1="0" y1="560" x2="1400" y2="560" stroke="#DDAE45" stroke-opacity="0.14"/>
            <line x1="450" y1="0" x2="450" y2="900" stroke="#DDAE45" stroke-opacity="0.15"/>
            <line x1="950" y1="0" x2="950" y2="900" stroke="#DDAE45" stroke-opacity="0.15"/>
        </svg>
    </div>

    <div class="wrap page-hero-content">
        <span class="eyebrow">ABOUT AGAM ESTATES</span>
        <h1>Homes designed with intent.<br><em>Built with responsibility.</em></h1>
        <div class="page-hero-divider"></div>
        <p class="page-hero-lede">
            Agam Estates is a Tricity-focused real estate developer founded on a singular conviction: that a home should be an enduring sanctuary built with architectural discipline, environmental sensitivity, and absolute construction integrity.
        </p>

        <div class="page-hero-actions">
            <button type="button" class="btn btn-gold" onclick="openEnquiryModal()">
                <span>Speak With Our Team</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <a href="#philosophy" class="btn btn-outline-gold">
                <span>Our Philosophy</span>
            </a>
        </div>
    </div>
</section>

<!-- 1. Who We Are -->
<section class="editorial-sec" id="who-we-are">
    <div class="wrap">
        <div class="editorial-split">
            <div class="editorial-frame">
                <img src="https://images.pexels.com/photos/16072809/pexels-photo-16072809.jpeg?auto=compress&cs=tinysrgb&w=900" alt="Architectural Integrity, Agam Estates">
                <div class="editorial-caption">FOUNDATIONS &amp; CRAFT · TRICITY REGION</div>
            </div>

            <div class="editorial-body">
                <span class="eyebrow">WHO WE ARE</span>
                <h2>A focused developer committed to enduring quality.</h2>
                <p class="lead">
                    In an era where real estate is frequently commoditized into high-volume, repetitive towers, Agam Estates pursues a deliberately different trajectory.
                </p>
                <p>
                    We concentrate our energy and leadership oversight on a controlled portfolio of residential developments in the Panchkula and Tricity region. By maintaining direct, day-to-day engagement with site engineering, material procurement, and architectural detailing, we ensure that every square foot meets rigorous standards of structural soundness, acoustic privacy, and thermal comfort.
                </p>
                <p>
                    Our leadership brings decades of collective experience in land planning, engineering governance, and customer advisory. We measure success not by the rapid volume of sales, but by the generational pride of the families who make our developments their home.
                </p>

                <div style="margin-top:28px; padding-top:24px; border-top:1px solid rgba(6,37,69,0.12); display:flex; gap:36px; flex-wrap:wrap;">
                    <div>
                        <strong style="display:block; font-family:var(--serif); font-size:1.6rem; color:var(--primary);">Focused</strong>
                        <span style="font-size:0.82rem; color:var(--fade); text-transform:uppercase; letter-spacing:0.06em;">Development Scope</span>
                    </div>
                    <div>
                        <strong style="display:block; font-family:var(--serif); font-size:1.6rem; color:var(--primary);">Direct</strong>
                        <span style="font-size:0.82rem; color:var(--fade); text-transform:uppercase; letter-spacing:0.06em;">Executive Governance</span>
                    </div>
                    <div>
                        <strong style="display:block; font-family:var(--serif); font-size:1.6rem; color:var(--primary);">Tricity</strong>
                        <span style="font-size:0.82rem; color:var(--fade); text-transform:uppercase; letter-spacing:0.06em;">Regional Roots</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. Our Philosophy -->
<section class="editorial-sec dark-section" id="philosophy">
    <div class="wrap">
        <div class="section-head center">
            <span class="eyebrow" style="color:var(--gold-soft);">CORE PHILOSOPHY</span>
            <h2 style="color:var(--light);">Principles that guide every drawing and concrete pour.</h2>
            <p style="color:#C6D0E0;">
                Four unyielding commitments that define our approach to development, design, and relationship with homeowners.
            </p>
        </div>

        <div class="cards-grid-4">
            <div class="lux-card" style="background:rgba(6,37,69,0.7); border-color:rgba(221,174,69,0.25);">
                <div class="lux-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                </div>
                <h3 style="color:var(--light);">Design First</h3>
                <p style="color:#C6D0E0;">Every floorplate begins with natural light, spatial proportion, and cross-ventilation. We design homes to elevate the daily rituals of family life.</p>
            </div>

            <div class="lux-card" style="background:rgba(6,37,69,0.7); border-color:rgba(221,174,69,0.25);">
                <div class="lux-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3 style="color:var(--light);">Quality Uncompromised</h3>
                <p style="color:#C6D0E0;">From structural grade steel to multi-coat waterproofing and precision joinery, we never downgrade specifications for expediency.</p>
            </div>

            <div class="lux-card" style="background:rgba(6,37,69,0.7); border-color:rgba(221,174,69,0.25);">
                <div class="lux-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                </div>
                <h3 style="color:var(--light);">Transparent Advisory</h3>
                <p style="color:#C6D0E0;">Clear, unambiguous communication at every step. Real carpet areas, honest progress schedules, and direct access to project managers.</p>
            </div>

            <div class="lux-card" style="background:rgba(6,37,69,0.7); border-color:rgba(221,174,69,0.25);">
                <div class="lux-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                </div>
                <h3 style="color:var(--light);">Long-Term Responsibility</h3>
                <p style="color:#C6D0E0;">We construct buildings designed for decades of low maintenance, energy efficiency, rainwater recharge, and enduring civic dignity.</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. Our Approach: Process Timeline -->
<section class="editorial-sec" id="approach">
    <div class="wrap">
        <div class="section-head center">
            <span class="eyebrow">OUR METHODOLOGY</span>
            <h2>How we bring a development from conception to handover.</h2>
            <p>
                A rigorous, multi-stage process that balances architectural vision with disciplined engineering checkpoints.
            </p>
        </div>

        <div class="approach-timeline">
            <div class="timeline-step">
                <div class="step-num">01</div>
                <h3 class="step-title">Land &amp; Context</h3>
                <p class="step-desc">Selecting prime parcels with clean legal titles, excellent regional transit access, and unobstructed environmental sightlines.</p>
            </div>

            <div class="timeline-step">
                <div class="step-num">02</div>
                <h3 class="step-title">Master Planning</h3>
                <p class="step-desc">Establishing optimal building orientations, sun angles, wind paths, and a dedicated, vehicle-free green spine.</p>
            </div>

            <div class="timeline-step">
                <div class="step-num">03</div>
                <h3 class="step-title">Architecture &amp; Detailing</h3>
                <p class="step-desc">Crafting proportioned 3 &amp; 4 BHK layouts with zero wasted hallway space, generous decks, and natural acoustic isolation.</p>
            </div>

            <div class="timeline-step">
                <div class="step-num">04</div>
                <h3 class="step-title">Controlled Construction</h3>
                <p class="step-desc">Direct execution overseen by qualified structural engineers, utilizing tested ready-mix concrete and certified structural reinforcement.</p>
            </div>

            <div class="timeline-step">
                <div class="step-num">05</div>
                <h3 class="step-title">Quality Audit &amp; Testing</h3>
                <p class="step-desc">Comprehensive multi-point inspections covering electrical conductivity, plumbing pressure, waterproofing, and fenestration seals.</p>
            </div>

            <div class="timeline-step">
                <div class="step-num">06</div>
                <h3 class="step-title">Handover &amp; Care</h3>
                <p class="step-desc">A structured walkthrough with documentation, followed by attentive transition support and post-possession maintenance orientation.</p>
            </div>
        </div>
    </div>
</section>

<!-- 4. Why Clients Choose Agam Estates -->
