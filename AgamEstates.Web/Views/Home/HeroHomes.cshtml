@inject AgamEstates.Web.Services.ISystemSettingsService SettingsService
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Hero Homes | Leafsong Retreat, Sector 99 Mohali — Agam Estates";
    var siteSettings = await SettingsService.GetPublicSettingsAsync();
    var gallery = new[] {
        ("pool-residences", "Poolside perspectives", "Swimming pool with residential towers beyond"),
        ("Leafsong-Retreat-5", "Reflections at dusk", "Colourful clubhouse reflected in the pool at dusk"),
        ("Leafsong-Retreat-4", "A greener everyday", "Garden pathway lined with palms and residential towers"),
        ("Leafsong-Retreat-3", "Evenings at home", "Illuminated residential courtyard and landscaped paths"),
        ("club-landscape", "Space to unwind", "Elevated view of the clubhouse, pool and surrounding gardens"),
        ("Leafsong-Retreat", "A view of the skyline", "Panoramic view of residential towers beneath a cloudy sky"),
        ("the-chord-club", "A colourful welcome", "Clubhouse entrance with colourful facade panels"),
        ("night-aerial1", "After the sun sets", "Hero Homes Mohali aerial photograph with a tower lit in tricolour")
    };
    var amenities = new[] {
        ("Water & pools", "Lagoon-style swimming pool, kids’ pool, pool deck, Jacuzzi, lily ponds, stepped water feature with sculpture, shallow water features with bubblers, and sculpture court."),
        ("Gardens & nature", "Central lawn, bird-watching zone, butterfly, reflexology, Zen, stepped, ornamental, flower and herb gardens; edible landscape, mound and succulent gardens, bamboo grove, forest, forest trail, and picnic lawn."),
        ("Sports & fitness", "Walking and cycle tracks, tennis, badminton, half basketball court, box cricket, Pilates, yoga and meditation deck, open gym, and indoor kids’ play area."),
        ("Leisure & community", "Kids’ play area, tree court with hammocks, seating deck and pods, open-air theatre, play maze, tree house, canopies, gazebo seating, party pavilion, senior citizen park, and pet park."),
        ("Learning & creativity", "Co-working lounge, meeting rooms, workstations, library, art display wall, art studio, pottery studio, and dance studio."),
        ("Wellness & rejuvenation", "Yoga studio, steam room, juice bar, spa and sauna, gardening terrace, gym, and salon."),
        ("Dining & social spaces", "Café, fine dining, banquet hall, miniplex, card room, snooker, board games, live chess and ludo, table tennis, air hockey, foosball, squash court, open library, senior lounge, and barbeque hut."),
        ("Family & convenience", "Crèche, sand pit, hopscotch, traffic-free zones, wheelchair-accessible complex, convenience shops, OPD service and doctor on call, planned senior activities, ironing service, delivery runner, and pet walker/stroller on call."),
        ("Home & mobility", "Gardening and horticulture service, plumber and electrician on call, car cleaning and repair on call, EV charging, electrical golf cart services, and dedicated car parking."),
        ("Health & safety", "Emergency alarm system, intercom, RWA and maintenance office, smoke detectors, power backup, and a guard on duty 24×7.")
