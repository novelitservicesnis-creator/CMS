    var specifications = new[] {
        ("Living room", "Imported marble flooring, low-VOC acrylic emulsion walls, false ceiling and lighting as designed, pre-hung fire-rated entrance door with veneer finish and polish on both sides, and a smart door lock with provision for a door camera."),
        ("Bedrooms", "Laminated wooden flooring, low-VOC acrylic emulsion on walls and ceilings, and pre-hung doors with veneer polish on one side and laminate on the other."),
        ("Kitchen", "Imported marble flooring; low-VOC paint with vitrified tile/stone backsplash up to 2 feet above the counter; granite countertop with double-bowl sink; modular cabinetry, hob and chimney, RO, geyser, convection microwave, washing machine, refrigerator, and dishwasher."),
        ("Bathrooms", "Anti-skid vitrified flooring, wall tiles up to the false ceiling, laminated doors, UPVC/aluminium windows or ventilators, and granite/composite-stone countertops. Master bathroom includes vanity, mirror, shower partition, and geyser. Other bathroom fittings vary by layout."),
        ("Store / study", "Vitrified flooring, low-VOC acrylic emulsion walls and ceiling, and pre-hung doors with veneer polish on one side and laminate on the other."),
        ("Balconies & windows", "Anti-skid vitrified balcony flooring, weather-shield external finishes, glass and metal railings as designed, and masonry with MS railing for utility balconies. UPVC/aluminium glazing with mesh shutters on balcony doors; wraparound balconies in selected locations."),
        ("Electrical & air conditioning", "ISI-marked PVC conduits and copper wiring, modular switches and sockets, provisions for fans and ceiling lights, and VRV air conditioning with high-wall units. Premium CP fittings and chinaware as per approved make and design."),
