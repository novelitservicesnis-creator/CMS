@model AgamEstates.Web.Models.SystemSettingsPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Settings";
}

@section Styles {
<style>
    /* Tabs Navigation */
    .settings-nav-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid rgba(221, 174, 69, 0.25);
        margin-bottom: 24px;
        overflow-x: auto;
        padding-bottom: 2px;
        scrollbar-width: thin;
    }
    .settings-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        font-family: var(--sans);
        font-size: 0.92rem;
        font-weight: 500;
        color: var(--fade);
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        text-decoration: none;
    }
    .settings-tab-btn:hover {
        color: var(--primary);
    }
    .settings-tab-btn.active {
        color: var(--primary-dark);
        border-bottom-color: var(--gold);
        font-weight: 600;
    }
    .settings-tab-btn svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
    }

    /* Tab Panes */
    .settings-tab-pane {
        display: none;
    }
    .settings-tab-pane.active {
        display: block;
        animation: fadeIn 0.25s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Form Layout & Cards */
    .settings-card {
        background: #FFFFFF;
        border: 1px solid rgba(221, 174, 69, 0.2);
        border-radius: 4px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(4, 26, 51, 0.04);
    }
    .settings-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(221, 174, 69, 0.15);
    }
    .settings-card-title {
        font-family: var(--serif);
        font-size: 1.25rem;
        color: var(--primary-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .settings-card-subtitle {
        font-size: 0.85rem;
        color: var(--fade);
        margin-top: 4px;
    }

    /* Logo Upload Area */
    .logo-upload-wrap {
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
        padding: 16px 0;
    }
    .logo-preview-box {
        width: 130px;
        height: 130px;
        border: 2px dashed rgba(221, 174, 69, 0.35);
        border-radius: 6px;
        background: #041A33;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        position: relative;
        overflow: hidden;
    }
    .logo-preview-box img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }
    .logo-upload-controls {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* Hours Table & Responsive Cards */
    .hours-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }
    .hours-row {
        background: #FDFBF7;
        border: 1px solid rgba(221, 174, 69, 0.18);
        border-radius: 4px;
        transition: all 0.2s ease;
    }
    .hours-row:hover {
        background: #F8F5EE;
    }
    .hours-row td {
        padding: 12px 16px;
        vertical-align: middle;
    }
    .hours-row.is-closed {
        opacity: 0.65;
        background: #F5F5F5;
    }
    .hours-input-label {
        display: none;
    }

    /* Switch toggle */
    .switch-toggle {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
    }
    .switch-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .switch-slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #CBD5E1;
        transition: .3s;
        border-radius: 24px;
    }
    .switch-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }
    input:checked + .switch-slider {
        background-color: #16A34A;
    }
    input:checked + .switch-slider:before {
        transform: translateX(20px);
    }

    /* Status Badges */
    .badge-active { background: rgba(22, 163, 74, 0.12); color: #15803D; border: 1px solid rgba(22, 163, 74, 0.3); }
    .badge-scheduled { background: rgba(221, 174, 69, 0.15); color: #B45309; border: 1px solid rgba(221, 174, 69, 0.4); }
    .badge-expired { background: rgba(220, 38, 38, 0.12); color: #B91C1C; border: 1px solid rgba(220, 38, 38, 0.3); }
    .badge-inactive { background: rgba(100, 116, 139, 0.12); color: #475569; border: 1px solid rgba(100, 116, 139, 0.3); }

    /* Address Grids */
    .settings-grid-address-lines {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }
    .settings-grid-address-geo {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    /* Responsive Cards (Phone & Announcement) */
    .desktop-table-view {
        display: block;
    }
    .mobile-card-view {
        display: none;
    }
    .responsive-phone-card,
    .responsive-announcement-card {
        background: #FFFFFF;
        border: 1px solid rgba(221, 174, 69, 0.22);
        border-radius: 6px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 2px 8px rgba(4, 26, 51, 0.04);
    }
    .phone-card-header,
    .rac-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }
    .phone-card-label-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .phone-label-tag {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--primary-dark);
    }
    .phone-number-link {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .phone-card-actions,
    .rac-actions {
        display: flex;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
    }
    .rac-title {
        font-size: 1rem;
        color: var(--primary-dark);
    }
    .rac-message {
        font-size: 0.90rem;
        color: var(--primary-dark);
        line-height: 1.45;
        margin-bottom: 6px;
    }
    .rac-link a {
        color: var(--gold);
        font-weight: 600;
        font-size: 0.85rem;
    }
    .rac-dates {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.80rem;
        color: var(--fade);
        margin-top: 6px;
    }
    .modal-grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 14px;
    }

    /* Business Hours Modern Schedule Editor */
    .schedule-summary-card {
        background: #FDFBF7;
        border: 1px solid rgba(221, 174, 69, 0.28);
        border-radius: 8px;
        padding: 20px 22px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(4, 26, 51, 0.03);
    }
    .schedule-summary-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        flex-wrap: wrap;
        gap: 8px;
    }
    .schedule-summary-badge {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .badge-uniform {
        background: rgba(22, 163, 74, 0.12);
        color: #15803D;
        border: 1px solid rgba(22, 163, 74, 0.3);
    }
    .badge-custom {
        background: rgba(221, 174, 69, 0.16);
        color: #B45309;
        border: 1px solid rgba(221, 174, 69, 0.4);
    }
    .schedule-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    .schedule-summary-day-box {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .summary-day-range {
        font-family: var(--serif);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--primary-dark);
        line-height: 1.2;
    }
    .summary-day-sub {
        font-size: 0.8rem;
        color: var(--fade);
        margin-top: 2px;
    }
    .schedule-summary-time-box {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .badge-status-pill {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        padding: 4px 10px;
        border-radius: 4px;
        text-transform: uppercase;
    }
    .pill-open {
        background: #15803D;
        color: #FFFFFF;
    }
    .pill-closed {
        background: #64748B;
        color: #FFFFFF;
    }
    .summary-time-range {
        font-family: var(--sans);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--primary);
    }
    .summary-time-range.closed-text {
        color: #64748B;
        font-style: italic;
    }
    .schedule-grouped-summary-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
        margin-top: 10px;
    }
    .schedule-grouped-item {
        background: #FFFFFF;
        border: 1px solid rgba(221, 174, 69, 0.22);
        border-radius: 6px;
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }
    .sgi-days {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--primary-dark);
        font-size: 0.92rem;
    }
    .sgi-time {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .common-schedule-editor-card {
        background: #FFFFFF;
        border: 1px solid rgba(221, 174, 69, 0.24);
        border-radius: 8px;
        padding: 22px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(4, 26, 51, 0.03);
    }
    .csec-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 18px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .csec-title {
        font-family: var(--serif);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--primary-dark);
        margin: 0 0 4px 0;
    }
    .csec-subtitle {
        font-size: 0.85rem;
        color: var(--fade);
        margin: 0;
    }
    .csec-badge-hint {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: rgba(221, 174, 69, 0.15);
        color: var(--primary-dark);
        padding: 3px 8px;
        border-radius: 4px;
        border: 1px solid rgba(221, 174, 69, 0.3);
    }
    .csec-form-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 16px;
        align-items: flex-start;
    }
    .readonly-days-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #FDFBF7;
        border: 1px solid rgba(221, 174, 69, 0.3);
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--primary-dark);
        min-height: 44px;
        box-sizing: border-box;
    }
    .csec-actions {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
        flex-wrap: wrap;
    }
    .individual-days-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 14px;
        border-top: 1px dashed rgba(221, 174, 69, 0.35);
    }

    /* Tablet / Small Laptop Breakpoint (769px - 1024px) */
    @@media (min-width: 769px) and (max-width: 1024px) {
        .settings-nav-tabs {
            flex-wrap: wrap;
            gap: 6px;
        }
        .settings-tab-btn {
            padding: 10px 14px;
            font-size: 0.86rem;
        }
    }

    /* Mobile Breakpoint (<= 768px) */
    @@media (max-width: 768px) {
        /* Compact Mobile Header */
        .page-head.settings-page-head {
            margin-bottom: 12px !important;
            gap: 4px !important;
        }
        .page-head.settings-page-head .page-title {
            font-size: 1.35rem !important;
            margin-bottom: 4px !important;
        }
        .page-head.settings-page-head .page-subtitle {
            font-size: 0.82rem !important;
            line-height: 1.35 !important;
            margin-bottom: 12px !important;
        }
        .settings-view-site-btn {
            display: none !important;
        }

        /* Compact Alerts */
        .settings-alert {
            padding: 10px 14px !important;
            font-size: 0.88rem !important;
            line-height: 1.4 !important;
            min-height: auto !important;
            margin: 10px 0 12px !important;
        }
        .settings-alert svg {
            width: 16px !important;
            height: 16px !important;
            flex-shrink: 0 !important;
        }

        /* Tabs 2-Column Grid */
        .settings-nav-tabs {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 6px !important;
            border-bottom: none !important;
            margin-bottom: 16px !important;
            overflow-x: visible !important;
            padding-bottom: 0 !important;
        }
        .settings-tab-btn {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            min-width: 0 !important;
            width: 100% !important;
            padding: 10px 8px !important;
            font-size: 0.82rem !important;
            white-space: normal !important;
            text-align: center !important;
            border-radius: 4px !important;
            border: 1px solid rgba(221, 174, 69, 0.25) !important;
            background: #FFFFFF !important;
            color: var(--fade) !important;
            min-height: 42px !important;
            line-height: 1.25 !important;
            box-sizing: border-box !important;
        }
        .settings-tab-btn:hover {
            border-color: var(--gold) !important;
            color: var(--primary) !important;
        }
        .settings-tab-btn.active {
            background: #041A33 !important;
            color: var(--gold-soft) !important;
            border-color: var(--gold) !important;
            font-weight: 600 !important;
        }
        .settings-tab-btn svg {
            width: 15px !important;
            height: 15px !important;
            flex-shrink: 0 !important;
        }
        .settings-tab-btn:nth-child(5) {
            grid-column: 1 / -1 !important;
        }

        .settings-card {
            padding: 18px 14px;
        }
        .settings-card-header {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }
        .settings-card-header .btn {
            width: 100%;
            min-height: 44px;
            justify-content: center;
        }
        .save-btn {
            width: 100% !important;
            min-height: 44px;
            justify-content: center;
        }
        .settings-grid-address-lines,
        .settings-grid-address-geo {
            grid-template-columns: 1fr !important;
            gap: 14px;
        }

        /* Phone & Announcement Switch to Cards */
        .desktop-table-view {
            display: none !important;
        }
        .mobile-card-view {
            display: flex !important;
            flex-direction: column;
            gap: 14px;
        }

        /* Business Hours Transform to Grid Cards */
        .hours-table {
            display: block;
            width: 100%;
            border-spacing: 0;
        }
        .hours-table thead {
            display: none;
        }
        .hours-table tbody {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
        }
        .hours-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-areas:
                "day toggle"
                "open close";
            gap: 10px 12px;
            padding: 14px;
            background: #FDFBF7;
            border: 1px solid rgba(221, 174, 69, 0.22);
            border-radius: 6px;
        }
        .hours-cell-day {
            grid-area: day;
            display: flex;
            align-items: center;
            padding: 0 !important;
        }
        .hours-cell-toggle {
            grid-area: toggle;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 !important;
        }
        .hours-cell-open {
            grid-area: open;
            padding: 0 !important;
        }
        .hours-cell-close {
            grid-area: close;
            padding: 0 !important;
        }
        .hours-toggle-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .hours-input-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--fade);
            margin-bottom: 4px;
        }
        .hours-row input[type="time"] {
            width: 100% !important;
            max-width: 100% !important;
            min-height: 44px;
        }

        /* Schedule Editor Mobile Overrides */
        .csec-form-grid {
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .schedule-summary-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }
        .csec-actions {
            flex-direction: column;
        }
        .csec-actions .btn {
            width: 100%;
            justify-content: center;
        }
        .individual-days-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .individual-days-header .btn {
            width: 100%;
            justify-content: center;
        }

        /* Modals on Mobile */
        .modal-card {
            width: 94vw !important;
            max-width: 94vw !important;
            margin: 20px auto !important;
            padding: 20px 16px !important;
        }
        .modal-grid-2col {
            grid-template-columns: 1fr !important;
            gap: 12px;
        }
        .modal-footer {
            flex-direction: column;
            gap: 10px;
        }
        .modal-footer .btn {
            width: 100%;
            min-height: 44px;
            justify-content: center;
        }
    }

    @@media (max-width: 480px) {
        .csec-form-grid {
            grid-template-columns: 1fr;
        }
        .schedule-grouped-item {
            flex-direction: column;
            align-items: flex-start;
        }
        .hours-row {
            grid-template-columns: 1fr;
            grid-template-areas:
                "day"
                "toggle"
                "open"
                "close";
        }
        .hours-cell-toggle {
            justify-content: flex-start;
        }
        .phone-card-actions,
        .rac-actions {
            flex-direction: column;
        }
        .phone-card-actions .btn,
        .rac-actions .btn {
            width: 100%;
        }
    }

    @@media (max-width: 360px) {
        .settings-nav-tabs {
            grid-template-columns: 1fr !important;
        }
        .settings-tab-btn:nth-child(5) {
            grid-column: auto !important;
        }
        .settings-tab-btn {
            font-size: 0.80rem !important;
            padding: 9px 8px !important;
        }
    }
</style>
}

<!-- Page Header -->
<div class="page-head settings-page-head">
    <div>
        <h1 class="page-title">System Settings</h1>
        <p class="page-subtitle">Manage website identity, contact information, business hours and public announcements.</p>
    </div>
    <div>
        <a href="/" target="_blank" class="btn btn-outline settings-view-site-btn" style="background: #FFFFFF;">
            <span>View Website</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
        </a>
    </div>
</div>

<!-- Flash Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success settings-alert" style="background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; padding: 10px 14px; border-radius: 4px; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; font-size: 0.88rem; line-height: 1.4;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger settings-alert" style="background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; padding: 10px 14px; border-radius: 4px; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; font-size: 0.88rem; line-height: 1.4;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Settings Navigation Tabs -->
<div class="settings-nav-tabs" role="tablist">
    <button type="button" class="settings-tab-btn @(Model.ActiveTab == "general" ? "active" : "")" onclick="switchSettingsTab('general', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        <span>General Identity</span>
    </button>
    <button type="button" class="settings-tab-btn @(Model.ActiveTab == "contact" ? "active" : "")" onclick="switchSettingsTab('contact', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>Contact Information</span>
    </button>
    <button type="button" class="settings-tab-btn @(Model.ActiveTab == "hours" ? "active" : "")" onclick="switchSettingsTab('hours', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>Business Hours</span>
    </button>
    <button type="button" class="settings-tab-btn @(Model.ActiveTab == "announcements" ? "active" : "")" onclick="switchSettingsTab('announcements', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        <span>Announcements</span>
    </button>
    <button type="button" class="settings-tab-btn @(Model.ActiveTab == "social" ? "active" : "")" onclick="switchSettingsTab('social', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        <span>Social Media</span>
    </button>
</div>

<!-- ==========================================
     TAB 1: GENERAL IDENTITY
========================================== -->
<div id="tab-pane-general" class="settings-tab-pane @(Model.ActiveTab == "general" ? "active" : "")">
    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h2 class="settings-card-title">Website Identity</h2>
                <p class="settings-card-subtitle">Configure the public brand logo and official company name.</p>
            </div>
        </div>

        <form method="post" action="/Admin/SystemSettings/UpdateGeneral" enctype="multipart/form-data" onsubmit="handleFormSubmit(this)">
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 24px;">
                <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 8px;">Website Logo</label>
                <div class="logo-upload-wrap">
                    <div class="logo-preview-box">
                        <img id="logo-preview-img" src="@(string.IsNullOrWhiteSpace(Model.Settings.LogoPath) ? "/images/logo.png" : Model.Settings.LogoPath)" alt="Logo Preview" />
                    </div>
                    <div class="logo-upload-controls">
                        <label for="logo-file-input" class="btn btn-outline" style="cursor: pointer; display: inline-flex; width: fit-content;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            <span>Change Logo</span>
                        </label>
                        <input type="file" id="logo-file-input" name="LogoFile" accept=".png,.jpg,.jpeg,.webp" style="display: none;" onchange="previewLogoFile(this)" />
                        <span style="font-size: 0.8rem; color: var(--fade);">Recommended format: PNG, WEBP, or JPG. Max size: 5 MB.</span>
                        <span id="selected-file-name" style="font-size: 0.85rem; color: var(--primary); font-weight: 500;"></span>
                    </div>
                </div>
            </div>

            <div style="max-width: 520px; margin-bottom: 28px;">
                <label for="company-name-input" class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 8px;">Company / Project Name *</label>
                <input type="text" id="company-name-input" name="CompanyName" class="form-control" value="@Model.Settings.CompanyName" required maxlength="150" placeholder="e.g. Agam Estates" />
            </div>

            <div>
                <button type="submit" class="btn btn-gold save-btn">
                    <span>Save Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================
     TAB 2: CONTACT INFORMATION
========================================== -->
<div id="tab-pane-contact" class="settings-tab-pane @(Model.ActiveTab == "contact" ? "active" : "")">
    <!-- Physical Address & Email -->
    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h2 class="settings-card-title">Address &amp; Public Email</h2>
                <p class="settings-card-subtitle">Displayed across the public contact section, header, and footer.</p>
            </div>
        </div>

        <form method="post" action="/Admin/SystemSettings/UpdateContactInfo" onsubmit="handleFormSubmit(this)">
            @Html.AntiForgeryToken()

            <div class="settings-grid-address-lines">
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Address Line 1</label>
                    <input type="text" name="AddressLine1" class="form-control" value="@Model.Settings.AddressLine1" placeholder="e.g. Sector 20, Panchkula Extension" maxlength="250" />
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Address Line 2 (Landmark / Campus)</label>
                    <input type="text" name="AddressLine2" class="form-control" value="@Model.Settings.AddressLine2" placeholder="e.g. Tdi South Extension II" maxlength="250" />
                </div>
            </div>

            <div class="settings-grid-address-geo">
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">City</label>
                    <input type="text" name="City" class="form-control" value="@Model.Settings.City" placeholder="Panchkula" maxlength="100" />
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">State</label>
                    <input type="text" name="State" class="form-control" value="@Model.Settings.State" placeholder="Haryana" maxlength="100" />
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Postal Code</label>
                    <input type="text" name="PostalCode" class="form-control" value="@Model.Settings.PostalCode" placeholder="134116" maxlength="20" />
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Country</label>
                    <input type="text" name="Country" class="form-control" value="@Model.Settings.Country" placeholder="India" maxlength="100" />
                </div>
            </div>

            <div style="max-width: 440px; margin-bottom: 28px;">
                <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Public Email Address</label>
                <input type="email" name="Email" class="form-control" value="@Model.Settings.Email" placeholder="sales@agamestates.in" maxlength="200" />
                <span style="font-size: 0.78rem; color: var(--fade); margin-top: 4px; display: block;">Used for mailto: links in contact sections and footer.</span>
            </div>

            <button type="submit" class="btn btn-gold save-btn">Save Contact Details</button>
        </form>
    </div>

    <!-- Phone Numbers List -->
    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h2 class="settings-card-title">Phone Numbers</h2>
                <p class="settings-card-subtitle">Manage multiple contact numbers. The Primary number appears in the topbar.</p>
            </div>
            <div>
                <button type="button" class="btn btn-outline" style="background: #FFFFFF;" onclick="openAddPhoneModal()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>+ Add Phone Number</span>
                </button>
            </div>
        </div>

        @if (Model.Settings.ContactNumbers == null || Model.Settings.ContactNumbers.Count == 0)
        {
            <div style="text-align: center; padding: 36px 20px; color: var(--fade);">
                <p>No phone numbers configured yet.</p>
                <button type="button" class="btn btn-gold" onclick="openAddPhoneModal()" style="margin-top: 10px;">+ Add Primary Number</button>
            </div>
        }
        else
        {
            <!-- Desktop Table View (> 768px) -->
            <div class="table-responsive desktop-table-view">
                <table class="table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(221, 174, 69, 0.2); text-align: left; font-size: 0.78rem; text-transform: uppercase; color: var(--fade); letter-spacing: 0.08em;">
                            <th style="padding: 12px 14px;">Label</th>
                            <th style="padding: 12px 14px;">Phone Number</th>
                            <th style="padding: 12px 14px; text-align: center;">Primary</th>
                            <th style="padding: 12px 14px; text-align: center;">Status</th>
                            <th style="padding: 12px 14px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phone in Model.Settings.ContactNumbers)
                        {
                            <tr style="border-bottom: 1px solid rgba(0,0,0,0.05); font-size: 0.92rem;">
                                <td style="padding: 14px; font-weight: 500; color: var(--primary-dark);">
                                    @(string.IsNullOrWhiteSpace(phone.Label) ? "General" : phone.Label)
                                </td>
                                <td style="padding: 14px;">
                                    <a href="tel:@phone.PhoneNumber" style="color: var(--primary); font-weight: 500;">@phone.PhoneNumber</a>
                                </td>
                                <td style="padding: 14px; text-align: center;">
                                    @if (phone.IsPrimary)
                                    {
                                        <span class="badge badge-active" style="display: inline-block;">Primary</span>
                                    }
                                    else
                                    {
                                        <form method="post" action="/Admin/SystemSettings/SetPrimaryPhoneNumber" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@phone.ContactNumberId" />
                                            <button type="submit" class="btn-link" style="color: var(--fade); font-size: 0.8rem; cursor: pointer; text-decoration: underline;" title="Make Primary">Set Primary</button>
                                        </form>
                                    }
                                </td>
                                <td style="padding: 14px; text-align: center;">
                                    <form method="post" action="/Admin/SystemSettings/TogglePhoneNumberStatus" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@phone.ContactNumberId" />
                                        <button type="submit" class="badge @(phone.IsActive ? "badge-active" : "badge-inactive")" style="cursor: pointer; border: none;" title="Click to toggle status">
                                            @(phone.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td style="padding: 14px; text-align: right;">
                                    <button type="button" class="btn btn-sm btn-outline" style="padding: 4px 10px; font-size: 0.8rem; margin-right: 6px;" 
                                            onclick="openEditPhoneModal(@phone.ContactNumberId, '@(phone.Label ?? "")', '@phone.PhoneNumber', @phone.IsPrimary.ToString().ToLower(), @phone.IsActive.ToString().ToLower(), @phone.SortOrder)">
                                        Edit
                                    </button>
                                    <form method="post" action="/Admin/SystemSettings/DeletePhoneNumber" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this phone number?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@phone.ContactNumberId" />
                                        <button type="submit" class="btn btn-sm btn-outline" style="padding: 4px 10px; font-size: 0.8rem; color: #DC2626; border-color: rgba(220,38,38,0.3);">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View (<= 768px) -->
            <div class="mobile-card-view phone-mobile-cards">
                @foreach (var phone in Model.Settings.ContactNumbers)
                {
                    <div class="responsive-phone-card">
                        <div class="phone-card-header">
                            <div class="phone-card-label-wrap">
                                <span class="phone-label-tag">@(string.IsNullOrWhiteSpace(phone.Label) ? "General" : phone.Label)</span>
                                @if (phone.IsPrimary)
                                {
                                    <span class="badge badge-active">Primary</span>
                                }
                            </div>
                            <div>
                                <form method="post" action="/Admin/SystemSettings/TogglePhoneNumberStatus" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@phone.ContactNumberId" />
                                    <button type="submit" class="badge @(phone.IsActive ? "badge-active" : "badge-inactive")" style="cursor: pointer; border: none; padding: 4px 10px;" title="Click to toggle status">
                                        @(phone.IsActive ? "Active" : "Inactive")
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="phone-card-body">
                            <a href="tel:@phone.PhoneNumber" class="phone-number-link">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                <span>@phone.PhoneNumber</span>
                            </a>
                            @if (!phone.IsPrimary)
                            {
                                <div style="margin-top: 8px;">
                                    <form method="post" action="/Admin/SystemSettings/SetPrimaryPhoneNumber" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@phone.ContactNumberId" />
                                        <button type="submit" class="btn-link" style="color: var(--primary); font-size: 0.85rem; cursor: pointer; text-decoration: underline; font-weight: 500;">Set as Primary Number</button>
                                    </form>
                                </div>
                            }
                        </div>

                        <div class="phone-card-actions">
                            <button type="button" class="btn btn-outline" style="flex: 1; min-height: 42px; justify-content: center; font-size: 0.85rem;" 
                                    onclick="openEditPhoneModal(@phone.ContactNumberId, '@(phone.Label ?? "")', '@phone.PhoneNumber', @phone.IsPrimary.ToString().ToLower(), @phone.IsActive.ToString().ToLower(), @phone.SortOrder)">
                                Edit
                            </button>
                            <form method="post" action="/Admin/SystemSettings/DeletePhoneNumber" style="flex: 1; display: flex;" onsubmit="return confirm('Are you sure you want to delete this phone number?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@phone.ContactNumberId" />
                                <button type="submit" class="btn btn-outline" style="width: 100%; min-height: 42px; justify-content: center; font-size: 0.85rem; color: #DC2626; border-color: rgba(220,38,38,0.3);">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ==========================================
     TAB 3: BUSINESS HOURS
========================================== -->
@{
    var hoursList = Model.Settings.BusinessHours ?? new List<AgamEstates.Repository.ViewModel.SystemBusinessHourDto>();
    bool allSevenIdentical = false;
    string commonOpen = "09:00";
    string commonClose = "19:00";
    string commonOpenDisplay = "9:00 AM";
    string commonCloseDisplay = "7:00 PM";
    bool commonIsOpen = true;

    if (hoursList.Count == 7)
    {
        var first = hoursList[0];
        allSevenIdentical = hoursList.All(h => 
            h.IsOpen == first.IsOpen && 
            h.OpenTime == first.OpenTime && 
            h.CloseTime == first.CloseTime
        );
        commonIsOpen = first.IsOpen;
        commonOpen = first.OpenTime.HasValue ? DateTime.Today.Add(first.OpenTime.Value).ToString("HH:mm") : "09:00";
        commonClose = first.CloseTime.HasValue ? DateTime.Today.Add(first.CloseTime.Value).ToString("HH:mm") : "19:00";
        commonOpenDisplay = !string.IsNullOrWhiteSpace(first.OpenTimeString) ? first.OpenTimeString : (first.OpenTime.HasValue ? DateTime.Today.Add(first.OpenTime.Value).ToString("h:mm tt") : "9:00 AM");
        commonCloseDisplay = !string.IsNullOrWhiteSpace(first.CloseTimeString) ? first.CloseTimeString : (first.CloseTime.HasValue ? DateTime.Today.Add(first.CloseTime.Value).ToString("h:mm tt") : "7:00 PM");
    }
    else if (hoursList.Count > 0)
    {
        var first = hoursList[0];
        commonIsOpen = first.IsOpen;
        commonOpen = first.OpenTime.HasValue ? DateTime.Today.Add(first.OpenTime.Value).ToString("HH:mm") : "09:00";
        commonClose = first.CloseTime.HasValue ? DateTime.Today.Add(first.CloseTime.Value).ToString("HH:mm") : "19:00";
        commonOpenDisplay = !string.IsNullOrWhiteSpace(first.OpenTimeString) ? first.OpenTimeString : (first.OpenTime.HasValue ? DateTime.Today.Add(first.OpenTime.Value).ToString("h:mm tt") : "9:00 AM");
        commonCloseDisplay = !string.IsNullOrWhiteSpace(first.CloseTimeString) ? first.CloseTimeString : (first.CloseTime.HasValue ? DateTime.Today.Add(first.CloseTime.Value).ToString("h:mm tt") : "7:00 PM");
    }
}
<div id="tab-pane-hours" class="settings-tab-pane @(Model.ActiveTab == "hours" ? "active" : "")">
    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h2 class="settings-card-title">Business &amp; Site Visit Hours</h2>
                <p class="settings-card-subtitle">Configure Monday–Sunday availability for office visits and customer consultation.</p>
            </div>
        </div>

        <!-- 1. EXECUTIVE SUMMARY CARD -->
        <div class="schedule-summary-card">
            <div class="schedule-summary-header">
                <span class="schedule-summary-badge @(allSevenIdentical ? "badge-uniform" : "badge-custom")">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>@(allSevenIdentical ? "Uniform 7-Day Schedule" : "Custom Grouped Schedule")</span>
                </span>
                <span style="font-size: 0.8rem; color: var(--fade);">Live public site visit hours</span>
            </div>

            @if (allSevenIdentical)
            {
                <div class="schedule-summary-row">
                    <div class="schedule-summary-day-box">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#DDAE45" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <div>
                            <div class="summary-day-range">Monday – Sunday</div>
                            <div class="summary-day-sub">Applied across all seven days</div>
                        </div>
                    </div>
                    <div class="schedule-summary-time-box">
                        @if (commonIsOpen)
                        {
                            <span class="badge-status-pill pill-open">OPEN</span>
                            <span class="summary-time-range">@commonOpenDisplay – @commonCloseDisplay</span>
                        }
                        else
                        {
                            <span class="badge-status-pill pill-closed">CLOSED</span>
                            <span class="summary-time-range closed-text">Closed All Week</span>
                        }
                    </div>
                    <div class="schedule-summary-actions">
                        <button type="button" class="btn btn-outline btn-customize-toggle" id="btn-toggle-days" onclick="toggleIndividualDays()">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            <span id="btn-toggle-days-text">Customize Individual Days</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="schedule-grouped-summary-list">
                    @if (Model.GroupedBusinessHours != null && Model.GroupedBusinessHours.Any())
                    {
                        @foreach (var g in Model.GroupedBusinessHours)
                        {
                            <div class="schedule-grouped-item">
                                <div class="sgi-days">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DDAE45" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <strong>@g.Days</strong>
                                </div>
                                <div class="sgi-time">
                                    @if (g.IsClosed)
                                    {
                                        <span class="badge-status-pill pill-closed">CLOSED</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-pill pill-open">OPEN</span>
                                        <span class="summary-time-range">@g.Hours</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="schedule-summary-actions" style="margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button" class="btn btn-outline btn-customize-toggle" id="btn-toggle-days" onclick="toggleIndividualDays()">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                        <span id="btn-toggle-days-text">Hide Individual Days</span>
                    </button>
                </div>
            }
        </div>

        <!-- 2. SINGLE SCHEDULE EDITOR CARD -->
        <div class="common-schedule-editor-card">
            <div class="csec-header">
                <div>
                    <h3 class="csec-title">Schedule Editor</h3>
                    <p class="csec-subtitle">Enter hours once and apply across Monday – Sunday simultaneously without repetitive entries.</p>
                </div>
                <div class="csec-badge-hint">
                    <span>Fast Setup</span>
                </div>
            </div>

            <div class="csec-form-grid">
                <div class="form-group">
                    <label class="form-label">Days</label>
                    <div class="readonly-days-pill">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#DDAE45" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>Monday – Sunday</span>
                    </div>
                    @* <span class="form-hint">Applies to the entire 7-day schedule</span> *@
                </div>

                <div class="form-group">
                    <label class="form-label" for="common-status">Status</label>
                    <select id="common-status" class="form-control" onchange="onCommonStatusChange(this.value)">
                        <option value="open" selected="@(commonIsOpen ? "selected" : null)">Open</option>
                        <option value="closed" selected="@(!commonIsOpen ? "selected" : null)">Closed</option>
                    </select>
                    @* <span class="form-hint">Office open / closed status</span> *@
                </div>

                <div class="form-group" id="common-open-wrap" style="@(commonIsOpen ? "" : "opacity: 0.5;")">
                    <label class="form-label" for="common-open-time">Open Time</label>
                    <input type="time" id="common-open-time" class="form-control" value="@commonOpen" @(commonIsOpen ? "" : "disabled") />
                    @* <span class="form-hint">Opening time (e.g. 09:00 AM)</span> *@
                </div>

                <div class="form-group" id="common-close-wrap" style="@(commonIsOpen ? "" : "opacity: 0.5;")">
                    <label class="form-label" for="common-close-time">Close Time</label>
                    <input type="time" id="common-close-time" class="form-control" value="@commonClose" @(commonIsOpen ? "" : "disabled") />
                    @* <span class="form-hint">Closing time (e.g. 07:00 PM)</span> *@
                </div>
            </div>

            <div class="csec-actions">
                <button type="button" class="btn btn-gold" onclick="applyCommonToAllAndSave()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                    <span>Save Monday – Sunday Schedule</span>
                </button>
                @* <button type="button" class="btn btn-outline" onclick="applyCommonToAllDays(false)">
                    <span>Apply to Table Below</span>
                </button> *@
            </div>
        </div>

        <!-- 3. COLLAPSIBLE INDIVIDUAL DAYS SECTION -->
        <div id="individual-days-container" style="display: @(allSevenIdentical ? "none" : "block"); margin-top: 24px;">
            <div class="individual-days-header">
                <div>
                    <h3 style="font-size: 1.1rem; color: var(--primary-dark); margin: 0 0 4px 0; font-family: var(--serif);">Individual Day Customization</h3>
                    <p style="font-size: 0.85rem; color: var(--fade); margin: 0;">Override specific days (e.g. Saturday hours or Sunday Closed).</p>
                </div>
                <div class="idh-actions" style="display: flex; gap: 8px;">
                    <button type="button" class="btn btn-outline" style="background: #FFFFFF;" onclick="applyMondayToAll()">
                        <span>Apply Monday to All Days</span>
                    </button>
                </div>
            </div>

            <form id="business-hours-form" method="post" action="/Admin/SystemSettings/UpdateBusinessHours" onsubmit="return prepareBusinessHoursSubmit(this, event)">
                @Html.AntiForgeryToken()

                <div class="table-responsive" style="margin-bottom: 24px;">
                    <table class="hours-table">
                        <thead>
                            <tr style="text-align: left; font-size: 0.78rem; text-transform: uppercase; color: var(--fade); letter-spacing: 0.08em;">
                                <th style="padding: 10px 16px; width: 140px;">Day</th>
                                <th style="padding: 10px 16px; width: 110px; text-align: center;">Status</th>
                                <th style="padding: 10px 16px;">Open Time</th>
                                <th style="padding: 10px 16px;">Close Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Settings.BusinessHours.Count; i++)
                            {
                                var h = Model.Settings.BusinessHours[i];
                                var openVal = h.OpenTime.HasValue ? DateTime.Today.Add(h.OpenTime.Value).ToString("HH:mm") : "09:00";
                                var closeVal = h.CloseTime.HasValue ? DateTime.Today.Add(h.CloseTime.Value).ToString("HH:mm") : "19:00";

                                <tr class="hours-row @(h.IsOpen ? "" : "is-closed")" id="hours-row-@h.DayOfWeek">
                                    <td class="hours-cell-day">
                                        <input type="hidden" name="Hours[@i].DayOfWeek" value="@h.DayOfWeek" />
                                        <strong style="color: var(--primary-dark); font-size: 0.95rem;">@h.DayName</strong>
                                    </td>
                                    <td class="hours-cell-toggle" style="text-align: center;">
                                        <div class="hours-toggle-wrap">
                                            <label class="switch-toggle" title="Toggle open/closed">
                                                <input type="checkbox" id="hours-isopen-@h.DayOfWeek" name="Hours[@i].IsOpen" value="true" @(h.IsOpen ? "checked" : "") onchange="toggleDayRow(@h.DayOfWeek, this.checked)" />
                                                <span class="switch-slider"></span>
                                            </label>
                                            <div style="font-size: 0.74rem; font-weight: 600; margin-top: 3px; color: @(h.IsOpen ? "#15803D" : "#64748B");" id="hours-status-text-@h.DayOfWeek">
                                                @(h.IsOpen ? "OPEN" : "CLOSED")
                                            </div>
                                        </div>
                                    </td>
                                    <td class="hours-cell-open">
                                        <label class="hours-input-label">Open Time</label>
                                        <input type="time" id="hours-opentime-@h.DayOfWeek" name="Hours[@i].OpenTime" class="form-control" value="@openVal" style="max-width: 170px;" @(h.IsOpen ? "" : "disabled") />
                                    </td>
                                    <td class="hours-cell-close">
                                        <label class="hours-input-label">Close Time</label>
                                        <input type="time" id="hours-closetime-@h.DayOfWeek" name="Hours[@i].CloseTime" class="form-control" value="@closeVal" style="max-width: 170px;" @(h.IsOpen ? "" : "disabled") />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                    <button type="submit" class="btn btn-gold save-btn">Save Business Hours</button>
                    <button type="button" class="btn btn-outline" onclick="toggleIndividualDays()">Collapse Individual Days</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==========================================
     TAB 4: ANNOUNCEMENTS
========================================== -->
<div id="tab-pane-announcements" class="settings-tab-pane @(Model.ActiveTab == "announcements" ? "active" : "")">
    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h2 class="settings-card-title">Public Announcements</h2>
                <p class="settings-card-subtitle">Only ONE announcement may be active at any given time. Appears as a luxury marquee strip in the public header.</p>
            </div>
            <div>
                <button type="button" class="btn btn-gold" onclick="openNewAnnouncementModal()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>+ New Announcement</span>
                </button>
            </div>
        </div>

        @if (Model.Announcements == null || Model.Announcements.Count == 0)
        {
            <div style="text-align: center; padding: 40px 20px; color: var(--fade);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; color: var(--gold);"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                <p>No announcements created yet. The public announcement marquee is currently hidden.</p>
                <button type="button" class="btn btn-gold" onclick="openNewAnnouncementModal()" style="margin-top: 12px;">Create First Announcement</button>
            </div>
        }
        else
        {
            <!-- Desktop Table View (> 768px) -->
            <div class="table-responsive desktop-table-view">
                <table class="table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(221, 174, 69, 0.2); text-align: left; font-size: 0.78rem; text-transform: uppercase; color: var(--fade); letter-spacing: 0.08em;">
                            <th style="padding: 12px 14px;">Title</th>
                            <th style="padding: 12px 14px;">Message</th>
                            <th style="padding: 12px 14px;">Dates</th>
                            <th style="padding: 12px 14px; text-align: center;">Status</th>
                            <th style="padding: 12px 14px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Announcements)
                        {
                            var badgeClass = a.StatusBadge switch
                            {
                                "ACTIVE" => "badge-active",
                                "SCHEDULED" => "badge-scheduled",
                                "EXPIRED" => "badge-expired",
                                _ => "badge-inactive"
                            };

                            <tr style="border-bottom: 1px solid rgba(0,0,0,0.05); font-size: 0.92rem;">
                                <td style="padding: 14px; font-weight: 600; color: var(--primary-dark); white-space: nowrap;">
                                    @(string.IsNullOrWhiteSpace(a.Title) ? "Notice" : a.Title)
                                </td>
                                <td style="padding: 14px; max-width: 380px;">
                                    <div style="color: var(--primary-dark); line-height: 1.45;">@a.Message</div>
                                    @if (!string.IsNullOrWhiteSpace(a.LinkText))
                                    {
                                        <div style="font-size: 0.8rem; margin-top: 4px;">
                                            <a href="@a.LinkUrl" target="_blank" style="color: var(--gold); font-weight: 500;">
                                                @a.LinkText &rarr;
                                            </a>
                                        </div>
                                    }
                                </td>
                                <td style="padding: 14px; font-size: 0.82rem; color: var(--fade); white-space: nowrap;">
                                    @if (a.StartDate.HasValue || a.EndDate.HasValue)
                                    {
                                        <div>@(a.StartDate.HasValue ? a.StartDate.Value.ToString("dd MMM yyyy") : "Anytime")</div>
                                        <div>to @(a.EndDate.HasValue ? a.EndDate.Value.ToString("dd MMM yyyy") : "Ongoing")</div>
                                    }
                                    else
                                    {
                                        <span>Always visible when active</span>
                                    }
                                </td>
                                <td style="padding: 14px; text-align: center; white-space: nowrap;">
                                    <span class="badge @badgeClass" style="display: inline-block;">@a.StatusBadge</span>
                                </td>
                                <td style="padding: 14px; text-align: right; white-space: nowrap;">
                                    @if (a.IsActive)
                                    {
                                        <form method="post" action="/Admin/SystemSettings/DeactivateAnnouncement" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.AnnouncementId" />
                                            <button type="submit" class="btn btn-sm btn-outline" style="padding: 4px 10px; font-size: 0.8rem; margin-right: 6px;" title="Deactivate">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-gold" style="padding: 4px 10px; font-size: 0.8rem; margin-right: 6px;" 
                                                onclick="confirmActivateAnnouncement(@a.AnnouncementId, '@(a.Title ?? "Notice")')">
                                            Activate
                                        </button>
                                    }

                                    <button type="button" class="btn btn-sm btn-outline" style="padding: 4px 10px; font-size: 0.8rem; margin-right: 6px;" 
                                            onclick="openEditAnnouncementModal(@a.AnnouncementId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.Title ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.Message ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.LinkText ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.LinkUrl ?? ""))', '@(a.StartDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")', '@(a.EndDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @a.IsActive.ToString().ToLower())">
                                        Edit
                                    </button>

                                    <form method="post" action="/Admin/SystemSettings/DeleteAnnouncement" style="display: inline;" onsubmit="return confirm('Are you sure you want to permanently delete this announcement?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.AnnouncementId" />
                                        <button type="submit" class="btn btn-sm btn-outline" style="padding: 4px 10px; font-size: 0.8rem; color: #DC2626; border-color: rgba(220,38,38,0.3);">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View (<= 768px) -->
            <div class="mobile-card-view announcement-mobile-cards">
                @foreach (var a in Model.Announcements)
                {
                    var badgeClass = a.StatusBadge switch
                    {
                        "ACTIVE" => "badge-active",
                        "SCHEDULED" => "badge-scheduled",
                        "EXPIRED" => "badge-expired",
                        _ => "badge-inactive"
                    };

                    <div class="responsive-announcement-card">
                        <div class="rac-header">
                            <div class="rac-title-wrap">
                                <strong class="rac-title">@(string.IsNullOrWhiteSpace(a.Title) ? "Notice" : a.Title)</strong>
                            </div>
                            <div>
                                <span class="badge @badgeClass">@a.StatusBadge</span>
                            </div>
                        </div>

                        <div class="rac-body">
                            <div class="rac-message">@a.Message</div>
                            @if (!string.IsNullOrWhiteSpace(a.LinkText))
                            {
                                <div class="rac-link">
                                    <a href="@a.LinkUrl" target="_blank">@a.LinkText &rarr;</a>
                                </div>
                            }
                            <div class="rac-dates">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                <span>
                                    @if (a.StartDate.HasValue || a.EndDate.HasValue)
                                    {
                                        @(a.StartDate.HasValue ? a.StartDate.Value.ToString("dd MMM yyyy") : "Anytime")
                                        <span> to </span>
                                        @(a.EndDate.HasValue ? a.EndDate.Value.ToString("dd MMM yyyy") : "Ongoing")
                                    }
                                    else
                                    {
                                        <span>Always visible when active</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="rac-actions">
                            @if (a.IsActive)
                            {
                                <form method="post" action="/Admin/SystemSettings/DeactivateAnnouncement" style="flex: 1; display: flex;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.AnnouncementId" />
                                    <button type="submit" class="btn btn-outline" style="width: 100%; min-height: 42px; justify-content: center; font-size: 0.85rem;" title="Deactivate">
                                        Deactivate
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-gold" style="flex: 1; min-height: 42px; justify-content: center; font-size: 0.85rem;" 
                                        onclick="confirmActivateAnnouncement(@a.AnnouncementId, '@(a.Title ?? "Notice")')">
                                    Activate
                                </button>
                            }

                            <button type="button" class="btn btn-outline" style="flex: 1; min-height: 42px; justify-content: center; font-size: 0.85rem;" 
                                    onclick="openEditAnnouncementModal(@a.AnnouncementId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.Title ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.Message ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.LinkText ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(a.LinkUrl ?? ""))', '@(a.StartDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")', '@(a.EndDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")', @a.IsActive.ToString().ToLower())">
                                Edit
                            </button>

                            <form method="post" action="/Admin/SystemSettings/DeleteAnnouncement" style="flex: 1; display: flex;" onsubmit="return confirm('Are you sure you want to permanently delete this announcement?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.AnnouncementId" />
                                <button type="submit" class="btn btn-outline" style="width: 100%; min-height: 42px; justify-content: center; font-size: 0.85rem; color: #DC2626; border-color: rgba(220,38,38,0.3);">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ==========================================
     TAB 5: SOCIAL LINKS
========================================== -->
<div id="tab-pane-social" class="settings-tab-pane @(Model.ActiveTab == "social" ? "active" : "")">
    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h2 class="settings-card-title">Social Media Links</h2>
                <p class="settings-card-subtitle">Social icons on the public website are automatically hidden if the URL is left empty.</p>
            </div>
        </div>

        <form method="post" action="/Admin/SystemSettings/UpdateSocialLinks" onsubmit="handleFormSubmit(this)">
            @Html.AntiForgeryToken()

            <div style="max-width: 580px; display: flex; flex-direction: column; gap: 18px; margin-bottom: 28px;">
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Instagram Profile URL</label>
                    <input type="url" name="InstagramUrl" class="form-control" value="@Model.Settings.InstagramUrl" placeholder="https://instagram.com/agamestates" maxlength="500" />
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">Facebook Page URL</label>
                    <input type="url" name="FacebookUrl" class="form-control" value="@Model.Settings.FacebookUrl" placeholder="https://facebook.com/agamestates" maxlength="500" />
                </div>
                <div>
                    <label class="form-label" style="font-weight: 600; color: var(--primary-dark); display: block; margin-bottom: 6px;">YouTube Channel URL</label>
                    <input type="url" name="YouTubeUrl" class="form-control" value="@Model.Settings.YouTubeUrl" placeholder="https://youtube.com/agamestates" maxlength="500" />
                </div>
            </div>

            <button type="submit" class="btn btn-gold save-btn">Save Social Links</button>
        </form>
    </div>
</div>

<!-- ==========================================
     MODALS
========================================== -->

<!-- Phone Modal (Add / Edit) -->
<div id="phone-modal" class="modal-backdrop">
    <div class="modal-card" style="max-width: 440px;">
        <div class="modal-header">
            <h3 class="modal-title" id="phone-modal-title">Add Phone Number</h3>
            <button type="button" class="modal-close" onclick="closeModal('phone-modal')">&times;</button>
        </div>
        <form id="phone-form" method="post" action="/Admin/SystemSettings/AddPhoneNumber">
            @Html.AntiForgeryToken()
            <input type="hidden" id="phone-id" name="ContactNumberId" value="" />
            <div class="modal-body">
                <div style="margin-bottom: 14px;">
                    <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Label</label>
                    <input type="text" id="phone-label" name="Label" class="form-control" placeholder="e.g. Sales, Site Office, Support" maxlength="80" />
                </div>
                <div style="margin-bottom: 14px;">
                    <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Phone Number *</label>
                    <input type="text" id="phone-number" name="PhoneNumber" class="form-control" placeholder="+91 98765 43210" required maxlength="30" />
                </div>
                <div style="margin-bottom: 14px;">
                    <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Display Order</label>
                    <input type="number" id="phone-sort" name="SortOrder" class="form-control" value="0" />
                </div>
                <div style="display: flex; gap: 20px; margin-top: 10px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.9rem;">
                        <input type="checkbox" id="phone-primary" name="IsPrimary" value="true" />
                        <span>Set as Primary</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.9rem;">
                        <input type="checkbox" id="phone-active" name="IsActive" value="true" checked />
                        <span>Active</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('phone-modal')">Cancel</button>
                <button type="submit" class="btn btn-gold" id="phone-submit-btn">Save Number</button>
            </div>
        </form>
    </div>
</div>

<!-- Announcement Modal (Create / Edit) -->
<div id="announcement-modal" class="modal-backdrop">
    <div class="modal-card" style="max-width: 540px;">
        <div class="modal-header">
            <h3 class="modal-title" id="announcement-modal-title">New Announcement</h3>
            <button type="button" class="modal-close" onclick="closeModal('announcement-modal')">&times;</button>
        </div>
        <form id="announcement-form" method="post" action="/Admin/SystemSettings/SaveAnnouncement">
            @Html.AntiForgeryToken()
            <input type="hidden" id="announcement-id" name="AnnouncementId" value="" />
            <div class="modal-body">
                <div style="margin-bottom: 14px;">
                    <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Title</label>
                    <input type="text" id="announcement-title" name="Title" class="form-control" placeholder="e.g. Site Visit Update" maxlength="150" />
                </div>
                <div style="margin-bottom: 14px;">
                    <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Announcement Message *</label>
                    <textarea id="announcement-message" name="Message" class="form-control" rows="3" placeholder="Enter message text..." required maxlength="500"></textarea>
                </div>
                <div class="modal-grid-2col">
                    <div>
                        <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Link Text (Optional)</label>
                        <input type="text" id="announcement-linktext" name="LinkText" class="form-control" placeholder="e.g. Request a Visit" maxlength="100" />
                    </div>
                    <div>
                        <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Link URL (Optional)</label>
                        <input type="text" id="announcement-linkurl" name="LinkUrl" class="form-control" placeholder="e.g. /#contact" maxlength="500" />
                    </div>
                </div>
                <div class="modal-grid-2col">
                    <div>
                        <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">Start Date (Optional)</label>
                        <input type="datetime-local" id="announcement-startdate" name="StartDate" class="form-control" />
                    </div>
                    <div>
                        <label class="form-label" style="font-weight: 600; margin-bottom: 6px; display: block;">End Date (Optional)</label>
                        <input type="datetime-local" id="announcement-enddate" name="EndDate" class="form-control" />
                    </div>
                </div>
                <div style="margin-top: 10px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.92rem;">
                        <input type="checkbox" id="announcement-active" name="IsActive" value="true" />
                        <span>Make Active (Will replace any currently active announcement)</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('announcement-modal')">Cancel</button>
                <button type="submit" class="btn btn-gold">Save Announcement</button>
            </div>
        </form>
    </div>
</div>

<!-- Activation Confirmation Modal -->
<div id="activate-confirm-modal" class="modal-backdrop">
    <div class="modal-card" style="max-width: 440px;">
        <div class="modal-header">
            <h3 class="modal-title">Activate Announcement</h3>
            <button type="button" class="modal-close" onclick="closeModal('activate-confirm-modal')">&times;</button>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.95rem; line-height: 1.5; color: var(--primary-dark);">
                Activating this announcement will automatically <strong>deactivate the currently active announcement</strong>. Only one announcement can run at a time.
            </p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeModal('activate-confirm-modal')">Cancel</button>
            <form id="activate-confirm-form" method="post" action="/Admin/SystemSettings/ActivateAnnouncement" style="display: inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="activate-confirm-id" name="id" value="" />
                <button type="submit" class="btn btn-gold">Activate Announcement</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Tab switching
    function switchSettingsTab(tabName, el) {
        document.querySelectorAll('.settings-tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.settings-tab-pane').forEach(pane => pane.classList.remove('active'));

        el.classList.add('active');
        const target = document.getElementById('tab-pane-' + tabName);
        if (target) {
            target.classList.add('active');
        }

        // Update URL query string without reloading
        const url = new URL(window.location);
        url.searchParams.set('tab', tabName);
        window.history.replaceState({}, '', url);
    }

    // Logo preview
    function previewLogoFile(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('logo-preview-img').src = e.target.result;
            };
            reader.readAsDataURL(file);
            document.getElementById('selected-file-name').innerText = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
        }
    }

    // Toggle individual day schedule container
    function toggleIndividualDays() {
        const container = document.getElementById('individual-days-container');
        const btnText = document.getElementById('btn-toggle-days-text');
        if (!container) return;

        const isHidden = (container.style.display === 'none' || container.style.display === '');
        if (isHidden) {
            container.style.display = 'block';
            if (btnText) btnText.innerText = 'Hide Individual Days';
            container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
            container.style.display = 'none';
            if (btnText) btnText.innerText = 'Customize Individual Days';
        }
    }

    // Common status change (open/closed)
    function onCommonStatusChange(status) {
        const openWrap = document.getElementById('common-open-wrap');
        const closeWrap = document.getElementById('common-close-wrap');
        const openInput = document.getElementById('common-open-time');
        const closeInput = document.getElementById('common-close-time');

        if (status === 'open') {
            if (openWrap) openWrap.style.opacity = '1';
            if (closeWrap) closeWrap.style.opacity = '1';
            if (openInput) openInput.disabled = false;
            if (closeInput) closeInput.disabled = false;
        } else {
            if (openWrap) openWrap.style.opacity = '0.5';
            if (closeWrap) closeWrap.style.opacity = '0.5';
            if (openInput) openInput.disabled = true;
            if (closeInput) closeInput.disabled = true;
        }
    }

    // Apply common schedule to all 7 days in the table
    function applyCommonToAllDays(silent) {
        const status = document.getElementById('common-status').value;
        const isOpen = (status === 'open');
        const openTime = document.getElementById('common-open-time').value;
        const closeTime = document.getElementById('common-close-time').value;

        if (isOpen) {
            if (!openTime || !closeTime) {
                alert('Please specify both Open Time and Close Time.');
                return false;
            }
            if (openTime >= closeTime) {
                alert('Close time must be later than open time.');
                return false;
            }
        }

        for (let day = 1; day <= 7; day++) {
            const check = document.getElementById('hours-isopen-' + day);
            const openInput = document.getElementById('hours-opentime-' + day);
            const closeInput = document.getElementById('hours-closetime-' + day);

            if (check) check.checked = isOpen;
            if (openInput) openInput.value = openTime;
            if (closeInput) closeInput.value = closeTime;
            toggleDayRow(day, isOpen);
        }

        if (!silent) {
            const container = document.getElementById('individual-days-container');
            if (container && container.style.display === 'none') {
                toggleIndividualDays();
            }
            showToast('Monday – Sunday hours updated in table below. Click Save Business Hours to persist.', 'info');
        }
        return true;
    }

    // Apply common schedule and immediately save form
    function applyCommonToAllAndSave() {
        if (!applyCommonToAllDays(true)) return;
        const form = document.getElementById('business-hours-form');
        if (form) {
            if (prepareBusinessHoursSubmit(form)) {
                form.submit();
            }
        }
    }

    // Business hours row toggle
    function toggleDayRow(day, isOpen) {
        const row = document.getElementById('hours-row-' + day);
        const openInput = document.getElementById('hours-opentime-' + day);
        const closeInput = document.getElementById('hours-closetime-' + day);
        const statusText = document.getElementById('hours-status-text-' + day);

        if (isOpen) {
            if (row) row.classList.remove('is-closed');
            if (openInput) openInput.disabled = false;
            if (closeInput) closeInput.disabled = false;
            if (statusText) {
                statusText.innerText = 'OPEN';
                statusText.style.color = '#15803D';
            }
        } else {
            if (row) row.classList.add('is-closed');
            if (openInput) openInput.disabled = true;
            if (closeInput) closeInput.disabled = true;
            if (statusText) {
                statusText.innerText = 'CLOSED';
                statusText.style.color = '#64748B';
            }
        }
    }

    // Apply Monday hours to all days
    function applyMondayToAll() {
        const monOpen = document.getElementById('hours-isopen-1').checked;
        const monOpenTime = document.getElementById('hours-opentime-1').value;
        const monCloseTime = document.getElementById('hours-closetime-1').value;

        if (monOpen && (!monOpenTime || !monCloseTime)) {
            alert('Please specify both Open Time and Close Time for Monday first.');
            return;
        }
        if (monOpen && monOpenTime >= monCloseTime) {
            alert('Monday Close time must be later than Open time.');
            return;
        }

        for (let day = 2; day <= 7; day++) {
            const check = document.getElementById('hours-isopen-' + day);
            const openInput = document.getElementById('hours-opentime-' + day);
            const closeInput = document.getElementById('hours-closetime-' + day);

            if (check) check.checked = monOpen;
            if (openInput) openInput.value = monOpenTime;
            if (closeInput) closeInput.value = monCloseTime;
            toggleDayRow(day, monOpen);
        }

        // Also update common controls
        const commonStatus = document.getElementById('common-status');
        const commonOpenTimeInput = document.getElementById('common-open-time');
        const commonCloseTimeInput = document.getElementById('common-close-time');
        if (commonStatus) commonStatus.value = monOpen ? 'open' : 'closed';
        if (commonOpenTimeInput) commonOpenTimeInput.value = monOpenTime;
        if (commonCloseTimeInput) commonCloseTimeInput.value = monCloseTime;
        onCommonStatusChange(monOpen ? 'open' : 'closed');

        showToast('Monday schedule applied to Tuesday through Sunday. Click Save Business Hours to persist.', 'info');
    }

    // Prepare business hours form submission
    function prepareBusinessHoursSubmit(form, event) {
        for (let day = 1; day <= 7; day++) {
            const check = document.getElementById('hours-isopen-' + day);
            const openInput = document.getElementById('hours-opentime-' + day);
            const closeInput = document.getElementById('hours-closetime-' + day);

            if (check && check.checked) {
                if (openInput) openInput.disabled = false;
                if (closeInput) closeInput.disabled = false;

                const ot = openInput ? openInput.value : '';
                const ct = closeInput ? closeInput.value : '';
                if (!ot || !ct) {
                    alert('Please specify both Open and Close times for Day ' + day + '.');
                    if (event) event.preventDefault();
                    return false;
                }
                if (ot >= ct) {
                    alert('Close time must be later than open time for Day ' + day + '.');
                    if (event) event.preventDefault();
                    return false;
                }
            }
        }

        const btn = form ? form.querySelector('.save-btn') : null;
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Saving...</span>';
        }
        return true;
    }

    // Phone modals
    function openAddPhoneModal() {
        document.getElementById('phone-modal-title').innerText = 'Add Phone Number';
        document.getElementById('phone-form').action = '/Admin/SystemSettings/AddPhoneNumber';
        document.getElementById('phone-id').value = '';
        document.getElementById('phone-label').value = '';
        document.getElementById('phone-number').value = '';
        document.getElementById('phone-sort').value = '0';
        document.getElementById('phone-primary').checked = false;
        document.getElementById('phone-active').checked = true;
        openModal('phone-modal');
    }

    function openEditPhoneModal(id, label, phone, isPrimary, isActive, sortOrder) {
        document.getElementById('phone-modal-title').innerText = 'Edit Phone Number';
        document.getElementById('phone-form').action = '/Admin/SystemSettings/UpdatePhoneNumber';
        document.getElementById('phone-id').value = id;
        document.getElementById('phone-label').value = label;
        document.getElementById('phone-number').value = phone;
        document.getElementById('phone-sort').value = sortOrder;
        document.getElementById('phone-primary').checked = isPrimary;
        document.getElementById('phone-active').checked = isActive;
        openModal('phone-modal');
    }

    // Announcement modals
    function openNewAnnouncementModal() {
        document.getElementById('announcement-modal-title').innerText = 'New Announcement';
        document.getElementById('announcement-form').reset();
        document.getElementById('announcement-id').value = '';
        openModal('announcement-modal');
    }

    function openEditAnnouncementModal(id, title, message, linkText, linkUrl, start, end, isActive) {
        document.getElementById('announcement-modal-title').innerText = 'Edit Announcement';
        document.getElementById('announcement-id').value = id;
        document.getElementById('announcement-title').value = title;
        document.getElementById('announcement-message').value = message;
        document.getElementById('announcement-linktext').value = linkText;
        document.getElementById('announcement-linkurl').value = linkUrl;
        document.getElementById('announcement-startdate').value = start;
        document.getElementById('announcement-enddate').value = end;
        document.getElementById('announcement-active').checked = isActive;
        openModal('announcement-modal');
    }

    function confirmActivateAnnouncement(id, title) {
        document.getElementById('activate-confirm-id').value = id;
        openModal('activate-confirm-modal');
    }

    // Prevent double submission & show loading
    function handleFormSubmit(form) {
        const btn = form.querySelector('.save-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Saving...</span>';
        }
        return true;
    }
</script>
}
