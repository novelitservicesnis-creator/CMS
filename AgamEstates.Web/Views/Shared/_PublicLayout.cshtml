@inject AgamEstates.Web.Services.ISystemSettingsService SettingsService
@{
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    var siteSettings = await SettingsService.GetPublicSettingsAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? $"{siteSettings.CompanyName} — Sector 20, Panchkula Extension")</title>
    <link rel="icon" type="image/png" href="@siteSettings.LogoPath">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/public-pages.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/announcement-marquee.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
<link rel="stylesheet" href="/css/enquiry-popup.css" asp-append-version="true">
</head>
<body>

<!-- Header -->
@await Html.PartialAsync("_PublicHeader", siteSettings)

<!-- Main Body -->
<main id="main-content">
    @RenderBody()
</main>

<!-- Footer -->
@await Html.PartialAsync("_PublicFooter", siteSettings)

<!-- Shared Enquiry Modal Popup -->
@await Html.PartialAsync("_EnquiryModal")

<script>
    // Header scroll state
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
        if (header) {
            header.classList.toggle('scrolled', window.scrollY > 40);
        }
    });

    // Mobile menu toggle & backdrop
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('site-nav');
    const backdrop = document.getElementById('nav-backdrop');

    function closeNav() {
        if (nav) nav.classList.remove('open');
        if (toggle) {
            toggle.classList.remove('active');
            toggle.setAttribute('aria-expanded', 'false');
        }
        if (backdrop) backdrop.classList.remove('open');
    }

    if (toggle) {
        toggle.addEventListener('click', () => {
            const isOpen = nav.classList.toggle('open');
            toggle.classList.toggle('active', isOpen);
            toggle.setAttribute('aria-expanded', isOpen);
            if (backdrop) backdrop.classList.toggle('open', isOpen);
        });
    }

    if (backdrop) {
        backdrop.addEventListener('click', closeNav);
    }

    if (nav) {
        nav.querySelectorAll('a').forEach(a => a.addEventListener('click', closeNav));
    }

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeNav();
            closeEnquiryModal();
        }
    });

    // Modal Management
    const popupModal = document.getElementById('agam-enquiry-modal');
    const popupCloseBtn = document.getElementById('agam-modal-close');
    let lastFocusedElement = null;

    function openEnquiryModal() {
        if (!popupModal || popupModal.classList.contains('active')) return;
        lastFocusedElement = document.activeElement;

        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        if (scrollbarWidth > 0) {
            document.body.style.paddingRight = scrollbarWidth + 'px';
        }
        document.body.style.overflow = 'hidden';

        popupModal.setAttribute('aria-hidden', 'false');
        void popupModal.offsetWidth;
        popupModal.classList.add('active');

        setTimeout(() => {
            const firstInput = popupModal.querySelector('#popup-name') || popupModal.querySelector('input');
            if (firstInput) firstInput.focus();
        }, 120);
    }

    function closeEnquiryModal() {
        if (!popupModal || !popupModal.classList.contains('active')) return;
        popupModal.classList.remove('active');

        setTimeout(() => {
            popupModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
        }, 400);
    }

    if (popupCloseBtn) {
        popupCloseBtn.addEventListener('click', closeEnquiryModal);
    }

    if (popupModal) {
        popupModal.addEventListener('click', (e) => {
            if (e.target === popupModal) {
                closeEnquiryModal();
            }
        });
    }

    // Modal Form Validation & Submission
    function validatePopupForm(form) {
        let isValid = true;
        let firstInvalidInput = null;

        const nameEl = form.querySelector(`[name="name"]`);
        const nameErr = form.querySelector(`#popup-name-error`);
        const phoneEl = form.querySelector(`[name="phoneNumber"]`);
        const phoneErr = form.querySelector(`#popup-phone-error`);
        const emailEl = form.querySelector(`[name="email"]`);
        const emailErr = form.querySelector(`#popup-email-error`);
        const unitEl = form.querySelector(`[name="propertyInterest"]`);
        const unitErr = form.querySelector(`#popup-unit-error`);

        // Reset errors
        form.querySelectorAll('.has-error').forEach(el => el.classList.remove('has-error'));
        form.querySelectorAll('.field-error-msg').forEach(el => el.textContent = '');

        if (!nameEl || !nameEl.value.trim()) {
            isValid = false;
            if (nameEl) nameEl.classList.add('has-error');
            if (nameErr) nameErr.textContent = 'Please enter your full name.';
            if (!firstInvalidInput) firstInvalidInput = nameEl;
        }

        const phoneVal = phoneEl ? phoneEl.value.trim() : '';
        const phonePattern = /^[0-9+\s\-()]{7,16}$/;
        if (!phoneVal) {
            isValid = false;
            if (phoneEl) phoneEl.classList.add('has-error');
            if (phoneErr) phoneErr.textContent = 'Please enter your phone number.';
            if (!firstInvalidInput) firstInvalidInput = phoneEl;
        } else if (!phonePattern.test(phoneVal)) {
            isValid = false;
            if (phoneEl) phoneEl.classList.add('has-error');
            if (phoneErr) phoneErr.textContent = 'Please enter a valid phone number.';
            if (!firstInvalidInput) firstInvalidInput = phoneEl;
        }

        const emailVal = emailEl ? emailEl.value.trim() : '';
        const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (emailVal && !emailPattern.test(emailVal)) {
            isValid = false;
            if (emailEl) emailEl.classList.add('has-error');
            if (emailErr) emailErr.textContent = 'Please enter a valid email address.';
            if (!firstInvalidInput) firstInvalidInput = emailEl;
        }

        if (!unitEl || !unitEl.value.trim()) {
            isValid = false;
            if (unitEl) unitEl.classList.add('has-error');
            if (unitErr) unitErr.textContent = 'Please select a residence preference.';
            if (!firstInvalidInput) firstInvalidInput = unitEl;
        }

        if (firstInvalidInput) {
            firstInvalidInput.focus();
        }

        return isValid;
    }

    const popupForm = document.getElementById('popup-enquiry-form');
    if (popupForm) {
        popupForm.querySelectorAll('input, select, textarea').forEach(input => {
            input.addEventListener('input', () => {
                input.classList.remove('has-error');
                const err = popupForm.querySelector(`#${input.id}-error`);
                if (err) err.textContent = '';
            });
            input.addEventListener('change', () => {
                input.classList.remove('has-error');
                const err = popupForm.querySelector(`#${input.id}-error`);
                if (err) err.textContent = '';
            });
        });

        popupForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!validatePopupForm(popupForm)) return;

            const submitBtn = popupForm.querySelector('.btn-enquiry-submit');
            const spinner = popupForm.querySelector('.btn-spinner');
            const btnText = popupForm.querySelector('.btn-text');

            const origText = btnText ? btnText.textContent : 'Request a Call Back';
            if (submitBtn) submitBtn.disabled = true;
            if (spinner) spinner.style.display = 'inline-block';
            if (btnText) btnText.textContent = 'Sending...';

            const payload = {
                name: popupForm.querySelector(`[name="name"]`)?.value?.trim() || '',
                phoneNumber: popupForm.querySelector(`[name="phoneNumber"]`)?.value?.trim() || '',
                email: popupForm.querySelector(`[name="email"]`)?.value?.trim() || '',
                propertyInterest: popupForm.querySelector(`[name="propertyInterest"]`)?.value?.trim() || '',
                message: popupForm.querySelector(`[name="message"]`)?.value?.trim() || ''
            };

            try {
                const res = await fetch('/Home/SubmitEnquiry', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data && data.success) {
                    popupForm.reset();
                    const headerBlock = document.getElementById('agam-form-header-block');
                    const formWrapper = document.getElementById('agam-popup-form-wrapper');
                    const successBox = document.getElementById('agam-popup-success');
                    if (headerBlock) headerBlock.style.display = 'none';
                    if (formWrapper) formWrapper.style.display = 'none';
                    if (successBox) successBox.style.display = 'block';

                    setTimeout(() => {
                        closeEnquiryModal();
                    }, 2200);
                } else {
                    alert((data && data.message) ? data.message : 'Please check your information and try again.');
                }
            } catch (err) {
                const headerBlock = document.getElementById('agam-form-header-block');
                const formWrapper = document.getElementById('agam-popup-form-wrapper');
                const successBox = document.getElementById('agam-popup-success');
                if (headerBlock) headerBlock.style.display = 'none';
                if (formWrapper) formWrapper.style.display = 'none';
                if (successBox) successBox.style.display = 'block';
                setTimeout(() => {
                    closeEnquiryModal();
                }, 2200);
                popupForm.reset();
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (spinner) spinner.style.display = 'none';
                if (btnText) btnText.textContent = origText;
            }
        });
    }

    const yearSpan = document.getElementById('year');
    if (yearSpan) {
        yearSpan.textContent = new Date().getFullYear();
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
