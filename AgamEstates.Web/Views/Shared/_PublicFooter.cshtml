@model AgamEstates.Repository.ViewModel.PublicSiteSettingsViewModel
<footer>
    <div class="wrap">
        <div class="footer-grid">
            <!-- COLUMN 1: BRAND -->
            <div class="footer-brand footer-col-brand">
                <a class="brand" href="/">
                    <img class="brand-mark" src="@(Model?.LogoPath ?? "/images/logo.png")" alt="@(Model?.CompanyName ?? "Agam Estates") logo">
                    <span class="brand-name">@(Model?.CompanyNameFirst ?? "Agam") <span>@(Model?.CompanyNameSecond ?? "Estates")</span></span>
                </a>
                <p>A Tricity-based developer building 3 &amp; 4 BHK residences designed around light, land and long-term craftsmanship.</p>
                <div class="footer-address">
                    <svg viewBox="0 0 16 16" fill="none" width="14" height="14" style="flex-shrink: 0; margin-top: 4px;"><path d="M8 15C8 15 13 10.2 13 6.3C13 3.4 10.8 1 8 1C5.2 1 3 3.4 3 6.3C3 10.2 8 15 8 15Z" stroke="#DDAE45" stroke-width="1.2"/><circle cx="8" cy="6.2" r="2" stroke="#DDAE45" stroke-width="1"/></svg>
                    <span>@(Model?.FormattedAddress ?? "Sector 20, Panchkula Extension, Haryana")</span>
                </div>
            </div>

            <!-- COLUMN 2: NAVIGATION -->
            <div class="footer-col footer-col-nav">
                <h5>NAVIGATION</h5>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/Project">Project</a></li>
                    <li><a href="/AboutUs">About Us</a></li>
                    <li><a href="/Blog">Blog</a></li>
                    <li><a href="/PrivacyPolicy">Privacy Policy</a></li>
                    <li><a href="/TermsAndConditions">Terms &amp; Conditions</a></li>
                </ul>
            </div>

            <!-- COLUMN 3: CONTACT -->
            <div class="footer-col footer-col-contact">
                <h5>CONTACT</h5>
                <ul class="footer-contact-list">
                    @if (Model?.ActivePhones != null && Model.ActivePhones.Count == 1)
                    {
                        var single = Model.ActivePhones[0];
                        <li>
                            <span class="contact-lbl">@(string.IsNullOrWhiteSpace(single.Label) ? "SALES" : single.Label.ToUpper()):</span>
                            <a href="tel:@single.NumberClean">@single.PhoneNumber</a>
                        </li>
                    }
                    else if (Model?.ActivePhones != null && Model.ActivePhones.Count > 1)
                    {
                        @foreach (var phone in Model.ActivePhones)
                        {
                            <li>
                                <span class="contact-lbl">@(string.IsNullOrWhiteSpace(phone.Label) ? "OFFICE" : phone.Label.ToUpper()):</span>
                                <a href="tel:@phone.NumberClean">@phone.PhoneNumber</a>
                            </li>
                        }
                    }
                    else if (Model?.PrimaryPhone != null)
                    {
                        <li>
                            <span class="contact-lbl">@(string.IsNullOrWhiteSpace(Model.PrimaryPhone.Label) ? "SALES" : Model.PrimaryPhone.Label.ToUpper()):</span>
                            <a href="tel:@Model.PrimaryPhone.NumberClean">@Model.PrimaryPhone.PhoneNumber</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.Email))
                    {
                        <li>
                            <span class="contact-lbl">EMAIL:</span>
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </li>
                    }
                    @if (Model?.GroupedBusinessHours != null && Model.GroupedBusinessHours.Any())
                    {
                        <li class="footer-hours-wrapper">
                            <span class="contact-lbl footer-hours-head-lbl">VISIT HOURS:</span>
                            <div class="footer-hours-list">
                                @foreach (var g in Model.GroupedBusinessHours)
                                {
                                    <div class="footer-hours-entry">
                                        <span class="hours-day-badge">@g.Days.ToUpper()</span>
                                        <span class="hours-time-val">@g.Hours</span>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <!-- COLUMN 4: FOLLOW -->
            <div class="footer-col footer-col-social">
                <h5>FOLLOW</h5>
                @if (Model != null && (!string.IsNullOrWhiteSpace(Model.InstagramUrl) || !string.IsNullOrWhiteSpace(Model.FacebookUrl) || !string.IsNullOrWhiteSpace(Model.YouTubeUrl)))
                {
                    <div class="footer-social">
                        @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 22 22" fill="none"><rect x="2" y="2" width="18" height="18" rx="5" stroke="#DDAE45" stroke-width="1.2"/><circle cx="11" cy="11" r="4.5" stroke="#DDAE45" stroke-width="1.2"/><circle cx="16" cy="6" r="1" fill="#DDAE45"/></svg></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 22 22" fill="none"><path d="M13 21V12H16L16.5 8H13V6C13 5 13.5 4 15 4H16.5V1H14C11 1 9.5 3 9.5 6V8H7V12H9.5V21" stroke="#DDAE45" stroke-width="1.2"/></svg></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.YouTubeUrl))
                        {
                            <a href="@Model.YouTubeUrl" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg viewBox="0 0 22 22" fill="none"><rect x="2" y="5" width="18" height="12" rx="3" stroke="#DDAE45" stroke-width="1.2"/><path d="M9.5 8.5L14.5 11L9.5 13.5Z" fill="#DDAE45"/></svg></a>
                        }
                    </div>
                }
                else
                {
                    <p style="font-size: 0.85rem; color: #8E9FB8;">Connect with our sales team directly for project walkthroughs.</p>
                }
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.UtcNow.Year @(Model?.CompanyName ?? "Agam Estates"). All rights reserved.</p>
            <div class="footer-legal-links">
                <a href="/PrivacyPolicy">Privacy Policy</a>
                <span class="sep">&bull;</span>
                <a href="/TermsAndConditions">Terms &amp; Conditions</a>
            </div>
            <p>Site &amp; Sales Office &mdash; @(Model?.LocationShort ?? "Sector 20, Panchkula Extension")</p>
        </div>
    </div>
</footer>
