@model AgamEstates.Web.Models.LeadDetailsPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Lead.Name;
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem
        {
            Text = User.IsInRole("Admin") ? "Admin" : "CRM",
            Url = "/AdminPanel"
        },
        new BreadcrumbItem
        {
            Text = "Leads",
            Url = "/Leads"
        },
        new BreadcrumbItem
        {
            Text = Model.Lead.Name,
            Url = null
        }
    };

    var statusLower = (Model.Lead.StatusName ?? "").ToLower().Replace(" ", "-");
    var priorityLower = (Model.Lead.Priority ?? "medium").ToLower();
}

<!-- Lead Top Header -->
<div class="lead-detail-head luxury-card">
    <div class="lead-head-info">
        <div>
            <div class="lead-id-tag">LEAD #@Model.Lead.LeadId &middot; Created on @Model.Lead.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            <h1 style="font-size: 1.85rem; color: var(--primary-dark); margin: 4px 0 8px 0;">@Model.Lead.Name</h1>
            <div style="display: flex; gap: 8px; align-items: center;">
                <span id="header-status-badge" class="badge badge-status-@statusLower">@(Model.Lead.StatusName ?? "New")</span>
                <span class="badge badge-priority-@priorityLower">@(Model.Lead.Priority ?? "Medium") Priority</span>
            </div>
        </div>
    </div>

    <div class="lead-head-actions" style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="btn btn-outline" onclick="openModal('edit-lead-modal')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>Edit Details</span>
        </button>

        <button type="button" class="btn btn-gold" onclick="openModal('add-comm-modal')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Log Communication</span>
        </button>
    </div>
</div>

<!-- Two-Column Grid: Info Cards (Left) vs Communication Timeline (Right) -->
<div class="lead-details-grid">
    <!-- Left Column: Lead Information, Status & Notes -->
    <div>
        <!-- Lead Information Card -->
        <div class="detail-card luxury-card">
            <h3 class="detail-card-title">
                <span>Lead Information</span>
                <span style="font-size: 0.8rem; color: var(--fade); font-weight: normal;">Contact & Preferences</span>
            </h3>

            <div class="info-list">
                <div class="info-item">
                    <span class="info-label">Phone Number</span>
                    <span class="info-value">
                        @if (!string.IsNullOrWhiteSpace(Model.Lead.PhoneNumber))
                        {
                            <a href="tel:@Model.Lead.PhoneNumber">@Model.Lead.PhoneNumber</a>
                        }
                        else
                        {
                            <span style="color: var(--fade);">Not provided</span>
                        }
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Email Address</span>
                    <span class="info-value">
                        @if (!string.IsNullOrWhiteSpace(Model.Lead.Email))
                        {
                            <a href="mailto:@Model.Lead.Email">@Model.Lead.Email</a>
                        }
                        else
                        {
                            <span style="color: var(--fade);">Not provided</span>
                        }
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Property Interest</span>
                    <span class="info-value">@(Model.Lead.PropertyInterest ?? "3 & 4 BHK Residences")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Budget</span>
                    <span class="info-value" style="color: var(--primary-dark); font-weight: 600;">
                        @if (Model.Lead.Budget.HasValue)
                        {
                            <span>₹ @Model.Lead.Budget.Value.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">City</span>
                    <span class="info-value">@(Model.Lead.City ?? "Tricity")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Source</span>
                    <span class="info-value">@(Model.Lead.Source ?? "Direct")</span>
                </div>
            </div>
        </div>

        <!-- Assignment & Status Card -->
        <div class="detail-card luxury-card">
            <h3 class="detail-card-title">Pipeline Status &amp; Assignment</h3>

            <form id="update-status-form" class="status-form-wrap" style="display: flex; gap: 12px; align-items: flex-end; margin-bottom: 22px; flex-wrap: wrap;">
                <div style="flex-grow: 1; min-width: 160px;">
                    <label class="form-label" for="lead-status-select">Current Pipeline Stage</label>
                    <select id="lead-status-select" class="form-select">
                        @foreach (var s in Model.Statuses)
                        {
                            <option value="@s.StatusId" selected="@(Model.Lead.StatusId == s.StatusId)">@s.StatusName</option>
                        }
                    </select>
                </div>
                <button type="submit" id="save-status-btn" class="btn btn-navy" style="min-height: 42px;">Save Update</button>
            </form>

            <div class="info-list" style="border-top: 1px solid var(--border-light); padding-top: 16px;">
                <div class="info-item">
                    <span class="info-label">Assigned Agent</span>
                    <span class="info-value">@(Model.Lead.AssignedToName ?? "Unassigned")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Total Interactions</span>
                    <span class="info-value">@Model.Communications.Count logged</span>
                </div>
            </div>
        </div>

        <!-- Notes Card -->
        <div class="detail-card luxury-card">
            <h3 class="detail-card-title">Lead Notes &amp; Requirements</h3>
            <p style="font-size: 0.92rem; color: var(--text-dark); line-height: 1.65; white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Lead.Notes) ? "No notes added for this lead yet." : Model.Lead.Notes)</p>
        </div>
    </div>

    <!-- Right Column: Communication History Timeline -->
    <div class="detail-card luxury-card">
        <div class="panel-header" style="border-bottom: 1px solid var(--border-light); padding-bottom: 14px; margin-bottom: 18px;">
            <div>
                <h3 class="panel-title">Communication History</h3>
                <span style="font-size: 0.82rem; color: var(--fade);">Calls, WhatsApp updates, and client emails</span>
            </div>
            <button type="button" class="btn btn-sm btn-gold" onclick="openModal('add-comm-modal')">+ Log Interaction</button>
        </div>

        <div class="timeline" id="communication-timeline">
            @if (Model.Communications.Any())
            {
                foreach (var comm in Model.Communications)
                {
                    var isCall = string.Equals(comm.CommunicationType, "Call", StringComparison.OrdinalIgnoreCase);
                    var isWhatsApp = string.Equals(comm.CommunicationType, "WhatsApp", StringComparison.OrdinalIgnoreCase);
                    var isEmail = string.Equals(comm.CommunicationType, "Email", StringComparison.OrdinalIgnoreCase);

                    var hasFollowUp = comm.FollowUpDate.HasValue;
                    var isOverdue = hasFollowUp && comm.FollowUpDate!.Value.Date < DateTime.Today;
                    var isToday = hasFollowUp && comm.FollowUpDate!.Value.Date == DateTime.Today;
                    var followUpBadgeClass = isOverdue ? "badge-followup-overdue" : isToday ? "badge-followup-today" : "badge-followup-upcoming";
                    var followUpBadgeText = isOverdue ? "Overdue" : isToday ? "Today" : "Upcoming";

                    <div class="timeline-item" id="comm-item-@comm.CommunicationId">
                        <div class="timeline-icon-wrap">
                            @if (isCall)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                            }
                            else if (isWhatsApp)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                                </svg>
                            }
                            else if (isEmail)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            }
                        </div>

                        <div class="timeline-card">
                            <div class="timeline-meta">
                                <div class="timeline-type-wrap">
                                    <span class="timeline-type">@(comm.CommunicationType ?? "Note")</span>
                                    <span class="timeline-time">by @(comm.UserName ?? "Agent") &middot; @comm.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <div class="timeline-actions">
                                    <button type="button" class="timeline-action-btn" onclick="openEditCommModal(@comm.CommunicationId, '@(comm.CommunicationType ?? "Call")', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(comm.Message ?? ""))', '@(comm.FollowUpDate?.ToString("yyyy-MM-dd") ?? "")', '@(comm.FollowUpDate?.ToString("HH:mm") ?? "")')">Edit</button>
                                    <button type="button" class="timeline-action-btn delete" onclick="confirmDeleteComm(@comm.CommunicationId)">Delete</button>
                                </div>
                            </div>

                            <div class="timeline-message">@comm.Message</div>

                            @if (hasFollowUp)
                            {
                                <div class="timeline-followup">
                                    <span>Follow-up: <strong>@comm.FollowUpDate?.ToString("dd MMM yyyy, hh:mm tt")</strong></span>
                                    <span class="badge @followUpBadgeClass">@followUpBadgeText</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 40px 10px; color: var(--fade);">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 10px;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <h4>No communication logged yet</h4>
                    <p style="font-size: 0.85rem; margin-top: 4px;">Record calls, WhatsApp updates or meetings with this lead.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Communication Modal -->
<div id="add-comm-modal" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Log Communication</h3>
            <button type="button" class="modal-close-btn" onclick="closeModal('add-comm-modal')">&times;</button>
        </div>

        <form id="add-comm-form">
            <div class="modal-body">
                <input type="hidden" id="comm-lead-id" value="@Model.Lead.LeadId">

                <div class="form-group">
                    <label class="form-label" for="comm-type">Communication Channel <span class="required">*</span></label>
                    <select id="comm-type" class="form-select" required>
                        <option value="Call">Phone Call</option>
                        <option value="WhatsApp">WhatsApp</option>
                        <option value="Email">Email</option>
                        <option value="Site Visit">Site Visit / Meeting</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="comm-message">Interaction Notes / Summary <span class="required">*</span></label>
                    <textarea id="comm-message" class="form-control" placeholder="Summarize discussion, client requirements or next steps..." required style="min-height: 110px;"></textarea>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label" for="comm-followup-date">Next Follow-up Date</label>
                        <input type="date" id="comm-followup-date" class="form-control">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="comm-followup-time">Time</label>
                        <input type="time" id="comm-followup-time" class="form-control">
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('add-comm-modal')">Cancel</button>
                <button type="submit" id="add-comm-btn" class="btn btn-gold">Save Communication</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Communication Modal -->
<div id="edit-comm-modal" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Edit Communication</h3>
            <button type="button" class="modal-close-btn" onclick="closeModal('edit-comm-modal')">&times;</button>
        </div>

        <form id="edit-comm-form">
            <div class="modal-body">
                <input type="hidden" id="edit-comm-id">

                <div class="form-group">
                    <label class="form-label" for="edit-comm-type">Communication Channel</label>
                    <select id="edit-comm-type" class="form-select" required>
                        <option value="Call">Phone Call</option>
                        <option value="WhatsApp">WhatsApp</option>
                        <option value="Email">Email</option>
                        <option value="Site Visit">Site Visit / Meeting</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="edit-comm-message">Message <span class="required">*</span></label>
                    <textarea id="edit-comm-message" class="form-control" required style="min-height: 110px;"></textarea>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label" for="edit-comm-date">Follow-up Date</label>
                        <input type="date" id="edit-comm-date" class="form-control">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-comm-time">Time</label>
                        <input type="time" id="edit-comm-time" class="form-control">
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('edit-comm-modal')">Cancel</button>
                <button type="submit" id="edit-comm-btn" class="btn btn-gold">Update</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Lead Details Modal -->
<div id="edit-lead-modal" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Edit Lead Details</h3>
            <button type="button" class="modal-close-btn" onclick="closeModal('edit-lead-modal')">&times;</button>
        </div>

        <form id="edit-lead-form">
            <div class="modal-body">
                <input type="hidden" id="edit-lead-id" value="@Model.Lead.LeadId">

                <div class="form-group">
                    <label class="form-label" for="edit-lead-name">Full Name <span class="required">*</span></label>
                    <input type="text" id="edit-lead-name" class="form-control" value="@Model.Lead.Name" required>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-phone">Phone Number</label>
                        <input type="tel" id="edit-lead-phone" class="form-control" value="@Model.Lead.PhoneNumber">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-email">Email Address</label>
                        <input type="email" id="edit-lead-email" class="form-control" value="@Model.Lead.Email">
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-prop">Property Interest</label>
                        <input type="text" id="edit-lead-prop" class="form-control" value="@Model.Lead.PropertyInterest">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-budget">Budget (₹)</label>
                        <input type="number" id="edit-lead-budget" class="form-control" value="@Model.Lead.Budget" min="0" step="50000">
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-city">City</label>
                        <input type="text" id="edit-lead-city" class="form-control" value="@Model.Lead.City">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-source">Source</label>
                        <input type="text" id="edit-lead-source" class="form-control" value="@Model.Lead.Source">
                    </div>
                </div>

                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-status">Status</label>
                        <select id="edit-lead-status" class="form-select">
                            @foreach (var s in Model.Statuses)
                            {
                                <option value="@s.StatusId" selected="@(Model.Lead.StatusId == s.StatusId)">@s.StatusName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-priority">Priority</label>
                        <select id="edit-lead-priority" class="form-select">
                            <option value="High" selected="@(string.Equals(Model.Lead.Priority, "High", StringComparison.OrdinalIgnoreCase))">High</option>
                            <option value="Medium" selected="@(string.Equals(Model.Lead.Priority, "Medium", StringComparison.OrdinalIgnoreCase))">Medium</option>
                            <option value="Low" selected="@(string.Equals(Model.Lead.Priority, "Low", StringComparison.OrdinalIgnoreCase))">Low</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-lead-assigned">Assigned Agent</label>
                        <select id="edit-lead-assigned" class="form-select">
                            @if (User.IsInRole("Admin"))
                            {
                                <option value="">Unassigned</option>
                                foreach (var u in Model.Users)
                                {
                                    <option value="@u.UserId" selected="@(Model.Lead.AssignedTo == u.UserId)">@u.FullName</option>
                                }
                            }
                            else
                            {
                                foreach (var u in Model.Users.Where(u => u.UserId == Model.Lead.AssignedTo))
                                {
                                    <option value="@u.UserId" selected>@u.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="edit-lead-notes">Notes</label>
                    <textarea id="edit-lead-notes" class="form-control">@Model.Lead.Notes</textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('edit-lead-modal')">Cancel</button>
                <button type="submit" id="edit-lead-btn" class="btn btn-gold">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Inline Status Update
        const statusForm = document.getElementById('update-status-form');
        const statusBtn = document.getElementById('save-status-btn');
        const statusSelect = document.getElementById('lead-status-select');
        const headerBadge = document.getElementById('header-status-badge');

        if (statusForm) {
            statusForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const statusId = parseInt(statusSelect.value);
                const leadId = @Model.Lead.LeadId;

                statusBtn.disabled = true;
                statusBtn.textContent = 'Saving...';

                try {
                    const response = await fetch('/Admin/UpdateLeadStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ leadId, statusId })
                    });

                    const res = await response.json();
                    if (res.success) {
                        showToast('Lead status updated to ' + res.statusName, 'success');
                        if (headerBadge) {
                            headerBadge.textContent = res.statusName;
                            headerBadge.className = 'badge badge-status-' + res.statusName.toLowerCase().replace(/ /g, '-');
                        }
                    } else {
                        showToast(res.message || 'Failed to update status.', 'error');
                    }
                } catch (err) {
                    showToast('Server error updating status.', 'error');
                } finally {
                    statusBtn.disabled = false;
                    statusBtn.textContent = 'Save Update';
                }
            });
        }

        // 2. Add Communication
        const addCommForm = document.getElementById('add-comm-form');
        const addCommBtn = document.getElementById('add-comm-btn');

        if (addCommForm) {
            addCommForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const leadId = parseInt(document.getElementById('comm-lead-id').value);
                const communicationType = document.getElementById('comm-type').value;
                const message = document.getElementById('comm-message').value.trim();
                const followUpDate = document.getElementById('comm-followup-date').value;
                const followUpTime = document.getElementById('comm-followup-time').value;

                if (!message) {
                    showToast('Please enter interaction notes.', 'error');
                    return;
                }

                addCommBtn.disabled = true;
                addCommBtn.innerHTML = '<span>Saving...</span>';

                try {
                    const response = await fetch('/Admin/AddCommunication', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ leadId, communicationType, message, followUpDate, followUpTime })
                    });

                    const res = await response.json();
                    if (res.success) {
                        showToast('Communication logged successfully.', 'success');
                        closeModal('add-comm-modal');
                        setTimeout(() => window.location.reload(), 400);
                    } else {
                        showToast(res.message || 'Failed to log communication.', 'error');
                    }
                } catch (err) {
                    showToast('Server error logging communication.', 'error');
                } finally {
                    addCommBtn.disabled = false;
                    addCommBtn.innerHTML = '<span>Save Communication</span>';
                }
            });
        }

        // 3. Edit Communication Modal Handler
        function openEditCommModal(id, type, message, date, time) {
            document.getElementById('edit-comm-id').value = id;
            document.getElementById('edit-comm-type').value = type;
            document.getElementById('edit-comm-message').value = message;
            document.getElementById('edit-comm-date').value = date;
            document.getElementById('edit-comm-time').value = time;
            openModal('edit-comm-modal');
        }

        const editCommForm = document.getElementById('edit-comm-form');
        const editCommBtn = document.getElementById('edit-comm-btn');

        if (editCommForm) {
            editCommForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const communicationId = parseInt(document.getElementById('edit-comm-id').value);
                const communicationType = document.getElementById('edit-comm-type').value;
                const message = document.getElementById('edit-comm-message').value.trim();
                const followUpDate = document.getElementById('edit-comm-date').value;
                const followUpTime = document.getElementById('edit-comm-time').value;

                editCommBtn.disabled = true;

                try {
                    const response = await fetch('/Admin/UpdateCommunication', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ communicationId, communicationType, message, followUpDate, followUpTime })
                    });

                    const res = await response.json();
                    if (res.success) {
                        showToast('Communication updated successfully.', 'success');
                        closeModal('edit-comm-modal');
                        setTimeout(() => window.location.reload(), 400);
                    } else {
                        showToast(res.message || 'Failed to update communication.', 'error');
                    }
                } catch (err) {
                    showToast('Server error updating communication.', 'error');
                } finally {
                    editCommBtn.disabled = false;
                }
            });
        }

        // 4. Delete Communication
        async function confirmDeleteComm(id) {
            if (!confirm('Are you sure you want to delete this communication entry? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch('/Admin/DeleteCommunication', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ communicationId: id })
                });

                const res = await response.json();
                if (res.success) {
                    showToast('Communication deleted.', 'info');
                    const item = document.getElementById('comm-item-' + id);
                    if (item) item.remove();
                } else {
                    showToast(res.message || 'Failed to delete communication.', 'error');
                }
            } catch (err) {
                showToast('Server error deleting communication.', 'error');
            }
        }

        // 5. Edit Lead Details
        const editLeadForm = document.getElementById('edit-lead-form');
        const editLeadBtn = document.getElementById('edit-lead-btn');

        if (editLeadForm) {
            editLeadForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const leadId = parseInt(document.getElementById('edit-lead-id').value);
                const name = document.getElementById('edit-lead-name').value.trim();
                const budgetVal = document.getElementById('edit-lead-budget').value;

                if (!name) {
                    showToast('Lead name is required.', 'error');
                    return;
                }

                const payload = {
                    leadId,
                    name,
                    phoneNumber: document.getElementById('edit-lead-phone').value.trim() || null,
                    email: document.getElementById('edit-lead-email').value.trim() || null,
                    propertyInterest: document.getElementById('edit-lead-prop').value.trim() || null,
                    budget: budgetVal ? parseFloat(budgetVal) : null,
                    city: document.getElementById('edit-lead-city').value.trim() || null,
                    source: document.getElementById('edit-lead-source').value.trim() || null,
                    statusId: parseInt(document.getElementById('edit-lead-status').value) || 1,
                    priority: document.getElementById('edit-lead-priority').value,
                    assignedTo: parseInt(document.getElementById('edit-lead-assigned').value) || null,
                    notes: document.getElementById('edit-lead-notes').value.trim() || null
                };

                editLeadBtn.disabled = true;

                try {
                    const response = await fetch('/Admin/UpdateLead', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const res = await response.json();
                    if (res.success) {
                        showToast('Lead updated successfully.', 'success');
                        closeModal('edit-lead-modal');
                        setTimeout(() => window.location.reload(), 400);
                    } else {
                        showToast(res.message || 'Failed to update lead.', 'error');
                    }
                } catch (err) {
                    showToast('Server error updating lead.', 'error');
                } finally {
                    editLeadBtn.disabled = false;
                }
            });
        }
    </script>
}
