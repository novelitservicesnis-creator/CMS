@model AgamEstates.Web.Models.LoginViewModel
@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string ?? "/AdminPanel";
    var errorMsg = ViewBag.ErrorMessage as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Login — Agam Estates CRM</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #062545;
            --primary-dark: #041A33;
            --secondary: #0D3560;
            --gold: #DDAE45;
            --gold-soft: #F5D98A;
            --gold-dark: #B88E28;
            --light: #F8F6F0;
            --text-dark: #041A33;
            --fade: #6A7B95;
            --white: #FFFFFF;
            --serif: 'Playfair Display', Georgia, serif;
            --sans: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            min-height: 100svh;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(135deg, rgba(4, 26, 51, 0.95) 0%, rgba(6, 37, 69, 0.98) 100%),
                radial-gradient(circle at 20% 20%, rgba(221, 174, 69, 0.15) 0%, transparent 60%);
            padding: clamp(16px, 3vw, 32px);
            font-family: var(--sans);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        .login-container {
            width: min(960px, 100%);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1.15fr;
            background: var(--white);
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
            border: 1px solid rgba(221, 174, 69, 0.35);
            position: relative;
        }

        /* Left Decorative / Brand Panel */
        .login-visual {
            position: relative;
            background: var(--primary-dark);
            color: var(--light);
            padding: clamp(32px, 5vw, 50px) clamp(24px, 4vw, 40px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .login-visual-bg {
            position: absolute;
            inset: 0;
            background-image: url('https://images.pexels.com/photos/7534561/pexels-photo-7534561.jpeg?auto=compress&cs=tinysrgb&w=1000');
            background-size: cover;
            background-position: center;
            opacity: 0.25;
            filter: contrast(1.1) saturate(0.8);
        }

        .login-visual-content {
            position: relative;
            z-index: 2;
        }

        .login-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .login-brand-logo {
            width: 46px;
            height: 46px;
            object-fit: contain;
            border-radius: 50%;
            border: 1px solid rgba(221, 174, 69, 0.5);
            padding: 2px;
            flex-shrink: 0;
        }

        .login-brand-title {
            font-family: var(--serif);
            font-size: 1.45rem;
            color: var(--light);
            letter-spacing: 0.04em;
        }

        .login-brand-title span {
            color: var(--gold);
        }

        .login-quote {
            font-family: var(--serif);
            font-size: clamp(1.1rem, 2vw, 1.35rem);
            font-style: italic;
            line-height: 1.45;
            color: var(--gold-soft);
            margin-top: 36px;
        }

        .login-visual-footer {
            position: relative;
            z-index: 2;
            font-size: 0.82rem;
            color: #8E9FB8;
            border-top: 1px solid rgba(221, 174, 69, 0.2);
            padding-top: 20px;
            margin-top: 24px;
        }

        /* Right Form Panel */
        .login-form-panel {
            padding: clamp(28px, 5vw, 60px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: var(--white);
            width: 100%;
        }

        .login-header {
            margin-bottom: 24px;
        }

        .login-title {
            font-family: var(--serif);
            font-size: clamp(1.6rem, 3vw, 1.85rem);
            color: var(--primary-dark);
            margin-bottom: 6px;
            font-weight: 500;
        }

        .login-subtitle {
            font-size: 0.92rem;
            color: var(--fade);
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 20px;
            width: 100%;
        }

        .form-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--primary-dark);
            margin-bottom: 8px;
            letter-spacing: 0.02em;
        }

        .form-label .required {
            color: #DC2626;
        }

        .form-control {
            width: 100%;
            padding: 13px 16px;
            background: #FDFCF9;
            border: 1px solid rgba(6, 37, 69, 0.2);
            border-radius: 2px;
            font-family: var(--sans);
            font-size: 0.95rem;
            color: var(--text-dark);
            transition: all 0.25s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(221, 174, 69, 0.15);
            background: var(--white);
        }

        .password-wrap {
            position: relative;
            width: 100%;
        }

        .password-wrap .form-control {
            padding-right: 44px;
        }

        .password-toggle-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--fade);
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 2px;
            transition: color 0.2s ease;
        }

        .password-toggle-btn:hover {
            color: var(--primary-dark);
        }

        .form-check-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 0.85rem;
            flex-wrap: wrap;
            gap: 10px;
        }

        .form-check-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-dark);
            cursor: pointer;
            user-select: none;
        }

        .form-check-label input {
            accent-color: var(--gold);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .forgot-link {
            color: var(--gold-dark);
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .btn-gold {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 24px;
            background: var(--gold);
            color: var(--primary-dark);
            border: none;
            border-radius: 2px;
            font-family: var(--sans);
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .btn-gold:hover {
            background: var(--gold-soft);
        }

        .btn-gold:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .login-alert {
            padding: 12px 16px;
            border-radius: 2px;
            font-size: 0.88rem;
            margin-bottom: 20px;
            background: #FEE2E2;
            color: #B91C1C;
            border: 1px solid #FECACA;
            word-break: break-word;
            display: none;
            line-height: 1.5;
        }

        .login-alert.show {
            display: block;
        }

        .input-feedback {
            display: none;
            font-size: 0.78rem;
            color: #DC2626;
            margin-top: 6px;
        }

        .back-to-site {
            margin-top: 24px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--fade);
        }

        .back-to-site a {
            color: var(--primary);
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .back-to-site a:hover {
            color: var(--gold-dark);
            text-decoration: underline;
        }

        /* Responsive Breakpoints */
        @@media (max-width: 820px) {
            .login-container {
                grid-template-columns: 1fr;
            }

            .login-visual {
                padding: 24px 28px;
                min-height: auto;
            }

            .login-quote {
                display: none;
            }

            .login-visual-footer {
                display: none;
            }

            .login-brand {
                margin-bottom: 0;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 12px;
            }

            .login-visual {
                padding: 18px 20px;
            }

            .login-brand-logo {
                width: 38px;
                height: 38px;
            }

            .login-brand-title {
                font-size: 1.25rem;
            }

            .login-form-panel {
                padding: 24px 18px;
            }

            .form-check-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .forgot-link {
                align-self: flex-start;
            }

            .form-control {
                font-size: 16px; /* Prevents auto-zoom on mobile browsers */
            }
        }

        @@media (max-width: 360px) {
            body {
                padding: 8px;
            }

            .login-visual {
                padding: 14px 16px;
            }

            .login-form-panel {
                padding: 18px 14px;
            }

            .login-title {
                font-size: 1.45rem;
            }
        }
    </style>
</head>
<body>

    <div class="login-container">
        <!-- Left Branding Panel (Desktop) / Header Banner (Mobile) -->
        <div class="login-visual">
            <div class="login-visual-bg"></div>
            
            <div class="login-visual-content">
                <div class="login-brand">
                    <img src="/images/logo.png" alt="Agam Estates" class="login-brand-logo">
                    <div class="login-brand-title">Agam <span>Estates</span></div>
                </div>

                <div class="login-quote">
                    "A quieter kind of arrival — executive lead and communication intelligence."
                </div>
            </div>

            <div class="login-visual-footer">
                Sector 20, Panchkula Extension &middot; Executive Sales Portal
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="login-form-panel">
            <div class="login-header">
                <h1 class="login-title">Welcome back</h1>
                <p class="login-subtitle">Sign in to manage Agam Estates leads, site visits and follow-ups.</p>
            </div>

            <div id="login-alert" class="login-alert @(!string.IsNullOrEmpty(errorMsg) ? "show" : "")">
                @errorMsg
            </div>

            <form method="post" action="/Login@(string.IsNullOrWhiteSpace(returnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(returnUrl)}")" id="login-form">
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="form-group">
                    <label class="form-label" for="login-email">Email Address <span class="required">*</span></label>
                    <input type="email" name="Email" id="login-email" class="form-control" placeholder="admin@agamestates.com" value="@Model?.Email" required autocomplete="username">
                    <div class="input-feedback" id="email-feedback">Please enter a valid email address.</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="login-password">Password <span class="required">*</span></label>
                    <div class="password-wrap">
                        <input type="password" name="Password" id="login-password" class="form-control" placeholder="••••••••••••" required autocomplete="current-password">
                        <button type="button" id="toggle-password-btn" class="password-toggle-btn" aria-label="Toggle password visibility">
                            <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <div class="input-feedback" id="password-feedback">Please enter your password.</div>
                </div>

                <div class="form-check-row">
                    <label class="form-check-label">
                        <input type="checkbox" name="RememberMe" id="remember-me" value="true" checked>
                        <span>Remember Me</span>
                    </label>
                    <a href="javascript:void(0)" class="forgot-link" onclick="alert('Please contact the system administrator to reset your credentials.');">Forgot Password?</a>
                </div>

                <button type="submit" id="login-submit-btn" class="btn-gold">
                    <span>Sign In</span>
                </button>
            </form>

            <div class="back-to-site">
                <a href="/">&larr; Return to Agam Estates Public Website</a>
            </div>
        </div>
    </div>

    <script>
        const loginForm = document.getElementById('login-form');
        const emailInput = document.getElementById('login-email');
        const passwordInput = document.getElementById('login-password');
        const submitBtn = document.getElementById('login-submit-btn');
        const loginAlert = document.getElementById('login-alert');
        const togglePasswordBtn = document.getElementById('toggle-password-btn');
        const emailFeedback = document.getElementById('email-feedback');
        const passwordFeedback = document.getElementById('password-feedback');

        // Toggle password visibility
        togglePasswordBtn.addEventListener('click', () => {
            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            togglePasswordBtn.innerHTML = isPassword 
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
        });

        // Form Submit Validation - uses standard form submission
        loginForm.addEventListener('submit', (e) => {
            emailFeedback.style.display = 'none';
            passwordFeedback.style.display = 'none';

            const email = emailInput.value.trim();
            const password = passwordInput.value;

            let hasError = false;
            if (!email || !email.includes('@@')) {
                emailFeedback.style.display = 'block';
                hasError = true;
            }

            if (!password) {
                passwordFeedback.style.display = 'block';
                hasError = true;
            }

            if (hasError) {
                e.preventDefault();
                return;
            }

            // Valid - show loading state and proceed with normal form submission
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Signing In...</span>';
            // Allow native form POST to execute naturally
        });
    </script>
</body>
</html>
